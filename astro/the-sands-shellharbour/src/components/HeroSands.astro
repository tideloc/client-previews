---
import { Picture } from 'astro:assets';
import ThisWeekCard from './ThisWeekCard.astro';
import aerial from '../assets/aerial-beach.jpg';
import { siteContent } from '../lib/site';
const c = siteContent.contact;
---
<section data-section="hero" class="relative min-h-[88vh] flex items-end overflow-hidden bg-ink">
  <Picture src={aerial} widths={[768, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} alt="Aerial view of Shellharbour North Beach with The Sands venue beside the sand and the headland beyond" class="absolute inset-0 w-full h-full object-cover object-[50%_60%]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/25"></div>
  <div class="relative mx-auto max-w-6xl w-full px-5 pb-12 pt-24 md:pb-14 grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-7 text-white">
      <p class="font-sub text-sm tracking-[0.3em] uppercase flex items-center gap-3"><span class="inline-block w-8 h-[3px] bg-primary"></span>Shellharbour North Beach, next to the surf club</p>
      <h1 class="font-display mt-4 text-[11vw] md:text-[5vw] leading-[1.02]">Life tastes better with a pinch of salt in the air.</h1>
      <p class="mt-5 max-w-xl text-lg md:text-xl text-white/90">Casual beachside dining featuring all the classics, open 7 days from 7am. And Shellharbour's premier beachside event venue, right next door.</p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href={c.mapUrl} class="bg-primary text-white px-7 py-3.5 font-semibold">Get directions</a>
        <a href="#receptions" class="border border-white/70 text-white px-7 py-3.5 font-semibold hover:bg-white/10">Book an event</a>
      </div>
    </div>
    <ThisWeekCard class="md:col-span-5 md:col-start-8 max-w-md md:justify-self-end" />
  </div>
</section>
