---
/** First screen derived from THE SANDS' defining content: one building, two businesses.
 *  A full-strength sky-blue claim band (their own applied header colour), then a split
 *  duo of doors: The Kiosk and The Sands Receptions. Not the full-bleed + card skeleton. */
import { Picture } from 'astro:assets';
import kiosk from '../assets/kiosk-table-view.jpg';
import party from '../assets/reception-party.jpg';
import { siteContent } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const c = siteContent.contact;
---
<section data-section="hero" class="bg-primary text-white">
  <div class="mx-auto max-w-6xl px-5 pt-14 pb-10 md:pt-24 md:pb-14">
    <p class="font-sub text-sm tracking-[0.25em] uppercase text-white/85">Shellharbour North Beach, next to the surf club</p>
    <h1 class="font-display mt-4 text-[11vw] md:text-[5.2vw] leading-[1.04] max-w-5xl">Life tastes better with a pinch of salt in the air.</h1>
    <p class="mt-5 max-w-2xl text-lg md:text-xl text-white/90">One spot on the sand, two doors: casual beachside dining at The Kiosk, and Shellharbour's premier beachside event venue right next door.</p>
  </div>
</section>
<section data-section="doors" aria-label="The Kiosk and The Sands Receptions" class="grid md:grid-cols-2 bg-ink">
  <a href={c.mapUrl} class="group relative block min-h-[46vh] md:min-h-[56vh] overflow-hidden">
    <Picture src={kiosk} widths={[768, 1280]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="Coffee and cake on a kiosk table with the lawn and ocean behind" class="absolute inset-0 w-full h-full object-cover object-[50%_40%] transition-transform duration-500 group-hover:scale-[1.02]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-ink/10"></div>
    <div class="relative flex flex-col justify-end h-full p-6 md:p-9 text-white">
      <p class="font-sub text-xs tracking-[0.25em] uppercase text-white/80">The Kiosk</p>
      <p class="font-display text-3xl md:text-4xl mt-1">Open 7 days from 7am.</p>
      <p class="mt-2 text-white/85">Casual beachside dining featuring all the classics. Fully licensed.</p>
      <span class="mt-4 inline-block self-start bg-primary px-5 py-2.5 font-semibold">Get directions</span>
    </div>
  </a>
  <a href={`${base}/receptions/#enquire`} class="group relative block min-h-[46vh] md:min-h-[56vh] overflow-hidden">
    <Picture src={party} widths={[768, 1280]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="Wedding guests dancing with arms up under the lights in The Sands Receptions room" class="absolute inset-0 w-full h-full object-cover object-[50%_35%] transition-transform duration-500 group-hover:scale-[1.02]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/35 to-ink/10"></div>
    <div class="relative flex flex-col justify-end h-full p-6 md:p-9 text-white">
      <p class="font-sub text-xs tracking-[0.25em] uppercase text-white/80">The Sands Receptions</p>
      <p class="font-display text-3xl md:text-4xl mt-1">Shellharbour's premier beachside event venue.</p>
      <p class="mt-2 text-white/85">100 seated, 140 cocktail. In-house catering.</p>
      <span class="mt-4 inline-block self-start bg-white text-ink px-5 py-2.5 font-semibold">Enquire about a date</span>
    </div>
  </a>
</section>
