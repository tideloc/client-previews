---
import { receptions } from '../data/venue';
import { siteContent, fullAddress } from '../lib/site';
const c = siteContent.contact;
---
<section data-section="location" class="bg-secondary text-white mt-14 md:mt-16">
  <div class="mx-auto max-w-6xl px-5 py-14 md:py-20 grid gap-8 md:grid-cols-12 md:items-center">
    <div class="md:col-span-7">
      <h2 class="font-display text-4xl md:text-5xl leading-tight">On the shores of Shellharbour North Beach, next door to the surf club.</h2>
      <p class="mt-4 text-white/90 text-lg"><span data-tl="contact.address">{fullAddress()}</span></p>
      <a href={c.mapUrl} class="inline-block mt-5 bg-white text-ink px-6 py-3 font-semibold">Get directions</a>
    </div>
    <ul class="md:col-span-5 divide-y divide-white/25 border-t border-b border-white/25">{receptions.travel.map((t) => <li class="py-3">{t}</li>)}</ul>
  </div>
</section>
