---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSands from '../components/HeroSands.astro';
import MenuBand from '../components/MenuBand.astro';
import ReceptionsBlock from '../components/ReceptionsBlock.astro';
import EventsList from '../components/EventsList.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import LocationBand from '../components/LocationBand.astro';
---
<Base title="Beachside cafe and event venue in Shellharbour | The Sands" description="Beachside dining on Shellharbour North Beach, open 7 days from 7am, plus a licensed event venue for up to 140 guests.">
  <Header slot="header" />
  <HeroSands />
  <MenuBand />
  <ReceptionsBlock />
  <EventsList />
  <PhotoMosaic />
  <LocationBand />
  <Footer slot="footer" />
</Base>
