---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EventsList from '../../components/EventsList.astro';
import aerial from '../../assets/aerial-venue.jpg';
import pizza from '../../assets/pizza-night-poster.jpg';
import tea from '../../assets/high-tea-poster.jpg';
---
<Base title="Upcoming events, pizza nights and high teas | The Sands Shellharbour" description="What is on at The Sands Shellharbour: Thursday pizza nights from 5:30pm and themed high teas on Shellharbour North Beach. Dates, times and prices." schemaType="EventVenue">
  <Header slot="header" />
  <section data-section="hero" class="relative min-h-[70vh] flex items-end overflow-hidden bg-ink text-white">
    <Picture src={aerial} widths={[768, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} alt="Aerial view of The Sands buildings beside Shellharbour North Beach" class="absolute inset-0 w-full h-full object-cover object-[50%_65%]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/50 to-ink/25"></div>
    <div class="relative mx-auto max-w-6xl w-full px-5 pt-24 pb-12 md:pb-14 grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="inline-flex items-center gap-3 bg-ink/55 px-3 py-1.5 font-sub text-sm tracking-[0.25em] uppercase"><span class="inline-block w-8 h-[3px] bg-primary"></span>What's on</p>
        <h1 class="font-display mt-4 text-[10vw] md:text-[4.6vw] leading-[1.05]">Thursday pizza nights and high teas by the beach.</h1>
        <p class="mt-5 max-w-xl text-lg text-white/90">Pizza night has you sorted, serving house made pizzas from 5.30pm. Dine in or take away.</p>
        <div class="mt-7 flex flex-wrap gap-4"><a href="https://www.thesands.net.au/event-details/pizza-at-the-sands-shellharbour-2026-08-27-17-30" class="bg-primary text-white px-7 py-3.5 font-semibold">Reserve pizza night</a><a href="tel:+61411476855" class="border border-white/70 px-7 py-3.5 font-semibold tabular-nums">0411 476 855</a></div>
      </div>
      <div class="md:col-span-5 grid grid-cols-2 gap-3 md:justify-self-end">
        <Picture src={pizza} widths={[480, 800]} sizes="20vw" formats={['avif', 'webp']} alt="Pizza night poster: Thursdays from 5:30pm" pictureAttributes={{ class: 'bg-white/95 p-1 shadow-xl shadow-ink/40 block' }} class="w-full h-auto" loading="eager" />
        <Picture src={tea} widths={[480, 800]} sizes="20vw" formats={['avif', 'webp']} alt="Alice in Wonderland High Tea poster" pictureAttributes={{ class: 'bg-white/95 p-1 shadow-xl shadow-ink/40 block' }} class="w-full h-auto" loading="eager" />
      </div>
    </div>
  </section>
  <EventsList heading="Dates" all />
  <Footer slot="footer" />
</Base>
