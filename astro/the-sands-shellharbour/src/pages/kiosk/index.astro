---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MenuBand from '../../components/MenuBand.astro';
import table from '../../assets/kiosk-table-view.jpg';
import dog from '../../assets/kiosk-dog.jpg';
import bagel from '../../assets/bagel-salmon.jpg';
import acai from '../../assets/acai-bowl.jpg';
import burger from '../../assets/burger.jpg';
import chips from '../../assets/chips.jpg';
import { siteContent } from '../../lib/site';
const c = siteContent.contact;
---
<Base title="The Sands Kiosk, beachside cafe open 7 days from 7am | Shellharbour" description="Breakfast from 7am on Shellharbour North Beach: bagels, burgers, fish and chips and coffee. Fully licensed, dogs welcome outside.">
  <Header slot="header" />
  <section data-section="hero" class="relative min-h-[72vh] flex items-end overflow-hidden bg-ink">
    <Picture src={table} widths={[768, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} alt="Coffee and cake on a kiosk table with the lawn and ocean behind" class="absolute inset-0 w-full h-full object-cover object-[50%_40%]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/10"></div>
    <div class="relative mx-auto max-w-6xl w-full px-5 pb-12 pt-28 text-white">
      <p class="font-sub text-sm tracking-[0.3em] uppercase flex items-center gap-3"><span class="inline-block w-8 h-[3px] bg-primary"></span>The Sands Kiosk</p>
      <h1 class="font-display mt-4 text-[10vw] md:text-[4.4vw] leading-[1.05] max-w-4xl">As the sun peeks over the horizon, join us for a breakfast that helps put the 'rise' in sunrise.</h1>
      <p class="mt-5 max-w-xl text-lg md:text-xl text-white/90">Open 7 days a week from 7am. Fully licensed.</p>
      <a href={c.mapUrl} class="inline-block mt-7 bg-primary text-white px-7 py-3.5 font-semibold">Get directions</a>
    </div>
  </section>
  <MenuBand />
  <section data-section="gallery" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-3 grid-cols-2 md:grid-cols-4">
    <Picture src={bagel} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Smoked salmon bagel with lettuce" class="w-full aspect-square object-cover" loading="lazy" />
    <Picture src={acai} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Acai breakfast bowl with kiwi, blueberries and granola" class="w-full aspect-square object-cover" loading="lazy" />
    <Picture src={burger} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Cheeseburger on a plate by the rocks" class="w-full aspect-square object-cover" loading="lazy" />
    <Picture src={chips} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Chips in a takeaway box" class="w-full aspect-square object-cover" loading="lazy" />
  </section>
  <section data-section="dogs" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-8 md:grid-cols-12 md:items-center">
    <Picture src={dog} widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="A black dog with a puppacino on the grass outside the kiosk" pictureAttributes={{ class: 'md:col-span-6 block' }} class="w-full aspect-[4/3] object-cover" loading="lazy" />
    <div class="md:col-span-5 md:col-start-8">
      <h2 class="font-display text-4xl md:text-5xl leading-tight">Whether you're an early riser or a leisurely wanderer in search of a lazy lunch.</h2>
      <ul class="mt-6 divide-y divide-ink/10"><li class="py-2">Alfresco dining on the lawn</li><li class="py-2">Takeaway</li><li class="py-2">Family friendly, pet friendly</li><li class="py-2">Wheelchair accessible</li></ul>
      <p class="mt-5 text-ink/70 text-sm">The Sands Kiosk is closed whenever there's a private event in the adjoining The Sands Reception venue.</p>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
