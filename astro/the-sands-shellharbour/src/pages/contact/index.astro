---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteContent, fullAddress } from '../../lib/site';
const c = siteContent.contact;
const tel = 'tel:+61' + c.phone.replace(/\D/g, '').replace(/^0/, '');
const mapQ = encodeURIComponent('115 Junction Road, Shellharbour NSW 2529');
---
<Base title="Find us on Shellharbour North Beach | The Sands" description="The Sands Kiosk and Receptions, 115 Junction Road, Shellharbour North Beach, next door to Shellharbour Surf Club. Open 7 days from 7am. Phone 0411 476 855.">
  <Header slot="header" />
  <section data-section="hero" class="bg-secondary text-white">
    <div class="mx-auto max-w-6xl px-5 pt-16 pb-14 md:pt-24 md:pb-20 grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="font-sub text-sm tracking-[0.3em] uppercase">Shellharbour North Beach</p>
        <h1 class="font-display mt-4 text-[10vw] md:text-[4.6vw] leading-[1.05]">Next door to the surf club.</h1>
        <address class="not-italic mt-6 text-xl md:text-2xl leading-snug"><span data-tl="contact.address">{fullAddress()}</span></address>
        <div class="mt-8 flex flex-wrap gap-4"><a href={c.mapUrl} class="bg-white text-ink px-7 py-3.5 font-semibold">Directions</a><a href={tel} class="border border-white/70 px-7 py-3.5 font-semibold tabular-nums" data-tl="contact.phone">{c.phone}</a></div>
        <p class="mt-5"><a href={`mailto:${c.email}`} class="underline underline-offset-4 break-all" data-tl="contact.email">{c.email}</a></p>
      </div>
      <aside class="md:col-span-5 bg-white text-ink p-6 md:p-7">
        <p class="font-sub text-xs tracking-[0.25em] uppercase text-primary">The Kiosk</p>
        <p class="font-display text-3xl mt-2">Open 7 days from 7am</p>
        <p class="mt-3 text-ink/80">Fully licensed. Alfresco dining, takeaway, family and pet friendly, wheelchair accessible.</p>
        <p class="mt-3 text-sm text-ink/60">The Sands Kiosk is closed whenever there's a private event in the adjoining The Sands Reception venue.</p>
      </aside>
    </div>
  </section>
  <iframe title="Map of The Sands, 115 Junction Road, Shellharbour" src={`https://www.google.com/maps?q=${mapQ}&output=embed`} class="block w-full h-[52vh] md:h-[60vh]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  <section data-section="request" id="request" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5"><h2 class="font-display text-4xl md:text-5xl">Ask us anything</h2><p class="mt-4 text-ink/80 text-lg">Group bookings, dietary needs, or an event date. Ask here or ring.</p></div>
    <div class="md:col-span-7"><EnquiryForm kind="enquiry" site="The Sands Shellharbour" submitLabel="Send" successText="Thanks. Your message has been sent to The Sands." fields={[{ name: 'name', label: 'Your name', required: true },{ name: 'phone', label: 'Phone', type: 'tel' },{ name: 'email', label: 'Email', type: 'email', required: true },{ name: 'message', label: 'Message', type: 'textarea', required: true }]} /></div>
  </section>
  <Footer slot="footer" />
</Base>
