---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import party from '../../assets/reception-party.jpg';
import pink from '../../assets/reception-tables-pink.jpg';
import green from '../../assets/reception-tables-green.jpg';
import tarts from '../../assets/canapes-tarts.jpg';
import salmon from '../../assets/canapes-salmon.jpg';
import couple from '../../assets/wedding-couple-beach.jpg';
import { receptions, memorial } from '../../data/venue';
---
<Base title="The Sands Receptions, beachside event venue for up to 140 | Shellharbour" description="Shellharbour's beachside event venue: 100 seated or 140 cocktail, licensed, in-house catering, packages per head. Weddings to memorials." schemaType="EventVenue">
  <Header slot="header" />
  <section data-section="hero" class="relative min-h-[76vh] flex items-end overflow-hidden bg-ink">
    <Picture src={party} widths={[768, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} alt="Wedding guests dancing with arms up under the lights in The Sands Receptions room" class="absolute inset-0 w-full h-full object-cover object-[50%_40%]" pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/55 to-ink/25"></div>
    <div class="relative mx-auto max-w-6xl w-full px-5 pb-12 pt-28 text-white">
      <p class="inline-flex items-center gap-3 bg-ink/55 px-3 py-1.5 font-sub text-sm tracking-[0.25em] uppercase"><span class="inline-block w-8 h-[3px] bg-primary"></span>The Sands Receptions</p>
      <h1 class="font-display mt-4 text-[10vw] md:text-[4.6vw] leading-[1.05] max-w-4xl">Shellharbour's premier beachside event venue.</h1>
      <p class="mt-5 max-w-xl text-lg md:text-xl text-white/90">Panoramic views of the ocean through expanses of glass, soaring ceilings and a bright, modern interior.</p>
      <a href="#enquire" class="inline-block mt-7 bg-primary text-white px-7 py-3.5 font-semibold">Enquire about a date</a>
    </div>
  </section>
  <section data-section="capacity" class="bg-secondary text-white">
    <div class="mx-auto max-w-6xl px-5 py-12 md:py-16 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5 grid grid-cols-2 gap-6">
        <div class="border-t-2 border-white pt-2"><p class="font-sub text-xs tracking-[0.2em] uppercase text-white/80">Seated dining</p><p class="font-display text-7xl">{receptions.seated}</p></div>
        <div class="border-t-2 border-white pt-2"><p class="font-sub text-xs tracking-[0.2em] uppercase text-white/80">Cocktail</p><p class="font-display text-7xl">{receptions.cocktail}</p></div>
      </div>
      <ul class="md:col-span-7 grid sm:grid-cols-2 gap-x-8">{receptions.facts.map((f) => <li class="py-2 border-b border-white/20">{f}</li>)}</ul>
    </div>
  </section>
  <section data-section="gallery" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-3 grid-cols-2 md:grid-cols-12">
    <Picture src={pink} widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="Reception tables set with pink sashes and green runners" pictureAttributes={{ class: 'col-span-2 md:col-span-6 block' }} class="w-full aspect-[4/3] object-cover" loading="lazy" />
    <Picture src={green} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Round tables in white with a green living wall" pictureAttributes={{ class: 'md:col-span-3 block' }} class="w-full h-full aspect-square md:aspect-auto object-cover" loading="lazy" />
    <div class="md:col-span-3 grid gap-3">
      <Picture src={tarts} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Tray of mini quiches" class="w-full aspect-[3/2] object-cover" loading="lazy" />
      <Picture src={salmon} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Smoked salmon canapes on a timber board" class="w-full aspect-[3/2] object-cover" loading="lazy" />
    </div>
  </section>
  <section data-section="uses" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-7">
      <h2 class="font-display text-4xl md:text-5xl leading-tight">A versatile space in an idyllic seaside setting.</h2>
      <p class="mt-4 text-lg text-ink/80">Fully licensed, with an in-house catering team and all-inclusive packages priced per head. Every detail is as seamless as the tides.</p>
      <ul class="mt-6 grid grid-cols-2 gap-x-8">{receptions.uses.map((u) => <li class="py-2 border-b border-ink/10">{u}</li>)}</ul>
      <a href={receptions.packagePdf} class="inline-block mt-6 underline underline-offset-4 font-semibold">Celebrations Package 2026</a>
    </div>
    <div class="md:col-span-5">
      <Picture src={couple} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} alt="A couple walking on Shellharbour North Beach on their wedding day" class="w-full aspect-[4/5] object-cover" loading="lazy" />
    </div>
  </section>
  <section data-section="memorials" class="bg-ink text-white mt-16 md:mt-20">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-20 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-6"><h2 class="font-display text-4xl md:text-6xl leading-tight">Celebrate a life beautifully.</h2><p class="mt-4 text-white/85 text-lg">The Sands Shellharbour Memorial Celebration Package. Honour their journey, to a peaceful coastal embrace.</p></div>
      <ul class="md:col-span-5 md:col-start-8 divide-y divide-white/25 border-t border-b border-white/25 text-lg">{memorial.map((m) => <li class="py-3">{m}</li>)}</ul>
    </div>
  </section>
  <section id="enquire" data-section="request" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <h2 class="font-display text-4xl md:text-5xl">Enquire about a date</h2>
      <p class="mt-4 text-ink/80 text-lg">Tell us the date, the occasion and roughly how many guests.</p>
      <p class="mt-4">Or ring <a href="tel:+61411476855" class="underline underline-offset-4 font-semibold tabular-nums">0411 476 855</a> or email <a href="mailto:bookings@thesands.net.au" class="underline underline-offset-4">bookings@thesands.net.au</a>.</p>
      <ul class="mt-6 text-sm text-ink/70 divide-y divide-ink/10">{receptions.travel.map((t) => <li class="py-2">{t}</li>)}</ul>
    </div>
    <div class="md:col-span-7">
      <EnquiryForm kind="reception-enquiry" site="The Sands Shellharbour" submitLabel="Send enquiry" successText="Thanks. Your enquiry has been sent to The Sands."
        fields={[
          { name: 'name', label: 'Your name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel', required: true },
          { name: 'email', label: 'Email', type: 'email' },
          { name: 'date', label: 'The date', required: true },
          { name: 'occasion', label: 'Occasion', placeholder: 'Wedding, birthday, corporate, memorial' },
          { name: 'guests', label: 'Roughly how many guests' },
          { name: 'notes', label: 'Anything else', type: 'textarea' },
        ]} />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
