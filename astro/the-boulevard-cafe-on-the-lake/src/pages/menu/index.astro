---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PriceList from '../../components/tl/PriceList.astro';
import { Picture } from 'astro:assets';
import baconBenny from '../../assets/bacon-benny.jpg';
import friedRice from '../../assets/prawn-fried-rice.jpg';
import croissant from '../../assets/bacon-egg-croissant.jpg';
import bigBreakfast from '../../assets/big-breakfast.jpg';
import { siteContent } from '../../lib/site';
import { telHref } from '../../lib/links';
const strip = [
  { src: baconBenny, alt: 'Eggs benedict with bacon and spinach on a blue glazed plate' },
  { src: bigBreakfast, alt: 'A big breakfast plate with fried eggs, hash browns, bacon, fried chicken and mushrooms' },
  { src: croissant, alt: 'A croissant filled with bacon and a fried egg, topped with parsley' },
  { src: friedRice, alt: 'Two bowls of fried rice, one topped with grilled prawns, with a bottle of shiraz' },
];
---
<Base title="Menu | The Boulevard Cafe on the Lake" description="Breakfast, lunch and the Friday and Saturday dinner menu at The Boulevard Cafe on the Lake, Victor Harbor. Dine in, licensed, or takeaway.">
  <Header slot="header" />
  <section data-section="menu-intro" class="bg-primary text-ground">
    <div class="mx-auto max-w-6xl px-5 py-12 lg:py-16">
      <h1 class="font-display font-light uppercase tracking-[0.12em] text-6xl sm:text-7xl">Menu</h1>
      <p class="mt-4 text-lg sm:text-xl max-w-2xl">Dine in, licensed, or takeaway. Phone orders on <a href={telHref} class="font-bold underline underline-offset-4">{siteContent.contact.phone}</a>. The dinner menu is Friday and Saturday, 5pm to 8pm.</p>
    </div>
  </section>
  <section data-section="menu-photos" aria-label="Plates from the kitchen" class="bg-ink">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-1">
      {strip.map((p, i) => (
        <Picture src={p.src} widths={[400, 744]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 25vw, 50vw" loading={i < 2 ? 'eager' : 'lazy'} alt={p.alt} class="w-full aspect-[4/5] object-cover object-bottom" />
      ))}
    </div>
  </section>
  <section data-section="menu" aria-label="Full menu" class="mx-auto max-w-6xl px-5 py-12 lg:py-16">
    <p class="border-l-4 border-accent pl-4 mb-10 text-base max-w-3xl">Example content. Breakfast and lunch items and prices are from online listings for the cafe. The dinner list is the cafe's Friday and Saturday menu as posted in May 2023. All of it will be replaced with the current menus.</p>
    <div class="lg:[&>div]:columns-2 [&>div]:gap-14 [&_section]:break-inside-avoid">
      <PriceList
        sectionClass="mb-10"
        titleClass="font-display font-semibold uppercase tracking-[0.16em] text-xl text-primary border-b-2 border-ink pb-2 mb-1"
        itemClass="flex items-baseline justify-between gap-4 py-2.5 border-b border-secondary text-lg"
        nameClass="font-semibold"
        priceClass="font-bold tabular-nums whitespace-nowrap"
        noteClass="text-sm font-normal"
      />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
