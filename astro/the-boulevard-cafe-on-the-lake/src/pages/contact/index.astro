---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FindUs from '../../components/FindUs.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteContent } from '../../lib/site';
import Hours from '../../components/tl/Hours.astro';
import { Picture } from 'astro:assets';
import shopfront from '../../assets/verandah.jpg';
import lake from '../../assets/lake-lawn.jpg';
---
<Base title="Find us | The Boulevard Cafe on the Lake" description="The Boulevard Cafe on the Lake is at 41 Bartel Blvd, Victor Harbor, on Encounter Lakes. Opening hours, phone, map and directions.">
  <Header slot="header" />
  <section data-section="contact-intro" class="bg-primary text-ground">
    <div class="mx-auto max-w-6xl px-5 py-12 lg:py-16">
      <h1 class="font-display font-light uppercase tracking-[0.16em] text-4xl sm:text-6xl">Find us</h1>
      <p class="mt-4 text-lg sm:text-xl max-w-2xl">41 Bartel Blvd, Victor Harbor, on Encounter Lakes. Look for the blue band and the orange chairs.</p>
    </div>
  </section>
  <FindUs heading="Address and directions" />
  <section data-section="hours" aria-labelledby="hours-h" class="bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-14 grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-center">
      <div>
        <h2 id="hours-h" class="font-display font-light uppercase tracking-[0.18em] text-3xl sm:text-4xl">Opening hours</h2>
        <Hours listClass="mt-5 border-t-2 border-ink" rowClass="flex items-baseline justify-between py-3 border-b border-ink/20 text-lg" dayClass="font-semibold" timeClass="tabular-nums" />
      </div>
      <div class="grid grid-cols-[1fr_1.5fr] gap-3">
        <Picture src={shopfront} widths={[480, 768]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 22vw, 40vw" loading="lazy" alt="Orange chairs and a round table under the cafe verandah" class="w-full h-72 sm:h-96 object-cover rounded-sm" />
        <Picture src={lake} widths={[480, 720]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 34vw, 60vw" loading="lazy" alt="A drink held up on the lawn across the road with the lake behind it" class="w-full h-72 sm:h-96 object-cover rounded-sm" />
      </div>
    </div>
  </section>
  <section data-section="enquiry" aria-labelledby="enquiry-h" class="mx-auto max-w-6xl px-5 py-14 lg:py-16 grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-start">
    <div>
      <h2 id="enquiry-h" class="font-display font-light uppercase tracking-[0.18em] text-3xl sm:text-4xl">Send a message</h2>
      <p class="mt-4 text-lg max-w-sm">A question about the menu, a takeaway order, catering or a function.</p>
    </div>
    <EnquiryForm
      kind="enquiry"
      site={siteContent.businessName}
      class="grid gap-4 sm:grid-cols-2 [&>div:nth-last-child(-n+3)]:sm:col-span-2"
      inputClass="w-full border border-ink/40 bg-ground px-3 py-2.5 text-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      buttonClass="border-2 border-ink text-ink font-display font-semibold uppercase tracking-[0.18em] px-6 pt-4 pb-3"
      submitLabel="Send message"
      successText="Thanks, your message has been sent."
      fields={[
        { name: 'name', label: 'Your name', required: true },
        { name: 'phone', label: 'Phone', type: 'tel', required: true },
        { name: 'email', label: 'Email', type: 'email' },
        { name: 'message', label: 'Message', type: 'textarea', required: true },
      ]}
    />
  </section>
  <Footer slot="footer" />
</Base>
