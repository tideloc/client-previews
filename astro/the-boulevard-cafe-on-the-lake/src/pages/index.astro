---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignBandHero from '../components/SignBandHero.astro';
import ThreeDoors from '../components/ThreeDoors.astro';
import BreakfastBoard from '../components/BreakfastBoard.astro';
import LunchAndDinner from '../components/LunchAndDinner.astro';
import WhatPeopleOrder from '../components/WhatPeopleOrder.astro';
import FunctionsBand from '../components/FunctionsBand.astro';
import FindUs from '../components/FindUs.astro';
---
<Base title="Cafe on the lake in Victor Harbor | The Boulevard" description="The Boulevard is a licensed cafe on Encounter Lakes in Victor Harbor. Breakfast and lunch seven days, dine in or takeaway, catering and functions.">
  <Header slot="header" />
  <SignBandHero />
  <ThreeDoors />
  <BreakfastBoard />
  <WhatPeopleOrder />
  <LunchAndDinner />
  <FunctionsBand />
  <FindUs />
  <Footer slot="footer" />
</Base>
