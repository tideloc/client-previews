---
import ContactDetails from './tl/ContactDetails.astro';
import Wave from './Wave.astro';
import { siteContent } from '../lib/site';
import { base, nav, directionsUrl } from '../lib/links';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-ground pb-24" data-section="footer">
  <div class="mx-auto max-w-6xl px-5 py-12 grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-display uppercase tracking-[0.22em] text-2xl">The Boulevard</p>
      <Wave class="w-32 h-5 my-2" under="#f4f2ea" />
      <p class="font-display tracking-[0.3em] text-xs">café on the lake</p>
    </div>
    <div>
      <ContactDetails class="not-italic space-y-2" linkClass="underline underline-offset-4" />
      <p class="mt-3"><a href={directionsUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4">Get directions</a></p>
    </div>
    <div>
      <ul class="space-y-2 font-display uppercase tracking-[0.18em] text-sm">
        {nav.map((n) => <li><a href={n.href} class="hover:underline">{n.label}</a></li>)}
        {siteContent.social.facebook && <li><a href={siteContent.social.facebook} target="_blank" rel="noreferrer" class="hover:underline">Facebook</a></li>}
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-5 py-5 border-t border-ground/20 text-sm text-ground/80">
    <p>&copy; {year} {siteContent.businessName}, Victor Harbor SA.</p>
  </div>
</footer>
