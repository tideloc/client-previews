---
/** Lunch list and the Friday and Saturday chef specials from the portal price list, with two
 *  dinner plates. Sits on the cream card colour so it reads apart from the breakfast table. */
import { Picture } from 'astro:assets';
import padThai from '../assets/prawn-pad-thai.jpg';
import tomYum from '../assets/tom-yum-prawns.jpg';
import { siteContent } from '../lib/site';
import { base } from '../lib/links';
const lunch = siteContent.priceList.find((s) => s.title === 'Lunch');
const specials = siteContent.priceList.find((s) => s.title === 'Fri and Sat dinner: chef specials');
const row = 'flex items-baseline justify-between gap-4 py-2.5 border-b border-ink/15 text-lg';
---
<section data-section="lunch-dinner" aria-labelledby="lunch-h" class="bg-secondary">
  <div class="mx-auto max-w-6xl px-5 py-16 lg:py-20 grid gap-10 lg:grid-cols-[0.9fr_1fr_1fr] lg:items-start">
    <div class="grid grid-cols-2 lg:grid-cols-1 gap-3">
      <Picture src={padThai} widths={[400, 744]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 28vw, 50vw" loading="lazy" alt="Prawn pad thai with bean sprouts, coriander and a wedge of lemon" class="w-full aspect-[4/5] object-cover object-bottom rounded-sm" />
      <Picture src={tomYum} widths={[400, 744]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 28vw, 50vw" loading="lazy" alt="Tom yum prawn soup in a white bowl beside a bottle of wine and two flutes" class="w-full aspect-[4/5] object-cover object-bottom rounded-sm" />
    </div>
    {lunch && (
      <div>
        <h2 id="lunch-h" class="font-display font-light uppercase tracking-[0.18em] text-4xl">Lunch</h2>
        <ul class="mt-5 border-t-2 border-ink">
          {lunch.items.map((i) => <li class={row}><span class="font-semibold">{i.name}</span><span class="font-bold text-primary tabular-nums">{i.price}</span></li>)}
        </ul>
        <p class="mt-8 text-lg">Licensed, with wine and beer to go with it.</p>
        <p class="mt-4"><a href={`${base}/menu/`} class="text-lg font-bold text-primary underline underline-offset-4">See the menu</a></p>
      </div>
    )}
    {specials && (
      <div>
        <h2 class="font-display font-light uppercase tracking-[0.18em] text-4xl">Dinner</h2>
        <p class="mt-2 font-display font-semibold uppercase tracking-[0.18em] text-sm text-primary">Chef specials, Friday and Saturday, 5pm to 8pm</p>
        <ul class="mt-3 border-t-2 border-ink">
          {specials.items.map((i) => <li class={row}><span class="font-semibold">{i.name}</span><span class="font-bold text-primary tabular-nums">{i.price}</span></li>)}
        </ul>
        <p class="mt-4 text-sm">Example content: dinner menu as posted in May 2023, nights to be confirmed.</p>
      </div>
    )}
  </div>
</section>
