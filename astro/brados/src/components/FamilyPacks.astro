---
/** Family packs: the five packs from the price list beside the pack photo. */
import { Picture } from 'astro:assets';
import { siteContent } from '../lib/site';
import { photo } from '../lib/photos';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const packs = siteContent.priceList.find((s) => s.title === 'Family packs')?.items ?? [];
const img = photo('family-pack-whole-chicken');
---
<section data-section="family-packs" aria-labelledby="packs-h2" class="bg-ground">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20 grid lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-5">
      {img && <Picture src={img} alt="Family pack with a whole BBQ chicken, large chips and a large garden salad" widths={[480, 960, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy" class="w-full aspect-square object-cover" />}
    </div>
    <div class="lg:col-span-7">
      <h2 id="packs-h2" class="font-display font-bold uppercase text-accent text-5xl sm:text-6xl leading-none">Feeding the whole table.</h2>
      <p class="mt-3 font-body text-lg text-ink/80">Five packs with large chips and a large salad, two whole BBQ chicken packs with one or the other. The tender packs add four 70ml dipping sauces.</p>
      <ul class="mt-6 divide-y divide-ink/15 border-y border-ink/15">
        {packs.map((p) => (
          <li class="flex items-baseline justify-between gap-6 py-3">
            <div><p class="font-display font-semibold uppercase text-xl sm:text-2xl text-ink">{p.name}</p>{p.note && <p class="font-body text-sm text-ink/70">{p.note}</p>}</div>
            <p class="font-display font-bold text-2xl sm:text-3xl text-ink whitespace-nowrap">{p.price}</p>
          </li>
        ))}
      </ul>
      <a href={`${base}/menu/#family-packs`} class="inline-block mt-6 font-body text-sm font-semibold uppercase tracking-[0.14em] text-ink underline underline-offset-8 decoration-2 decoration-primary hover:text-accent">All packs and meal deals</a>
    </div>
  </div>
</section>
