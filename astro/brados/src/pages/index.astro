---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import NewIn from '../components/NewIn.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import OurTenders from '../components/OurTenders.astro';
import FamilyPacks from '../components/FamilyPacks.astro';
import CateringBand from '../components/CateringBand.astro';
import AboutBrados from '../components/AboutBrados.astro';
import CommunityInitiatives from '../components/CommunityInitiatives.astro';
import FindUs from '../components/FindUs.astro';
---
<Base title="Chicken schnitzel burgers in Figtree | Brado's" description="Brado's in Figtree: chicken schnitzel burgers, tenders, Texas fried chicken, BBQ chicken, hot food, salads, gelato and cakes. Open seven days 10am to 8:30pm.">
  <Header slot="header" />
  <Hero />
  <NewIn />
  <CategoryTiles />
  <OurTenders />
  <FamilyPacks />
  <CateringBand />
  <AboutBrados />
  <CommunityInitiatives />
  <FindUs withMap={false} />
  <Footer slot="footer" />
</Base>
