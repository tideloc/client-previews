---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const suitable = [
  ['Gluten free', [
    ['Gelato flavours', 'Vanilla, Coconut, Chocolate, Strawberry, Salted Caramel, Pistachio, Chocolate Hazelnut, Mint Chocolate'],
    ['Fried food', 'Chips (excluding chilli salt)'],
    ['Hot food', 'Savoury rice, mashed potato, roast pork, peas'],
    ['Salads', 'Bean, berry yoghurt, fruit, Greek'],
    ['Salts', 'Plain salt, chicken salt, salt and vinegar'],
    ['Sauces', 'Caesar dressing, garlic aioli, jalapeno aioli, hot lava, hot chilli, Shaka, tomato, USA, Lebanese garlic, parmigiana'],
  ]],
  ['Vegetarian', [['', 'Bread rolls, all cakes, all gelato, chocolate mousse, rice pudding, jersey caramel, chips, crumbed potatoes, fritters (banana and pineapple), spring rolls, wedges, coleslaw, tabouli, all salts, all sauces']]],
  ['Vegan', [['', 'Sweet chilli, gravy']]],
];
const contains = [
  ['Fish', 'Fish pieces, fish cocktails, seafood pasta, seafood supreme'],
  ['Egg', 'Potato salad, honey mustard, mayonnaise, Moroccan dressing, New York dressing'],
  ['Milk (dairy)', 'All cheese (sliced tasty, shredded tasty, mozzarella), all gelato, creamed potato, berry yoghurt, Caesar, Moroccan, New York, potato, scallopini, sour cream'],
  ['Sesame', 'Bread rolls, therefore all burgers and rolls'],
  ['Soy', 'Chilli salt, cookies and cream gelato, African tenders, New York tenders, Portuguese wings, salsa'],
  ['Tree nut', 'Mocha crunch, cakes, Alfredo Rocher, carrot cake'],
  ['Wheat (includes gluten)', 'Biscoff, cookies and cream, calamari, nacho schnitzels, nuggets, schnitzels, Texas fried pieces, barbeque chickens, Asian chicken'],
  ['Crustacean', 'Ask at the counter'],
  ['Mollusc', 'Ask at the counter'],
];
---
<Base title="Allergen and dietary information | Brado's" description="Allergen and dietary information for the Brado's Figtree menu: gluten free, vegetarian and vegan options, and what contains fish, egg, milk, soy or wheat.">
  <Header slot="header" />
  <section data-section="allergens" aria-labelledby="all-h1" class="bg-ground">
    <div class="bg-white border-b-8 border-primary">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 pb-10 lg:pt-20 lg:pb-14">
        <h1 id="all-h1" class="font-display font-bold uppercase text-accent text-5xl sm:text-6xl lg:text-7xl leading-[0.9]">Allergen and dietary information.</h1>
        <p class="mt-6 font-body text-lg text-ink max-w-3xl">Please be advised that our food may have come in contact or may contain peanuts, tree nuts, soy, milk, eggs, wheat, shellfish or fish. If you have a serious allergy, tell us at the counter before you order.</p>
      </div>
    </div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display font-bold uppercase text-ink text-4xl leading-none">Suitable for</h2>
        {suitable.map(([title, rows]) => (
          <div class="mt-8">
            <h3 class="font-display font-semibold uppercase text-2xl text-accent border-b-4 border-primary pb-1">{title}</h3>
            <dl class="mt-3 divide-y divide-ink/10">
              {(rows as string[][]).map(([k, v]) => <div class="py-2.5 grid sm:grid-cols-3 gap-1 sm:gap-4 font-body">{k && <dt class="font-semibold text-ink">{k}</dt>}<dd class:list={['text-ink/85', k ? 'sm:col-span-2' : 'sm:col-span-3']}>{v}</dd></div>)}
            </dl>
          </div>
        ))}
      </div>
      <div>
        <h2 class="font-display font-bold uppercase text-ink text-4xl leading-none">Contains</h2>
        <dl class="mt-8 divide-y divide-ink/10 border-t-4 border-ink">
          {contains.map(([k, v]) => <div class="py-4 grid sm:grid-cols-3 gap-1 sm:gap-4 font-body"><dt class="font-display font-semibold uppercase text-xl text-accent">{k}</dt><dd class="sm:col-span-2 text-ink/85">{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
