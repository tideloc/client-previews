---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import sled from '../../assets/sled.jpg';
import rack from '../../assets/rack.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = [
  ['Casual session', 'One-on-one, 55 minutes, programmed on the day. Good for a technique check or an occasional session.', '$95 per session'],
  ['Once a week', 'Four one-on-one sessions a month plus a written programme for your other training days and check-ins between sessions.', '$340 per month'],
  ['Twice a week', 'Eight one-on-one sessions a month, full programme, nutrition basics, and first pick of early-morning slots.', '$640 per month'],
  ['Semi-private', 'Two people, one coach, one shared session. Same programme structure. Bring a partner or a mate.', '$60 per person, per session'],
  ['Programme only', 'A monthly written programme and a fortnightly check-in for people who train elsewhere.', '$120 per month'],
];
---
<Base title="Training Options & Prices | Anchor Strength, Shellharbour" description="Personal training prices at Anchor Strength in Shellharbour: casual sessions, weekly and twice-weekly coaching, semi-private and programme-only options. No lock-in contracts.">
  <section class="relative isolate overflow-hidden bg-black text-white">
    <Image src={sled} alt="Pushing a weighted sled across the studio turf" widths={[768, 1376]} sizes="100vw" loading="eager" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-50" />
    <div class="wrap py-20 md:py-28"><p class="eyebrow">Training</p><h1 class="mt-3 max-w-2xl text-[36px] leading-[1.05] sm:text-[52px]">Options and prices</h1><p class="mt-5 max-w-lg text-[16px] text-white/85">Everything is month to month. Pause any time, no exit fees, no twelve-month direct debit you forget about.</p></div>
  </section>
  <section class="wrap py-14 md:py-20">
    <div class="divide-y divide-ink/10 ring-1 ring-ink/10">
      {rows.map(([t, d, p]) => (
        <div class="grid gap-3 px-6 py-6 md:grid-cols-[1fr_auto] md:items-center">
          <div><h2 class="text-[20px] tracking-wider">{t}</h2><p class="mt-1.5 max-w-2xl text-[15px] text-ink/75">{d}</p></div>
          <p class="font-display text-[22px] font-bold text-navy">{p}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-2 md:items-center">
      <div class="overflow-hidden"><Image src={rack} alt="The squat rack and a row of kettlebells in morning light" widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
      <div class="bg-navy p-8 text-white"><h2 class="text-[26px]">Not sure which one?</h2><p class="mt-3 text-[15px] text-white/80">Book the free consult. Thirty minutes, and you'll know which option fits, or that you don't need one yet.</p><a href={`${base}/book/`} class="btn-ember mt-6">Book a free consult</a></div>
    </div>
  </section>
</Base>
