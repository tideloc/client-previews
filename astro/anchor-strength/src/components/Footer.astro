---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-black text-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-3">
    <div><p class="font-display text-xl font-bold uppercase tracking-wider">Anchor <span class="text-ember">Strength</span></p>
      <p class="mt-4 text-[14px] leading-relaxed text-ash">Private strength studio. Appointment only.<br>Unit 4, 22 Keel Lane, Shellharbour NSW 2529</p>
      <p class="mt-3 text-[15px] font-semibold"><a class="hover:text-ember" href="tel:+61412345678">0412 345 678</a></p></div>
    <div><p class="eyebrow">Hours</p>
      <dl class="mt-3 space-y-1 text-[14px] text-ash"><div class="flex gap-4"><dt class="w-24">Mon to Fri</dt><dd>5:30am to 7pm</dd></div><div class="flex gap-4"><dt class="w-24">Saturday</dt><dd>6:30am to 11am</dd></div><div class="flex gap-4"><dt class="w-24">Sunday</dt><dd>Closed</dd></div></dl></div>
    <div><p class="eyebrow">Get started</p>
      <p class="mt-3 text-[14px] text-ash">A free 30-minute consult. No sales pitch, just a plan.</p>
      <a href={`${base}/book/`} class="btn-ember mt-5">Book a free consult</a></div>
  </div>
  <div class="border-t border-white/10"><div class="wrap flex flex-col gap-2 py-5 text-[12.5px] text-ash sm:flex-row sm:justify-between"><span>&copy; 2026 Anchor Strength. Shellharbour, NSW.</span><span>Example site by <a class="underline hover:text-white" href="https://tideloc.com.au">Tideloc</a></span></div></div>
</footer>
