---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import { Picture } from 'astro:assets';
import lake from '../../assets/lake-drink.jpg';
import milkTea from '../../assets/milk-tea-lake.jpg';
import lakeLawn from '../../assets/lake-lawn.jpg';
import shopfront from '../../assets/shopfront.jpg';
import room from '../../assets/dining-room.jpg';
import verandah from '../../assets/verandah.jpg';
import benny from '../../assets/salmon-benny.jpg';
import baconBenny from '../../assets/bacon-benny.jpg';
import bigBreakfast from '../../assets/big-breakfast.jpg';
import croissant from '../../assets/bacon-egg-croissant.jpg';
import padThai from '../../assets/prawn-pad-thai.jpg';
import tomYum from '../../assets/tom-yum-prawns.jpg';
import award from '../../assets/award-2021.jpg';
const groups = [
  { title: 'The lake and the café', photos: [
    { src: lake, cap: 'On the lawn by the lake, September 2023', alt: 'A fruit iced tea held up on the lawn with the lake and blue sky behind' },
    { src: shopfront, cap: 'The shopfront, December 2022', alt: 'The Boulevard shopfront with its blue band, wordmark sign and verandah' },
    { src: room, cap: 'The dining room, December 2021', alt: 'The dining room with timber tables, tiled floor and doors open to the verandah' },
    { src: milkTea, cap: 'Milk tea by the lake, September 2023', alt: 'A milk bubble tea held up on the lawn with the lake behind' },
    { src: verandah, cap: 'Under the verandah, December 2021', alt: 'Orange chairs and a round table under the cafe verandah, looking out to the trees' },
    { src: award, cap: 'Hospitality winner, November 2021', alt: 'Framed 2021 Excellence in Business Awards certificate naming The Boulevard as hospitality winner, with a glass trophy' },
  ] },
  { title: 'From the kitchen', photos: [
    { src: benny, cap: 'Salmon benny, March 2024', alt: 'Salmon eggs benedict with hollandaise and pea shoots on a grey plate' },
    { src: bigBreakfast, cap: 'Big breakfast, October 2024', alt: 'A big breakfast plate with fried eggs, hash browns, bacon, fried chicken and mushrooms' },
    { src: baconBenny, cap: 'Bacon benny, September 2023', alt: 'Eggs benedict with bacon and spinach on a blue glazed plate' },
    { src: croissant, cap: 'Bacon and egg croissant, September 2023', alt: 'A croissant filled with bacon and a fried egg, topped with parsley' },
    { src: padThai, cap: 'Prawn pad thai, September 2023', alt: 'Prawn pad thai with bean sprouts, coriander and a wedge of lemon' },
    { src: tomYum, cap: 'Tom yum prawns, April 2023', alt: 'Tom yum prawn soup in a white bowl beside a bottle of wine and two flutes' },
  ] },
];
---
<Base title="Gallery | The Boulevard Cafe on the Lake" description="Photographs from The Boulevard Cafe on the Lake in Victor Harbor: the lake, the dining room, the verandah and plates from the kitchen.">
  <Header slot="header" />
  <PageIntro title="Gallery" line="The lake, the room and the plates, from the café's own photographs.">
    <Picture src={lakeLawn} widths={[480, 720]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 55vw, 100vw" loading="eager" alt="A drink held up on the lawn with the lake behind it" class="w-full h-72 sm:h-96 object-cover object-[50%_35%]" />
  </PageIntro>
  {groups.map((g, gi) => (
    <section data-section={gi === 0 ? 'gallery-place' : 'gallery-kitchen'} aria-labelledby={`g-${gi}`} class={gi === 1 ? 'bg-secondary' : ''}>
      <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
        <h2 id={`g-${gi}`} class="font-display font-light text-4xl sm:text-5xl">{g.title}</h2>
        {gi === 1 && <p class="mt-3 text-ink/75 max-w-2xl">Dishes change. The date under each plate is when the café posted it, so some are no longer on the menu.</p>}
        <div class="mt-10 grid grid-cols-2 lg:grid-cols-3 gap-5">
          {g.photos.map((p, i) => (
            <figure>
              <Picture src={p.src} widths={[400, 744, 1116]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 31vw, 47vw" loading={gi === 0 && i < 3 ? 'eager' : 'lazy'} alt={p.alt} class="w-full aspect-[4/5] object-cover" />
              <figcaption class="mt-2 text-sm text-ink/75">{p.cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  ))}
  <Footer slot="footer" />
</Base>
