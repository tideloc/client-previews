---
/** Home page teaser for catering and functions: the dining room and verandah photographs, the
 *  bio line, and one link through to the functions page. */
import { Picture } from 'astro:assets';
import room from '../assets/dining-room.jpg';
import verandah from '../assets/verandah.jpg';
import { base } from '../lib/links';
---
<section data-section="functions" aria-labelledby="functions-h" class="bg-secondary">
  <div class="grid lg:grid-cols-[1.6fr_1fr]">
    <Picture src={room} widths={[640, 1116]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 62vw, 100vw" loading="eager" alt="The dining room with timber tables, tiled floor and doors open to the verandah" class="w-full h-72 sm:h-96 lg:h-[30rem] object-cover" pictureAttributes={{ class: 'block' }} />
    <Picture src={verandah} widths={[640, 1024]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 38vw, 100vw" loading="eager" alt="Orange chairs and a round table under the cafe verandah, looking out to the trees" class="w-full h-72 sm:h-96 lg:h-[30rem] object-cover" pictureAttributes={{ class: 'block' }} />
  </div>
  <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20 grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-20 lg:items-center">
    <h2 id="functions-h" class="font-display font-light text-4xl sm:text-6xl leading-[1.05]">Functions and catering</h2>
    <div>
      <p class="text-lg sm:text-xl leading-relaxed text-ink/80">The café is licensed and available for catering and functions as well as dine in and takeaway. It has hosted Melbourne Cup luncheons and fundraiser dinners.</p>
      <p class="mt-7"><a href={`${base}/functions/`} class="inline-block bg-ink text-ground font-semibold px-7 py-4">Ask about a function</a></p>
    </div>
  </div>
</section>
