---
import ContactDetails from './tl/ContactDetails.astro';
import Wave from './Wave.astro';
import { siteContent } from '../lib/site';
import { nav, directionsUrl } from '../lib/links';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-ground pb-24" data-section="footer">
  <div class="mx-auto max-w-7xl px-6 py-16 grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display uppercase tracking-[0.26em] text-2xl">The Boulevard</p>
      <Wave class="w-36 h-5 my-3" under="#f4f2ea" />
      <p class="font-display tracking-[0.32em] text-xs text-ground/70">café on the lake</p>
    </div>
    <div>
      <ContactDetails class="not-italic space-y-2.5 text-ground/90" linkClass="underline underline-offset-4 decoration-ground/30" />
      <p class="mt-3"><a href={directionsUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 decoration-ground/30">Get directions</a></p>
    </div>
    <ul class="space-y-2.5 text-ground/90">
      {nav.map((n) => <li><a href={n.href} class="hover:underline">{n.label}</a></li>)}
      {siteContent.social.facebook && <li><a href={siteContent.social.facebook} target="_blank" rel="noreferrer" class="hover:underline">Facebook</a></li>}
    </ul>
  </div>
  <div class="mx-auto max-w-7xl px-6 py-6 border-t border-ground/15 text-sm text-ground/60">
    <p>&copy; {year} {siteContent.businessName}, Victor Harbor SA.</p>
  </div>
</footer>
