---
/** Video tabs. Reels tab is real (six Instagram posts). Full adventures and Tips are placeholder slots
 *  for YouTube embeds, labelled as coming soon (their own words, 28 Jun 2026 post). Tab row wraps; no carousel. */
import { Picture } from 'astro:assets';
import { reels, YOUTUBE } from '../data/reels';
interface Props { limit?: number; heading?: string; id?: string }
const { limit = reels.length, heading = 'Latest drifts.', id = 'drifts' } = Astro.props;
const list = reels.slice(0, limit);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const placeholders = {
  adventures: [
    { label: 'Full adventure 1', note: 'Coming to YouTube @ReelDriftWA' },
    { label: 'Full adventure 2', note: 'Coming to YouTube @ReelDriftWA' },
    { label: 'Full adventure 3', note: 'Coming to YouTube @ReelDriftWA' },
  ],
  tips: [
    { label: 'Practical tips 1', note: 'Video slot, coming soon' },
    { label: 'Practical tips 2', note: 'Video slot, coming soon' },
    { label: 'Practical tips 3', note: 'Video slot, coming soon' },
  ],
};
---
<section data-section="videos" aria-labelledby={`${id}-h`} class="bg-ground text-ink">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b-2 border-primary pb-5">
      <h2 id={`${id}-h`} class="font-display font-extrabold uppercase leading-none text-4xl sm:text-5xl">{heading}</h2>
      <div role="tablist" aria-label="Video types" class="flex flex-wrap gap-2" data-tabs={id}>
        <button role="tab" id={`${id}-tab-reels`} aria-selected="true" aria-controls={`${id}-panel-reels`} class="px-4 py-2 font-display font-light uppercase tracking-[0.25em] text-xs border border-primary aria-selected:bg-primary aria-selected:text-ground">Reels</button>
        <button role="tab" id={`${id}-tab-adventures`} aria-selected="false" aria-controls={`${id}-panel-adventures`} tabindex="-1" class="px-4 py-2 font-display font-light uppercase tracking-[0.25em] text-xs border border-primary aria-selected:bg-primary aria-selected:text-ground">Full adventures</button>
        <button role="tab" id={`${id}-tab-tips`} aria-selected="false" aria-controls={`${id}-panel-tips`} tabindex="-1" class="px-4 py-2 font-display font-light uppercase tracking-[0.25em] text-xs border border-primary aria-selected:bg-primary aria-selected:text-ground">Tips</button>
      </div>
    </div>

    <div role="tabpanel" id={`${id}-panel-reels`} aria-labelledby={`${id}-tab-reels`} class="pt-8">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {list.map((r) => (
          <li class="border border-primary/20 bg-secondary/40 flex flex-col">
            <a href={r.url} target="_blank" rel="noreferrer" class="relative block aspect-[4/3] overflow-hidden bg-primary" aria-label={`${r.kind === 'reel' ? 'Watch' : 'View'} on Instagram: ${r.title}`}>
              <Picture src={r.cover} widths={[480, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" formats={['avif', 'webp']} alt={r.alt} class="h-full w-full object-cover" pictureAttributes={{ class: 'absolute inset-0' }} />
              {r.kind === 'reel' && <span class="absolute inset-0 grid place-items-center" aria-hidden="true"><span class="w-16 h-16 border-2 border-ground/90 bg-primary/60 grid place-items-center text-ground text-2xl">&#9654;</span></span>}
              <span class="absolute left-3 top-3 bg-ground text-ink px-2 py-1 font-display font-light uppercase tracking-[0.25em] text-[10px]">{r.kind === 'reel' ? 'Reel' : 'Post'}</span>
            </a>
            <div class="p-5 flex-1 flex flex-col">
              <p class="font-display font-light uppercase tracking-[0.25em] text-[11px] text-ink/60">{r.date}</p>
              <h3 class="mt-2 font-display font-extrabold uppercase leading-tight text-lg">{r.title}</h3>
              <p class="mt-2 text-sm text-ink/80 flex-1">{r.caption}</p>
              <ul class="mt-4 flex flex-wrap gap-2">{r.tags.map((t) => (<li class="border border-primary/30 px-2 py-0.5 text-xs">{t}</li>))}</ul>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {(['adventures', 'tips'] as const).map((k) => (
      <div role="tabpanel" id={`${id}-panel-${k}`} aria-labelledby={`${id}-tab-${k}`} hidden class="pt-8">
        <p class="max-w-2xl text-lg">{k === 'adventures' ? 'Full adventures will be shared on YouTube @ReelDriftWA. New content is on the way.' : 'Practical tips from the boat, as promised in the first post. Slots ready for the videos.'}</p>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {placeholders[k].map((p) => (
            <li class="border border-primary/20 bg-primary text-ground aspect-video relative grid place-items-center p-6" data-placeholder="video">
              <img src={`${base}/mark-cream.png`} alt="" width="440" height="200" class="absolute left-4 top-4 w-16 h-auto opacity-60" aria-hidden="true" />
              <div class="text-center">
                <span class="block w-14 h-14 mx-auto border-2 border-ground/80 grid place-items-center text-xl" aria-hidden="true">&#9654;</span>
                <p class="mt-3 font-display font-extrabold uppercase text-base">{p.label}</p>
                <p class="mt-1 text-xs text-ground/70">{p.note}</p>
              </div>
            </li>
          ))}
        </ul>
        <a href={YOUTUBE} target="_blank" rel="noreferrer" class="mt-6 inline-block font-display font-light uppercase tracking-[0.3em] text-xs border-b border-primary pb-1">YouTube @ReelDriftWA</a>
      </div>
    ))}
  </div>
</section>
<script is:inline define:vars={{ id }}>
  (function () {
    var root = document.querySelector('[data-tabs="' + id + '"]'); if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    function select(tab) {
      tabs.forEach(function (t) { var on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; var p = document.getElementById(t.getAttribute('aria-controls')); if (p) p.hidden = !on; });
      tab.focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(t); });
      t.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length]); if (e.key === 'ArrowLeft') select(tabs[(i - 1 + tabs.length) % tabs.length]); });
    });
  })();
</script>
