---
/** Links-only closer (no form). Used where the page already carries the form elsewhere or the outcome is follow, not message. */
import { INSTAGRAM, YOUTUBE } from '../data/reels';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-section="follow" aria-labelledby="follow-strip-h" class="bg-primary text-ground">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-12 lg:py-16 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
    <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
      <h2 id="follow-strip-h" class="font-display font-extrabold uppercase leading-none text-3xl sm:text-4xl">Follow the drift.</h2>
      <p class="font-script text-3xl text-ground/90">Until the next drift.</p>
    </div>
    <ul class="flex flex-wrap gap-3">
      <li><a href={INSTAGRAM} target="_blank" rel="noreferrer" class="inline-flex items-center gap-3 bg-ground text-primary px-5 py-3.5 font-display font-extrabold uppercase tracking-wide text-sm">Instagram <span class="font-light tracking-[0.2em] text-xs">@reel.drift.wa</span></a></li>
      <li><a href={YOUTUBE} target="_blank" rel="noreferrer" class="inline-flex items-center gap-3 border border-ground/60 px-5 py-3.5 font-display font-extrabold uppercase tracking-wide text-sm">YouTube <span class="font-light tracking-[0.2em] text-xs">@ReelDriftWA</span></a></li>
      <li><a href={`${base}/contact/`} class="inline-flex items-center border-b border-ground/60 pb-1 self-center font-display font-light uppercase tracking-[0.3em] text-xs">Send a message</a></li>
    </ul>
  </div>
</section>
