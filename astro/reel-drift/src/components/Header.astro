---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: `${base}/videos/`, label: 'Videos', key: '/videos/' },
  { href: `${base}/about/`, label: 'About', key: '/about/' },
  { href: `${base}/contact/`, label: 'Contact', key: '/contact/' },
];
---
<header class="sticky top-0 z-30 bg-ground/95 backdrop-blur border-b border-primary/15" data-section="header">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 h-20 flex items-center justify-between gap-6">
    <a href={`${base}/`} class="flex items-center gap-3 shrink-0" aria-label="Reel Drift home">
      <img src={`${base}/logo-navy.png`} alt="Reel Drift" width="660" height="360" class="h-14 w-auto" />
    </a>
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {nav.map((n) => (
          <li><a href={n.href} class={`font-display font-light uppercase tracking-[0.3em] text-[13px] py-2 border-b-2 ${path.startsWith(n.key) ? 'border-primary' : 'border-transparent hover:border-primary/40'}`}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={`${base}/videos/`} class="hidden sm:inline-flex bg-primary text-ground px-5 py-3 font-display font-extrabold uppercase tracking-wide text-sm">Watch the latest drift</a>
      <button type="button" class="md:hidden inline-flex items-center justify-center w-11 h-11 border border-primary" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" data-menu-btn>
        <span class="block w-5 border-t-2 border-primary relative before:absolute before:-top-2 before:left-0 before:w-5 before:border-t-2 before:border-primary after:absolute after:top-1 after:left-0 after:w-5 after:border-t-2 after:border-primary"></span>
      </button>
    </div>
  </div>
  <div id="mobile-nav" hidden class="md:hidden border-t border-primary/15 bg-ground">
    <ul class="px-5 py-4 grid gap-1">
      {nav.map((n) => (<li><a href={n.href} class="block py-3 font-display font-light uppercase tracking-[0.3em] text-sm border-b border-primary/10">{n.label}</a></li>))}
      <li class="pt-3"><a href={`${base}/videos/`} class="block text-center bg-primary text-ground px-5 py-3 font-display font-extrabold uppercase tracking-wide text-sm">Watch the latest drift</a></li>
    </ul>
  </div>
</header>
<script is:inline>
  (function(){var b=document.querySelector('[data-menu-btn]'),m=document.getElementById('mobile-nav');if(!b||!m)return;b.addEventListener('click',function(){var o=m.hidden;m.hidden=!o;b.setAttribute('aria-expanded',String(o));b.setAttribute('aria-label',o?'Close menu':'Open menu');});})();
</script>
