---
interface Props { showLink?: boolean }
const { showLink = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = [
  { who: 'Education', does: 'prepares them.' },
  { who: 'Industry', does: 'sponsors them.' },
  { who: 'RTOs', does: 'certify them.' },
  { who: 'DAMO', does: 'develops them.', hot: true },
];
---
<section data-section="model" aria-labelledby="model-h" class="bg-secondary text-white">
  <div class="wrap py-16 lg:py-24">
    <h2 id="model-h" class="label text-steel">The DAMO model</h2>
    <dl class="mt-8 border-t border-white/30">
      {rows.map((r) => (
        <div class={`grid grid-cols-1 sm:grid-cols-12 items-baseline gap-x-6 py-4 lg:py-6 ${r.hot ? 'bg-primary -mx-5 px-5 sm:-mx-8 sm:px-8 mt-px' : 'border-b border-white/30'}`}>
          <dt class={`display sm:col-span-5 text-[2.1rem] sm:text-5xl lg:text-7xl ${r.who === 'RTOs' ? '!normal-case' : ''}`}>{r.who}</dt>
          <dd class="display sm:col-span-7 text-[2.1rem] sm:text-5xl lg:text-7xl">{r.does}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-6">
      <p class="max-w-2xl text-lg text-white/85">DAMO works with relevant RTO and training partners, and connects them with education and employers through one structured pathway.</p>
      {showLink && <a href={`${base}/employers/`} class="inline-flex items-center gap-2 font-display font-extrabold uppercase tracking-wider text-sm border-b-2 border-white pb-1">Partner with DAMO <span aria-hidden="true">&rarr;</span></a>}
    </div>
  </div>
</section>
