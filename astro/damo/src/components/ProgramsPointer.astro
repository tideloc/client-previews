---
import { Picture } from 'astro:assets';
import fifo from '../assets/gen-lifeready.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-section="programs" aria-labelledby="pp-h" class="bg-ground">
  <div class="wrap py-16 lg:py-24">
    <h2 id="pp-h" class="sr-only">Cadet Passport and LIFE READY</h2>
    <div class="grid lg:grid-cols-12 gap-4">
      <div class="lg:col-span-5 bg-secondary text-white p-7 sm:p-10 border-l-[10px] border-primary flex flex-col">
        <p class="label text-steel">DAMO Cadet Passport</p>
        <h3 class="display text-3xl sm:text-4xl mt-3">One career. One development journey.</h3>
        <p class="mt-5 text-lg text-white/90">Being designed as a portable record of an individual's career development.</p>
        <p class="mt-5"><span class="inline-block bg-steel text-secondary label px-3 py-2">Status: being developed</span></p>
        <p class="mt-auto pt-8"><a href={`${base}/careers/#cadet-passport`} class="inline-flex items-center gap-2 font-display font-extrabold uppercase tracking-wider text-sm border-b-2 border-white pb-1">About the Cadet Passport <span aria-hidden="true">&rarr;</span></a></p>
      </div>
      <div class="lg:col-span-7 relative min-h-[26rem]">
        <Picture src={fifo} formats={['avif', 'webp']} widths={[640, 1024, 1376]} sizes="(min-width:1024px) 58vw, 100vw"
          alt="Two FIFO workers in hi-vis carrying duffel bags toward a small plane on a red dirt airstrip"
          class="absolute inset-0 w-full h-full object-cover" pictureAttributes={{ class: 'block' }} />
        <div class="absolute left-0 bottom-0 bg-steel text-secondary p-6 sm:p-8 max-w-md">
          <p class="label text-primary">DAMO LIFE READY</p>
          <h3 class="display text-2xl sm:text-3xl mt-2">Building people, not just workers.</h3>
          <p class="mt-4"><a href={`${base}/careers/#life-ready`} class="arrow-link">About LIFE READY <span aria-hidden="true">&rarr;</span></a></p>
        </div>
      </div>
    </div>
  </div>
</section>
