---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/careers/`, label: 'Careers' },
  { href: `${base}/employers/`, label: 'Employers and partners' },
  { href: `${base}/contact/`, label: 'Register interest' },
];
const isActive = (href: string) => (href === `${base}/` ? path === href : path.startsWith(href));
---
<header class="bg-ground border-b-4 border-primary sticky top-0 z-30">
  <div class="wrap flex items-center justify-between gap-6 py-3">
    <a href={`${base}/`} class="shrink-0" aria-label="DAMO home">
      <Image src={logo} alt="DAMO Development and Management Organisation logo in royal blue" width={520} loading="eager" class="h-14 sm:h-20 w-auto" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8 font-display font-bold uppercase tracking-wider text-[0.82rem] text-secondary">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class={`py-2 border-b-2 ${isActive(n.href) ? 'border-primary text-primary' : 'border-transparent hover:border-steel'}`}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={`${base}/contact/`} class="btn-primary !py-3 !px-4 !text-[0.78rem] hidden sm:inline-flex">Register your interest</a>
      <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" class="lg:hidden inline-flex items-center justify-center w-11 h-11 border-2 border-secondary text-secondary rounded-sm">
        <span class="sr-only">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" hidden class="lg:hidden bg-secondary text-white">
    <ul class="wrap py-4 grid gap-1 font-display font-bold uppercase tracking-wider">
      {nav.map((n) => <li><a href={n.href} class="block py-3 border-b border-white/15">{n.label}</a></li>)}
      <li class="pt-4 pb-2"><a href={`${base}/contact/`} class="btn-primary on-blue w-full justify-center">Register your interest</a></li>
    </ul>
  </nav>
</header>
<script is:inline>
  (function () {
    var b = document.getElementById('nav-toggle'), m = document.getElementById('mobile-nav');
    if (!b || !m) return;
    b.addEventListener('click', function () { var open = m.hidden; m.hidden = !open; b.setAttribute('aria-expanded', String(open)); });
  })();
</script>
