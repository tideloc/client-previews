---
import { getImage } from 'astro:assets';
import mine from '../assets/gen-mining.jpg';
import InterestForm from './InterestForm.astro';
const bg = await getImage({ src: mine, width: 1376, format: 'webp' });
const buttons = [
  { label: "I'm looking for a career", i: 'career' },
  { label: "I'm an employer", i: 'employer' },
  { label: "I'm a school / education partner", i: 'school' },
  { label: "I'm a training provider", i: 'training' },
];
---
<section id="register" data-section="register" aria-labelledby="cta-h" class="relative text-white bg-secondary bg-cover bg-center scroll-mt-24" style={`background-image:linear-gradient(rgba(18,51,91,.90),rgba(18,51,91,.84)),url(${bg.src})`}>
  <div class="wrap py-16 lg:py-24 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-6 lg:self-center">
      <p class="label text-steel">DAMO is preparing for launch</p>
      <h2 id="cta-h" class="display text-4xl sm:text-5xl lg:text-6xl mt-4">Where could your career take you?</h2>
      <p class="mt-6 text-lg sm:text-xl text-white/90">Whether you're still at school, looking for a new direction, already working in industry or looking to develop your workforce, start the conversation with DAMO.</p>
      <ul class="mt-9 grid gap-3 sm:grid-cols-2">
        {buttons.map((b) => (
          <li><a href="#register-form" data-pick-audience={b.i} class="flex h-full items-center justify-between gap-3 border-2 border-white px-5 py-4 font-display font-extrabold uppercase tracking-wide text-sm hover:bg-white hover:text-secondary transition-colors">{b.label} <span aria-hidden="true">&rarr;</span></a></li>
        ))}
      </ul>
    </div>
    <div id="register-form" class="lg:col-span-6 bg-white text-ink p-6 sm:p-9 border-t-8 border-primary self-start scroll-mt-28">
      <h3 class="display text-secondary text-3xl">Register your interest.</h3>
      <p class="mt-3 text-ink/90">Candidates, schools, employers, training providers and industry partners can all register here.</p>
      <div class="mt-6"><InterestForm /></div>
    </div>
  </div>
</section>
