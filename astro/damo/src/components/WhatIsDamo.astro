---
const connects = ['People', 'Education', 'Employers', 'Training providers'];
const nots = ['a labour-hire company', 'a recruitment agency', 'a traditional training provider'];
---
<section data-section="about" aria-labelledby="what-h" class="bg-ground">
  <div class="wrap py-16 lg:py-24 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 id="what-h" class="label text-primary">What is DAMO?</h2>
      <p class="mt-5 font-display font-bold text-secondary text-2xl sm:text-4xl lg:text-[2.6rem] leading-[1.15]">DAMO connects people, education, employers and training providers through structured career-development pathways designed to build capable people and stronger Australian industries.</p>
      <ul class="mt-9 grid grid-cols-2 sm:grid-cols-4 gap-[2px] p-[2px] bg-secondary">
        {connects.map((c) => <li class="bg-white px-3 py-4 text-center font-display font-extrabold uppercase tracking-wide text-sm text-secondary">{c}</li>)}
      </ul>
      <p class="mt-3 text-sm text-ink/80">Four groups, connected by one structured pathway.</p>
    </div>
    <div class="lg:col-span-5 lg:border-l-4 lg:border-primary lg:pl-10">
      <p class="label text-ink/70">An Australian workforce-development organisation. Not:</p>
      <ul class="mt-4 grid gap-2">
        {nots.map((n) => <li class="display text-2xl sm:text-3xl text-ink/45 line-through decoration-primary decoration-4">{n}</li>)}
      </ul>
      <p class="mt-8 text-lg leading-relaxed"><strong class="text-secondary">DAMO is not selling courses.</strong> DAMO is building and managing career pathways, from career discovery through employment, development, qualifications and leadership.</p>
    </div>
  </div>
</section>
