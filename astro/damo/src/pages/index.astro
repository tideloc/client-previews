---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroClaim from '../components/HeroClaim.astro';
import WhatIsDamo from '../components/WhatIsDamo.astro';
import AudienceDoors from '../components/AudienceDoors.astro';
import ModelStatement from '../components/ModelStatement.astro';
import ProgramsPointer from '../components/ProgramsPointer.astro';
