---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PathwayRail from '../../components/PathwayRail.astro';
import ProgramsBlock from '../../components/ProgramsBlock.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import school from '../../assets/gen-school.jpg';
import entrant from '../../assets/gen-entrant.jpg';
import advance from '../../assets/gen-advance.jpg';
import hero from '../../assets/gen-careers.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const looksFor = ['Attitude', 'Reliability', 'Willingness to learn', 'People who want to build a future'];
const advanceSteps = ['Identify existing capability', 'Close competency gaps', 'Build a clearer pathway toward qualifications and career progression'];
---
<Base title="Industry careers and DAMO ADVANCE | DAMO" description="School leavers, career entrants and existing workers: see the DAMO career pathway from Discover to Manage, DAMO ADVANCE, the Cadet Passport and LIFE READY.">
  <SiteHeader slot="header" />

  <section data-section="hero" aria-labelledby="careers-h" class="bg-primary text-white">
    <div class="wrap grid lg:grid-cols-12 gap-10 py-14 lg:py-20 items-center">
      <div class="lg:col-span-7">
        <p class="label text-steel">Careers with DAMO</p>
        <h1 id="careers-h" class="display text-[2.6rem] sm:text-6xl lg:text-7xl mt-4">Don't just find a job. <span class="text-steel">Build a career.</span></h1>
        <p class="mt-7 text-lg sm:text-xl text-white/90 max-w-xl">Creating clearer pathways from education and career entry to employment, skills, qualifications and leadership.</p>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 font-display font-extrabold uppercase tracking-wider text-sm">
          <li><a class="border-b-2 border-white/70 pb-1 hover:border-white" href="#school-leavers">School leavers</a></li>
          <li><a class="border-b-2 border-white/70 pb-1 hover:border-white" href="#career-entrants">Career entrants</a></li>
          <li><a class="border-b-2 border-white/70 pb-1 hover:border-white" href="#advance">Existing workers</a></li>
        </ul>
      </div>
      <Picture src={hero} formats={['avif', 'webp']} widths={[640, 928]} sizes="(min-width:1024px) 38vw, 100vw" loading="eager" fetchpriority="high"
        alt="Apprentice in a welding helmet welding a steel frame while a tradesperson watches on"
        class="w-full h-72 lg:h-[30rem] object-cover object-[50%_30%] border-4 border-white/90" pictureAttributes={{ class: 'lg:col-span-5 block' }} />
    </div>
  </section>

  <PathwayRail heading="Six stages. One pathway." intro="The DAMO career pathway runs from Discover to Manage. Career progression is role and capability dependent." />

  <section id="school-leavers" data-section="school-leavers" aria-labelledby="sl-h" class="bg-ground scroll-mt-24">
    <div class="wrap py-16 lg:py-20 grid gap-10 lg:grid-cols-12 items-center">
      <Picture src={school} formats={['avif', 'webp']} widths={[640, 1024, 1376]} sizes="(min-width:1024px) 55vw, 100vw"
        alt="School leaver in a hi-vis vest standing at a workshop roller door watching fabrication work"
        class="w-full h-72 lg:h-[28rem] object-cover" pictureAttributes={{ class: 'lg:col-span-7 block' }} />
      <div class="lg:col-span-5">
        <p class="label text-primary">School leavers</p>
        <h2 id="sl-h" class="display text-secondary text-3xl sm:text-4xl lg:text-5xl mt-3">Your future starts with a conversation.</h2>
        <p class="mt-5 text-lg leading-relaxed">Discover careers you may never have considered and understand where they could take you.</p>
        <p class="mt-7"><a href={`${base}/contact/?i=career`} class="arrow-link">Explore industry careers <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  <section id="career-entrants" data-section="career-entrants" aria-labelledby="ce-h" class="bg-steel scroll-mt-24">
    <div class="wrap py-16 lg:py-20 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-6">
        <p class="label text-primary">Career entrants</p>
        <h2 id="ce-h" class="display text-secondary text-3xl sm:text-4xl lg:text-5xl mt-3">Ready for something different?</h2>
        <p class="mt-5 text-lg leading-relaxed">You don't need years of industry experience. DAMO looks for attitude, reliability, willingness to learn and people who want to build a future.</p>
        <h3 class="label text-secondary mt-8">What DAMO looks for</h3>
        <ul class="mt-3 border-t-2 border-secondary">
          {looksFor.map((l) => <li class="border-b border-secondary/30 py-3 display text-xl sm:text-2xl text-secondary">{l}</li>)}
        </ul>
        <p class="mt-7"><a href={`${base}/contact/?i=career`} class="arrow-link">Start your industry career <span aria-hidden="true">&rarr;</span></a></p>
      </div>
      <Picture src={entrant} formats={['avif', 'webp']} widths={[640, 1024, 1376]} sizes="(min-width:1024px) 48vw, 100vw"
        alt="Gloved hands guiding a new worker holding an abrasive blasting nozzle over steel pipe"
        class="w-full h-72 lg:h-[32rem] object-cover" pictureAttributes={{ class: 'lg:col-span-6 block' }} />
    </div>
  </section>

  <section id="advance" data-section="advance" aria-labelledby="adv-h" class="bg-secondary text-white scroll-mt-24">
    <div class="wrap py-16 lg:py-20">
      <p class="label text-steel">Existing workers</p>
      <div class="grid gap-10 lg:grid-cols-12 mt-3">
        <div class="lg:col-span-7">
          <h2 id="adv-h" class="display text-4xl sm:text-5xl lg:text-6xl">DAMO ADVANCE. <span class="text-steel">Experience should take you somewhere.</span></h2>
          <p class="mt-6 text-lg leading-relaxed text-white/90 max-w-2xl">Already working in industry? DAMO ADVANCE is designed to help experienced workers identify existing capability, close competency gaps and build a clearer pathway toward qualifications and career progression.</p>
          <ul class="mt-8 grid gap-0 border-t border-white/25 max-w-2xl">
            {advanceSteps.map((s) => (
              <li class="flex gap-4 items-baseline border-b border-white/25 py-4"><span aria-hidden="true" class="h-2 w-2 bg-steel shrink-0 translate-y-[-2px]"></span><span class="font-semibold text-lg">{s}</span></li>
            ))}
          </ul>
          <p class="mt-8"><a href={`${base}/contact/?i=career`} class="inline-flex items-center gap-2 font-display font-extrabold uppercase tracking-wider text-sm border-b-2 border-white pb-1">Advance my career <span aria-hidden="true">&rarr;</span></a></p>
        </div>
        <Picture src={advance} formats={['avif', 'webp']} widths={[640, 1024, 1376]} sizes="(min-width:1024px) 40vw, 100vw"
          alt="Industrial painter in a protective hood spraying coating onto a large steel pipe spool"
          class="w-full h-72 lg:h-full object-cover" pictureAttributes={{ class: 'lg:col-span-5 block' }} />
      </div>
    </div>
  </section>

  <ProgramsBlock />

  <CtaStrip />
  <SiteFooter slot="footer" />
</Base>
