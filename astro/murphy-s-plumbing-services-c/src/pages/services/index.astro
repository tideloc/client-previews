---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { alts } from '../../lib/photos';
import manholeDrawing from '../../assets/gen-exploded-manhole.jpg';
import pressDrawing from '../../assets/gen-exploded-pressfit.jpg';
import water from '../../assets/project-stainless-vertical.jpg';
import sewer from '../../assets/project-trench-pipe-shoring.jpg';
import storm from '../../assets/project-stormwater-pit.jpg';
import gas from '../../assets/project-pe-gravel-bedding.jpg';
import trench from '../../assets/project-trench-bedding.jpg';
import manhole from '../../assets/project-manhole-riser-worker.jpg';
import plant from '../../assets/project-stainless-plant.jpg';
import pe from '../../assets/weld-pe-pipe-trench.jpg';
import dicl from '../../assets/dicl-pipe-crane-sling.jpg';
import press from '../../assets/project-press-fit-plant.jpg';
import pvc from '../../assets/project-pvc-valves-trench.jpg';
import concrete from '../../assets/project-pink-pipe-manhole.jpg';
import { eyebrow } from '../../lib/links';
const scopes = [
  { name: 'Water supply', text: 'Water supply pipework and treatment plant piping.', img: water, file: 'project-stainless-vertical.jpg' },
  { name: 'Sewage', text: 'Large-scale sewage pipework for civil infrastructure projects.', img: sewer, file: 'project-trench-pipe-shoring.jpg' },
  { name: 'Stormwater', text: 'Stormwater systems for civil infrastructure projects.', img: storm, file: 'project-stormwater-pit.jpg' },
  { name: 'Gas', text: 'Gas systems for civil and industrial projects.', img: gas, file: 'project-pe-gravel-bedding.jpg' },
  { name: 'Deep trenching', text: 'Precise trenching and navigation around existing services, with our own 22-tonne and 5-tonne excavators.', img: trench, file: 'project-trench-bedding.jpg' },
  { name: 'Manhole installations', text: 'Manhole installations on civil infrastructure projects.', img: manhole, file: 'project-manhole-riser-worker.jpg' },
  { name: 'Treatment plant piping', text: 'Specialised piping inside treatment plants.', img: plant, file: 'project-stainless-plant.jpg' },
];
const materials = [
  { name: 'PE 100 polyethylene', text: 'Electrofusion and butt welding, certified.', img: pe, file: 'weld-pe-pipe-trench.jpg' },
  { name: 'Ductile Iron Cement Lined (DICL) and steel', text: 'Steel and DICL installations.', img: dicl, file: 'dicl-pipe-crane-sling.jpg' },
  { name: 'Stainless steel and copper press fit', text: 'Press fit installations.', img: press, file: 'project-press-fit-plant.jpg' },
  { name: 'PVC', text: 'PVC pipework.', img: pvc, file: 'project-pvc-valves-trench.jpg' },
  { name: 'Concrete', text: 'Concrete pipework.', img: concrete, file: 'project-pink-pipe-manhole.jpg' },
];
const certs = ['PE 100 installations', 'Electrofusion', 'Butt Welding', 'Vac Operations'];
---
<Base title="Civil and industrial plumbing services | Murphy's Plumbing Services" description="Water, sewage, stormwater and gas pipework, deep trenching, manholes and treatment plant piping in PE 100, DICL, press fit, PVC and concrete.">
  <Header slot="header" />
  <section data-section="services-lead" aria-labelledby="sv-h1" class="relative bg-ground text-ink overflow-hidden">
    <Picture src={manholeDrawing} widths={[640, 928]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high"
      alt="Exploded-view line drawing of a precast concrete manhole: base, riser rings, taper and cover separated vertically"
      pictureAttributes={{ class: 'absolute right-0 top-0 h-full lg:w-[42%] drawing opacity-30 lg:opacity-100' }} class="w-full h-full object-contain object-[50%_50%] lg:object-[100%_50%]" />
    <div class="relative mx-auto max-w-[88rem] px-5 lg:px-10 pt-14 lg:pt-24 pb-16 lg:pb-24 lg:min-h-[70vh] grid lg:grid-cols-12 items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>Services</p>
        <h1 id="sv-h1" class="mt-5 font-display font-light text-5xl lg:text-7xl leading-[1] max-w-3xl">Civil and industrial plumbing for complex infrastructure projects.</h1>
        <p class="mt-7 text-lg text-accent max-w-2xl">We provide specialised solutions for civil infrastructure, focusing on water, sewage, stormwater, and gas systems. From deep trenching and manhole installations to treatment plant piping, our expertise ensures every project is handled with precision and efficiency.</p>
      </div>
    </div>
  </section>

  <section data-section="scopes" aria-labelledby="sc-h2" class="bg-ground text-ink border-t hairline">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
      <h2 id="sc-h2" class={`${eyebrow} border-b hairline pb-4`}>Scopes</h2>
      <ul>
        {scopes.map((s) => (
          <li class="reveal py-8 border-b hairline grid gap-6 md:grid-cols-12 md:items-center">
            <h3 class="md:col-span-4 font-display font-light text-3xl lg:text-5xl leading-none">{s.name}</h3>
            <p class="md:col-span-5 text-accent">{s.text}</p>
            <Picture src={s.img} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 768px) 25vw, 100vw" alt={alts[s.file]} loading="lazy" pictureAttributes={{ class: 'md:col-span-3 block' }} class="w-full aspect-[4/3] object-cover" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-section="materials" aria-labelledby="mat-h2" class="relative bg-ink text-ground overflow-hidden">
    <div class="relative mx-auto max-w-[88rem] px-5 lg:px-10 py-20 lg:py-28">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <p class="font-medium uppercase tracking-[0.28em] text-[11px] text-ground/60">Materials</p>
          <h2 id="mat-h2" class="mt-4 font-display font-light text-4xl lg:text-6xl leading-[1.05]">PE 100, DICL, steel, stainless and copper press fit, PVC and concrete.</h2>
          <p class="mt-6 text-ground/75 max-w-2xl">We stand out for our expertise in handling diverse pipe materials. This flexibility ensures we can adapt to the specific needs of every job, delivering durable and reliable results every time.</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <Picture src={pressDrawing} widths={[640, 1024]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 30vw, 100vw" loading="lazy"
            alt="Exploded-view line drawing of a stainless press-fit joint: pipe ends, fitting and seal ring separated inside the jaw outline"
            pictureAttributes={{ class: 'block drawing-inv reveal mb-6' }} class="w-full aspect-square object-cover" />
          <p class="font-medium uppercase tracking-[0.28em] text-[11px] text-ground/60 border-b hairline-dark pb-2">Certifications held</p>
          <ul>
            {certs.map((c) => <li class="py-2 border-b hairline-dark font-display text-lg">{c}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {materials.map((m) => (
          <figure class="reveal">
            <Picture src={m.img} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 20vw, (min-width: 640px) 50vw, 100vw" alt={alts[m.file]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
            <figcaption class="mt-3"><span class="block font-display text-xl leading-tight">{m.name}</span><span class="block mt-1 text-sm text-ground/70">{m.text}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <EnquiryBand compact heading="Send the scope and the materials, and we will price it." />
  <Footer slot="footer" />
</Base>
