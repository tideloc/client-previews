---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageLead from '../../components/PageLead.astro';
import Footer from '../../components/Footer.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { alts, fileName } from '../../lib/photos';

const all = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.jpg', { eager: true });
const photos = Object.entries(all)
  .filter(([p]) => !/hero-|logo|mark|gen-/.test(p))
  .map(([p, m]) => ({ src: m.default, alt: alts[fileName(p)] ?? '', landscape: m.default.width > m.default.height }));
---
<Base title="Projects | Murphy's Plumbing Services" description="Photos from Murphy's Plumbing Services civil plumbing projects: large-scale infrastructure works, treatment plant piping, manholes and trenching.">
  <Header slot="header" />
  <PageLead kicker="Projects" title="Our work across infrastructure projects." lead="Recent projects range from large-scale infrastructure works to small and medium civil plumbing jobs. Take a look at our work showcasing the scale and precision of our industrial and civil plumbing projects." />
  <section data-section="gallery" aria-label="Project photographs" class="bg-primary text-ink border-t rule">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-14 lg:py-20 grid grid-cols-2 md:grid-cols-4 gap-4">
      {photos.map((p) => (
        <figure class={`${p.landscape ? 'col-span-2' : 'col-span-1'}`}>
          <Picture src={p.src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes={p.landscape ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'} alt={p.alt} loading="lazy" pictureAttributes={{ class: 'block' }} class={`w-full object-cover ${p.landscape ? 'aspect-[3/2]' : 'aspect-[3/4]'}`} />
        </figure>
      ))}
    </div>
  </section>
  <EnquiryBand compact heading="Have a project like these to price?" />
  <Footer slot="footer" />
</Base>
