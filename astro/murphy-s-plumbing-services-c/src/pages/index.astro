---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import WeldingSection from '../components/WeldingSection.astro';
import PlantSection from '../components/PlantSection.astro';
import CredentialsSection from '../components/CredentialsSection.astro';
import RecentWork from '../components/RecentWork.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
---
<Base title="Civil plumbing contractor, Illawarra | Murphy's Plumbing Services" description="Illawarra civil plumbing contractor for builders. Licensed, PE 100 certified, own excavators for wet or dry hire. Water, sewer, stormwater and gas pipework.">
  <Header slot="header" />
  <Hero />
  <ServicesSection />
  <WeldingSection />
  <PlantSection />
  <CredentialsSection />
  <RecentWork />
  <EnquiryBand />
  <Footer slot="footer" />
</Base>
