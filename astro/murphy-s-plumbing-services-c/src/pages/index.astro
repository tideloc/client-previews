---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroDrawing from '../components/HeroDrawing.astro';
import ScopeIndex from '../components/ScopeIndex.astro';
import PlantStage from '../components/PlantStage.astro';
import MaterialsLight from '../components/MaterialsLight.astro';
import WorkSpread from '../components/WorkSpread.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
