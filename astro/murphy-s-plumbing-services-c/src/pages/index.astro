---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Exploded from '../components/Exploded.astro';
import PriceList from '../components/tl/PriceList.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { alts } from '../lib/photos';
import { facts } from '../lib/facts';
import { base, pdfHref, abnUrl, licenceUrl, btnAccent, btnGhost, eyebrow, eyebrowMuted, email } from '../lib/links';
import hero from '../assets/gen-hero-excavator-navy.jpg';
import ex5 from '../assets/gen-col-excavator-5t.jpg';
import butt from '../assets/gen-butt-fusion-navy.jpg';
import ef from '../assets/gen-col-electrofusion.jpg';
import flange from '../assets/gen-col-flanged-joint.jpg';
import site from '../assets/project-site-wide.jpg';
import pipe from '../assets/weld-pe-pipe-trench.jpg';
import w1 from '../assets/project-circular-tank-risers.jpg';
import w2 from '../assets/dicl-pipe-crane-sling.jpg';
import w3 from '../assets/plant-kobelco-trench.jpg';
const heroCallouts = [
  { x: 14, y: 70, label: 'Bucket', sub: 'Deep trenching', side: 'below' },
  { x: 36, y: 25, label: 'Boom and dipper', side: 'above' },
  { x: 66, y: 32, label: 'Cab', sub: 'Our operator on wet hire, yours on dry', side: 'above' },
  { x: 83, y: 42, label: '22-tonne excavator', sub: 'Wet or dry hire', side: 'right' },
  { x: 72, y: 76, label: 'Undercarriage and tracks', side: 'below' },
];
const c5 = [
  { x: 76, y: 30, label: '5-tonne excavator', sub: 'Wet or dry hire', side: 'below' },
  { x: 31, y: 30, label: 'Boom and dipper', side: 'above' },
  { x: 30, y: 73, label: 'Bucket', side: 'below' },
  { x: 62, y: 20, label: 'Cab', sub: 'Our operator on wet hire, yours on dry', side: 'above' },
  { x: 73, y: 77, label: 'Undercarriage and tracks', side: 'below' },
];
const cButt = [
  { x: 10, y: 52, label: 'PE 100 pipe', side: 'below' },
  { x: 34, y: 30, label: 'Clamp carriage', side: 'above' },
  { x: 54, y: 48, label: 'Heater plate', side: 'below' },
  { x: 64, y: 28, label: 'Facing tool', side: 'above' },
  { x: 68, y: 74, label: 'Hydraulic unit', side: 'below' },
  { x: 90, y: 40, label: 'Butt welding', sub: 'Certified', side: 'above' },
];
const cef = [
  { x: 18, y: 18, label: 'PE 100 pipe', side: 'below' },
  { x: 42, y: 38, label: 'Electrofusion coupler', sub: 'Heating coil fuses pipe to coupler', side: 'below' },
  { x: 55, y: 26, label: 'Terminal pins', side: 'right' },
  { x: 64, y: 58, label: 'Alignment clamp', side: 'right' },
  { x: 90, y: 88, label: 'Electrofusion', sub: 'Certified', side: 'left' },
];
const cfl = [
  { x: 24, y: 39, label: 'DICL flanged pipe', side: 'below' },
  { x: 38, y: 44, label: 'Gasket', side: 'below' },
  { x: 50, y: 20, label: 'Gate valve', side: 'right' },
  { x: 27, y: 12, label: 'Bolts and nuts', side: 'right' },
  { x: 78, y: 62, label: 'Flanged spigot', side: 'below' },
];
const record = [
  ['Company', facts.legal],
  ['ABN', `${facts.abn}, registered ${facts.abnRegistered}`, abnUrl, 'Check on the ABN register'],
  ['Licence numbers', facts.licences.join(' and '), licenceUrl, 'NSW Fair Trading public register'],
  ['Certifications', facts.certs.join(', ')],
  ['Crew', facts.crew],
  ['Based', facts.base],
];
const work = [[site,'project-site-wide.jpg'],[w1,'project-circular-tank-risers.jpg'],[w2,'dicl-pipe-crane-sling.jpg'],[w3,'plant-kobelco-trench.jpg']];
---
<Base title="Civil plumbing contractor, Illawarra | Murphy's Plumbing Services" description="Illawarra civil plumbing contractor for builders. Licensed, PE 100 certified, own excavators for wet or dry hire. Water, sewer, stormwater and gas pipework.">
  <Header slot="header" />

  <section data-section="hero" aria-labelledby="hero-h1" class="relative bg-ground text-ink overflow-hidden">
    <div class="absolute inset-0 glow" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[96rem] px-5 lg:px-10 pt-28 lg:pt-36 pb-10 lg:pb-16">
      <div class="text-center max-w-4xl mx-auto">
        <p class={eyebrow}>Civil and industrial plumbing contractor, Illawarra</p>
        <h1 id="hero-h1" class="mt-5 font-display text-[2.5rem] leading-[1.02] sm:text-6xl lg:text-7xl">Large-scale civil pipework for water, sewage, stormwater and gas.</h1>
        <p class="mt-6 text-lg text-muted max-w-2xl mx-auto">Our own excavators, our own PE 100 welding, our own licensed crew. Based in the Illawarra, with recent Sydney Water infrastructure works.</p>
        <div class="mt-8 flex flex-wrap justify-center items-center gap-5">
          <a href={`${base}/contact/#enquiry`} class={btnAccent}>Send a project enquiry</a>
          <a href={pdfHref} class={btnGhost}>Capability statement (PDF)</a>
        </div>
      </div>
      <div class="mt-10 lg:mt-14 mx-auto max-w-6xl">
        <Exploded src={hero} eager alt="Exploded-view render of a teal 22-tonne tracked excavator on navy: bucket, boom and dipper, cab, engine house, slew ring and undercarriage separated" callouts={heroCallouts} sizes="(min-width: 1024px) 72rem, 100vw" />
      </div>
    </div>
    <dl class="relative border-t border-b rule bg-ground/60 backdrop-blur">
      <div class="mx-auto max-w-[96rem] px-5 lg:px-10 grid sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-line">
        <div class="py-5 lg:px-8 first:lg:pl-0"><dt class={eyebrowMuted}>Plant</dt><dd class="mt-1 font-display text-lg">22 t and 5 t excavators, wet or dry hire</dd></div>
        <div class="py-5 lg:px-8"><dt class={eyebrowMuted}>Certified</dt><dd class="mt-1 font-display text-lg">PE 100 installations, Electrofusion, Butt Welding</dd></div>
        <div class="py-5 lg:px-8"><dt class={eyebrowMuted}>Licence numbers</dt><dd class="mt-1 font-display text-lg">{facts.licences.join(' and ')}</dd></div>
        <div class="py-5 lg:px-8"><dt class={eyebrowMuted}>ABN</dt><dd class="mt-1 font-display text-lg">{facts.abn}</dd></div>
      </div>
    </dl>
  </section>

  <section data-section="pipework" aria-label="Civil pipework on site" class="bg-ground text-ink">
    <figure>
      <Picture src={pipe} widths={[768, 1200, 1800, 2400]} formats={['avif', 'webp']} sizes="100vw" loading="eager" alt={alts['weld-pe-pipe-trench.jpg']} pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] md:aspect-[21/9] object-cover object-[50%_45%]" />
      <figcaption class="mx-auto max-w-[96rem] px-5 lg:px-10 py-4 flex flex-wrap justify-between gap-3 text-sm border-b rule">
        <span class={eyebrow}>Civil pipework on site</span>
        <span class="text-muted">{alts['weld-pe-pipe-trench.jpg']}</span>
      </figcaption>
    </figure>
  </section>

  <section id="plant" data-section="plant" aria-labelledby="plant-h2" class="bg-ground text-ink">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class={eyebrow}>Plant, wet or dry hire</p>
        <h2 id="plant-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.02]">The machinery for all the civil plumbing works, large and small.</h2>
        <p class="mt-6 text-muted">Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire, giving us the capability to manage even the most demanding projects efficiently. The crew includes licensed plumbers, pipe layers and excavator operators, so the machine and the pipework come from the one contractor.</p>
        <div class="mt-8 border-t border-ink/30">
          <PriceList sectionClass="" titleClass="sr-only" itemClass="flex items-baseline justify-between gap-4 py-4 border-b rule" nameClass="font-display text-2xl [&>span]:hidden" priceClass="font-medium text-[11px] uppercase tracking-[0.2em] text-accent" noteClass="" />
        </div>
        <dl class="mt-6 grid sm:grid-cols-2 gap-6 text-sm">
          <div><dt class="font-display text-xl text-ink">Wet hire</dt><dd class="mt-1 text-muted">The machine comes with one of our operators. Our operators are part of the plumbing crew.</dd></div>
          <div><dt class="font-display text-xl text-ink">Dry hire</dt><dd class="mt-1 text-muted">The machine on its own, for your operator and your program.</dd></div>
        </dl>
      </div>
      <div class="lg:col-span-7">
        <Exploded src={ex5} alt="Exploded-view render of a teal 5-tonne mini excavator, parts separated" callouts={c5} sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
    </div>
  </section>

  <section id="welding" data-section="welding" aria-labelledby="weld-h2" class="bg-primary text-ink border-t rule">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-20 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class={eyebrow}>PE 100 welding</p>
          <h2 id="weld-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.02]">Butt welding and electrofusion, certified. Steel and DICL installations.</h2>
        </div>
        <p class="lg:col-span-4 text-muted">We adhere to the highest industry standards, with certifications in PE 100 installations, Electrofusion and Butt Welding. Our licensed team ensures that every project meets strict safety and quality requirements.</p>
      </div>
      <div class="mt-12">
        <p class={eyebrowMuted}>Butt fusion machine</p>
        <Exploded src={butt} alt="Exploded-view render of a hydraulic butt fusion welding machine on black PE 100 pipe: clamp carriage, heater plate, facing tool and hydraulic unit separated" callouts={cButt} class="mt-3" sizes="(min-width: 1024px) 90vw, 100vw" />
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <div>
          <p class={eyebrowMuted}>PE 100 electrofusion joint</p>
          <Exploded src={ef} alt="Exploded-view render of an electrofusion joint: black PE 100 pipe with blue stripes, coupler with copper heating coil, terminal pins and alignment clamp" callouts={cef} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
        <div>
          <p class={eyebrowMuted}>DICL flanged joint with gate valve</p>
          <Exploded src={flange} alt="Exploded-view render of a blue ductile iron flanged joint with a gate valve, gasket, bolts and nuts separated" callouts={cfl} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section id="capability" data-section="capability" aria-labelledby="cap-h2" class="bg-ground text-ink border-t rule">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-20 lg:py-28">
      <p class={eyebrow}>Capability</p>
      <h2 id="cap-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.02] max-w-4xl">Water, sewage, stormwater and gas. Deep trenching to treatment plant piping.</h2>
      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <ul class="lg:col-span-6 border-t border-ink/30">
          {facts.scopes.map((s) => <li class="py-4 border-b rule font-display text-3xl lg:text-4xl leading-none">{s}</li>)}
        </ul>
        <div class="lg:col-span-3">
          <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Materials</p>
          <ul>{facts.materials.map((m) => <li class="py-3 border-b rule text-muted">{m}</li>)}</ul>
        </div>
        <div class="lg:col-span-3">
          <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Installations and certifications</p>
          <ul>{facts.installs.map((m) => <li class="py-3 border-b rule text-muted">{m}</li>)}{facts.certs.map((c) => <li class="py-3 border-b rule text-muted flex justify-between gap-3"><span>{c}</span><span class="text-[11px] uppercase tracking-[0.2em] text-accent">certified</span></li>)}</ul>
          <p class="mt-6 text-sm text-muted">We provide specialised solutions for civil infrastructure, focusing on water, sewage, stormwater, and gas systems. From deep trenching and manhole installations to treatment plant piping, our expertise ensures every project is handled with precision and efficiency.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="registration" data-section="registration" aria-labelledby="reg-h2" class="bg-primary text-ink border-t rule">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class={eyebrow}>On the record</p>
        <h2 id="reg-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.02]">Registered, licensed, certified.</h2>
        <p class="mt-6 text-muted">The details a builder checks before engaging a subcontractor, with the public registers linked so you can verify them yourself.</p>
        <a href={pdfHref} class={`mt-8 ${btnGhost}`}>Capability statement (PDF)</a>
      </div>
      <table class="lg:col-span-7 w-full border-t border-ink/30 self-start table-fixed">
        <tbody>
          {record.map(([k, v, href, label]) => (
            <tr class="border-b rule align-baseline">
              <th scope="row" class="py-4 pr-4 text-left font-medium uppercase tracking-[0.2em] text-[11px] text-muted w-[34%]">{k}</th>
              <td class="py-4 break-words font-display text-lg">{v}{href && <a href={href} target="_blank" rel="noreferrer" class="block font-body text-sm text-accent underline underline-offset-4">{label}</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section data-section="work" aria-labelledby="work-h2" class="bg-ground text-ink border-t rule">
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-20 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class={eyebrow}>Recent work</p>
          <h2 id="work-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.02]">Sydney Water infrastructure works, and the civil plumbing jobs in between.</h2>
        </div>
        <a href={`${base}/projects/`} class={`lg:col-span-4 lg:justify-self-end ${btnGhost}`}>All project photographs</a>
      </div>
      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-3">
        {work.map(([src, f]) => (
          <figure>
            <Picture src={src} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 25vw, 50vw" alt={alts[f]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
            <figcaption class="mt-2 text-xs text-muted">{alts[f]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <EnquiryBand compact />
  <Footer slot="footer" />
</Base>
