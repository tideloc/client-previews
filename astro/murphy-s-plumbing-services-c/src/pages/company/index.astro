---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VerifyBand from '../../components/VerifyBand.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { alts } from '../../lib/photos';
import { facts } from '../../lib/facts';
import { pdfHref, abnUrl, licenceUrl, btnOutline, eyebrow } from '../../lib/links';
import lead1 from '../../assets/project-main-on-piers.jpg';
import lead2 from '../../assets/project-valve-assembly.jpg';
import b1 from '../../assets/project-wrapped-pipes.jpg';
import b2 from '../../assets/project-valves-pit-above.jpg';
import b3 from '../../assets/project-main-through-bush.jpg';
const docs = [
  ['Company', facts.legal],
  ['ABN', `${facts.abn}, registered ${facts.abnRegistered}`, abnUrl, 'Check on the ABN register'],
  ['Licence numbers', facts.licences.join(' and '), licenceUrl, 'Search the NSW Fair Trading register'],
  ['Certifications', facts.certs.join(', ')],
  ['Crew', facts.crew],
  ['Plant', facts.plant.map((p) => p.name).join(' and ') + ', wet or dry hire'],
  ['Based', facts.base],
  ['Email', 'info@murphysplumbingservices.com.au'],
];
---
<Base title="Company | Murphy's Plumbing Services" description="Murphy's Plumbing Services Pty Ltd, Illawarra civil plumbing contractor registered 2002: licence numbers, ABN, certifications, crew and plant on the record.">
  <Header slot="header" />
  <section data-section="company-lead" aria-labelledby="co-h1" class="bg-secondary">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 pt-14 lg:pt-20 pb-16 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class={eyebrow}>Company</p>
        <h1 id="co-h1" class="mt-4 font-display text-5xl lg:text-7xl leading-[1.02]">Industrial and civil plumbing, with the equipment to match.</h1>
        <p class="mt-6 text-ink/75">Murphy's Plumbing Services is a trusted name in industrial and civil plumbing, delivering reliable and high-quality solutions for complex infrastructure projects. With a skilled team of licensed plumbers, pipe layers, and excavator operators, we specialise in large-scale water, sewage, stormwater, and gas systems.</p>
        <p class="mt-4 text-ink/75">Our commitment to excellence is backed by years of experience and the equipment to match. From deep trenching to precise pipe installations, we take pride in tackling challenging projects with professionalism and precision.</p>
      </div>
      <div class="lg:col-span-6 grid grid-cols-5 gap-3">
        <Picture src={lead1} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 30vw, 60vw" loading="eager" alt={alts['project-main-on-piers.jpg']} pictureAttributes={{ class: 'col-span-3 block' }} class="w-full h-full aspect-[4/5] object-cover" />
        <Picture src={lead2} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 20vw, 40vw" loading="lazy" alt={alts['project-valve-assembly.jpg']} pictureAttributes={{ class: 'col-span-2 block self-end' }} class="w-full aspect-[4/5] object-cover" />
      </div>
    </div>
  </section>
  <VerifyBand />
  <section data-section="record" aria-labelledby="rc-h2" class="bg-ground">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class={eyebrow}>For your subcontractor register</p>
        <h2 id="rc-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">On the record.</h2>
        <p class="mt-5 text-ink/75">The company details a builder checks before engaging a subcontractor, with the public registers linked so you can verify them yourself.</p>
        <a href={pdfHref} class={`mt-6 ${btnOutline}`}>Capability statement (PDF)</a>
      </div>
      <table class="lg:col-span-7 w-full border-t border-ink self-start">
        <tbody>
          {docs.map(([k, v, href, label]) => (
            <tr class="border-b rule align-baseline">
              <th scope="row" class="py-3.5 pr-4 text-left font-medium uppercase tracking-[0.2em] text-[11px] text-ink/60 w-[32%]">{k}</th>
              <td class="py-3.5">{v}{href && <a href={href} target="_blank" rel="noreferrer" class="block text-sm underline underline-offset-4 text-ink/60 hover:text-ink">{label}</a>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section data-section="apart" aria-labelledby="ap-h2" class="bg-secondary border-t rule">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-20 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class={eyebrow}>What sets us apart</p>
        <h2 id="ap-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Diverse pipe materials, and our own excavators.</h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 text-ink/75 space-y-4 text-lg">
        <p>We stand out for our expertise in handling diverse pipe materials, including PE 100 polyethylene, Ductile Iron Cement Lines (DICL), stainless steel press fit, concrete, and PVC. This flexibility ensures we can adapt to the specific needs of every job, delivering durable and reliable results every time.</p>
        <p>Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire, giving us the capability to manage even the most demanding projects efficiently.</p>
      </div>
    </div>
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 pb-16 grid grid-cols-1 sm:grid-cols-3 gap-3">
      {[[b1,'project-wrapped-pipes.jpg'],[b2,'project-valves-pit-above.jpg'],[b3,'project-main-through-bush.jpg']].map(([src,f]) => (
        <Picture src={src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 640px) 33vw, 100vw" alt={alts[f]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
      ))}
    </div>
  </section>
  <EnquiryBand compact />
  <Footer slot="footer" />
</Base>
