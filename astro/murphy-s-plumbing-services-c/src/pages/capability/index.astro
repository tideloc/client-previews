---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CapabilityMatrix from '../../components/CapabilityMatrix.astro';
import Exploded from '../../components/Exploded.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { alts } from '../../lib/photos';
import { facts } from '../../lib/facts';
import { eyebrow, eyebrowDark } from '../../lib/links';
import ef from '../../assets/gen-col-electrofusion.jpg';
import flange from '../../assets/gen-col-flanged-joint.jpg';
import water from '../../assets/project-stainless-vertical.jpg';
import sewer from '../../assets/project-trench-pipe-shoring.jpg';
import storm from '../../assets/project-stormwater-pit.jpg';
import gas from '../../assets/project-pe-gravel-bedding.jpg';
import trench from '../../assets/project-trench-bedding.jpg';
import manhole from '../../assets/project-manhole-riser-worker.jpg';
import plant from '../../assets/project-stainless-plant.jpg';
import rig from '../../assets/weld-butt-rig-channel.jpg';
import vac from '../../assets/project-valves-pit-above.jpg';
const scopePhotos = [
  { n: 'Water supply', d: 'Water supply pipework and treatment plant piping', img: water, f: 'project-stainless-vertical.jpg' },
  { n: 'Sewage', d: 'Large-scale sewage pipework', img: sewer, f: 'project-trench-pipe-shoring.jpg' },
  { n: 'Stormwater', d: 'Stormwater systems', img: storm, f: 'project-stormwater-pit.jpg' },
  { n: 'Gas', d: 'Gas systems for civil infrastructure', img: gas, f: 'project-pe-gravel-bedding.jpg' },
  { n: 'Deep trenching', d: 'Precise trenching and navigation around existing services, with our own excavators', img: trench, f: 'project-trench-bedding.jpg' },
  { n: 'Manhole installations', d: 'Manhole installations on civil infrastructure projects', img: manhole, f: 'project-manhole-riser-worker.jpg' },
  { n: 'Treatment plant piping', d: 'Specialised piping inside treatment plants', img: plant, f: 'project-stainless-plant.jpg' },
];
const efCallouts = [
  { x: 18, y: 18, label: 'PE 100 pipe', side: 'below' },
  { x: 42, y: 38, label: 'Electrofusion coupler', sub: 'Heating coil fuses pipe to coupler', side: 'below' },
  { x: 55, y: 26, label: 'Terminal pins', side: 'right' },
  { x: 62, y: 61, label: 'Alignment clamp', side: 'below' },
  { x: 84, y: 78, label: 'Certified', sub: 'Electrofusion and Butt Welding', side: 'left' },
];
const flCallouts = [
  { x: 24, y: 39, label: 'DICL flanged pipe', side: 'below' },
  { x: 38, y: 44, label: 'Gasket', side: 'below' },
  { x: 50, y: 20, label: 'Gate valve', sub: 'Steel and DICL installations', side: 'right' },
  { x: 24, y: 24, label: 'Bolts and nuts', side: 'left' },
  { x: 78, y: 62, label: 'Flanged spigot', side: 'below' },
];
---
<Base title="Capability | Murphy's Plumbing Services" description="Civil plumbing capability for builders: water, sewer, stormwater and gas pipework, trenching, manholes and treatment plant piping in PE 100, DICL and more.">
  <Header slot="header" />
  <section data-section="capability-lead" aria-labelledby="cp-h1" class="bg-secondary">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 pt-14 lg:pt-20 pb-10 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>Capability</p>
        <h1 id="cp-h1" class="mt-4 font-display text-5xl lg:text-7xl leading-[1.02]">Civil and industrial plumbing for complex infrastructure projects.</h1>
      </div>
      <p class="lg:col-span-5 text-lg text-ink/75">We provide specialised solutions for civil infrastructure, focusing on water, sewage, stormwater, and gas systems. From deep trenching and manhole installations to treatment plant piping, our expertise ensures every project is handled with precision and efficiency.</p>
    </div>
  </section>
  <section data-section="scopes" aria-labelledby="sc-h2" class="bg-secondary">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 pb-16 lg:pb-24">
      <h2 id="sc-h2" class="sr-only">Scopes</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8">
        {scopePhotos.map((s) => (
          <figure>
            <Picture src={s.img} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 768px) 25vw, 50vw" alt={alts[s.f]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] object-cover" />
            <figcaption class="mt-3"><span class="block font-display text-2xl leading-tight">{s.n}</span><span class="block mt-1 text-sm text-ink/70">{s.d}</span></figcaption>
          </figure>
        ))}
        <figure>
          <Picture src={vac} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 768px) 25vw, 50vw" alt={alts['project-valves-pit-above.jpg']} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] object-cover" />
          <figcaption class="mt-3"><span class="block font-display text-2xl leading-tight">Vac operations</span><span class="block mt-1 text-sm text-ink/70">Certified</span></figcaption>
        </figure>
      </div>
    </div>
  </section>
  <CapabilityMatrix heading="Capability matrix" h2="Scopes, materials, installations and certifications in one table." />
  <section data-section="welding" id="welding" aria-labelledby="wd-h2" class="bg-ground">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class={eyebrow}>PE 100 welding and DICL</p>
          <h2 id="wd-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Electrofusion and butt welding, certified. Steel and DICL installations.</h2>
        </div>
        <p class="lg:col-span-5 text-ink/75">We adhere to the highest industry standards, with certifications in PE 100 installations, Electrofusion, Butt Welding, and Vac Operations. Our licensed team ensures that every project meets strict safety and quality requirements.</p>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <div class="bg-primary text-ground p-5 lg:p-8">
          <p class={eyebrowDark}>PE 100 electrofusion joint</p>
          <Exploded src={ef} alt="Exploded-view render of an electrofusion joint: black PE 100 pipe with blue stripes, coupler with copper heating coil, terminal pins and alignment clamp" callouts={efCallouts} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
        <div class="bg-primary text-ground p-5 lg:p-8">
          <p class={eyebrowDark}>DICL flanged joint with gate valve</p>
          <Exploded src={flange} alt="Exploded-view render of a blue ductile iron flanged joint with a gate valve, gasket, bolts and nuts separated" callouts={flCallouts} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
        </div>
      </div>
      <Picture src={rig} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="100vw" alt={alts['weld-butt-rig-channel.jpg']} loading="lazy" pictureAttributes={{ class: 'block mt-4' }} class="w-full aspect-[21/9] object-cover" />
      <p class="mt-2 text-sm text-ink/60">{alts['weld-butt-rig-channel.jpg']}</p>
    </div>
  </section>
  <EnquiryBand compact heading="Send the scope and the materials, and we will price it." />
  <Footer slot="footer" />
</Base>
