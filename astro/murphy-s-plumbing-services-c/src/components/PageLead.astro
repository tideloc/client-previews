---
/** Sub-page opener: eyebrow, h1, lead on the right. */
import { eyebrow } from '../lib/links';
const { kicker, title, lead } = Astro.props;
---
<section data-section="lead" class="bg-ground text-ink">
  <div class="mx-auto max-w-[96rem] px-5 lg:px-10 pt-28 lg:pt-36 pb-10 lg:pb-14 grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-8">
      <p class={eyebrow}>{kicker}</p>
      <h1 class="mt-4 font-display text-[2.4rem] leading-[1.02] sm:text-5xl lg:text-6xl xl:text-7xl">{title}</h1>
    </div>
    {lead && <p class="lg:col-span-4 text-lg text-muted">{lead}</p>}
  </div>
</section>
