---
import EnquiryForm from './EnquiryForm.astro';
import { email, enquiryHref, pdfHref, btnAccent, eyebrow } from '../lib/links';
const { heading = 'Ready to start your next infrastructure project?', compact = false } = Astro.props;
---
{compact ? (
  <section data-section="enquiry-cta" aria-labelledby="enq-h2" class="bg-primary text-ink border-t rule">
    <div class="mx-auto max-w-6xl px-5 lg:px-10 py-16 lg:py-20 flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-2xl">
        <p class={eyebrow}>Project enquiry</p>
        <h2 id="enq-h2" class="mt-3 font-display text-3xl lg:text-5xl leading-[1.05]">{heading}</h2>
      </div>
      <div class="flex flex-wrap items-center gap-6">
        <a href={enquiryHref} class={btnAccent}>Send a project enquiry</a>
        <a href={`mailto:${email}`} class="text-muted hover:text-accent break-all">{email}</a>
      </div>
    </div>
  </section>
) : (
  <section data-section="enquiry" id="enquiry" aria-labelledby="enq-h2" class="bg-primary text-ink border-t rule">
    <div class="mx-auto max-w-6xl px-5 lg:px-10 py-16 lg:py-24 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class={eyebrow}>Project enquiry</p>
        <h2 id="enq-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-[1.05]">{heading}</h2>
        <p class="mt-5 text-muted">We're ready to discuss your next project. Send through the scope, the materials and the program, or email us directly. Tender and estimating enquiries welcome.</p>
        <a href={`mailto:${email}`} class="mt-4 inline-block text-accent underline underline-offset-4 break-all">{email}</a>
        <p class="mt-6 text-sm text-muted">Need the facts in one page for a subcontractor register? <a href={pdfHref} class="underline underline-offset-4 text-ink hover:text-accent">Capability statement (PDF)</a>.</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <EnquiryForm kind="quote" site="Murphy's Plumbing Services" submitLabel="Send project enquiry"
          successText="Thanks, we have your enquiry and will come back to you by email."
          class="grid gap-5 sm:grid-cols-2"
          inputClass="w-full bg-transparent border-0 border-b border-ink/30 rounded-none px-0 py-2.5 text-ink focus-visible:outline-none focus-visible:border-accent"
          buttonClass="inline-flex items-center bg-accent text-ground font-medium tracking-[0.02em] px-6 py-3.5 hover:bg-ink transition-colors"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'company', label: 'Company or head contractor' },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'phone', label: 'Phone', type: 'tel' },
            { name: 'project', label: 'Project and location' },
            { name: 'program', label: 'Tender close or start date' },
            { name: 'scope', label: 'Scope, materials and plant needed', type: 'textarea', required: true },
          ]} />
      </div>
    </div>
  </section>
)}
<style is:global>
  [data-enquiry-form] > div:has(textarea), [data-enquiry-form] > div:last-child { grid-column: 1 / -1; }
  [data-enquiry-form] label { color: #8B95A1; font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 500; }
</style>
