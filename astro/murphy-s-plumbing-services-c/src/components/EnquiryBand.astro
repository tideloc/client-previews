---
import EnquiryForm from './EnquiryForm.astro';
import { email, enquiryHref, btnFilled, eyebrow } from '../lib/links';
const { heading = 'Ready to start your next infrastructure project?', compact = false, record = false } = Astro.props;
const register = [
  ['Company', "Murphy's Plumbing Services Pty Ltd"],
  ['ABN', '24 101 951 759, registered 1 October 2002'],
  ['Licence numbers', '521S and 142861C'],
  ['Based', 'Illawarra, NSW 2530'],
  ['Crew', 'Licensed plumbers, pipe layers and excavator operators'],
  ['Plant', '22-tonne and 5-tonne excavators, wet or dry hire'],
];
---
{compact ? (
  <section data-section="enquiry-cta" aria-labelledby="enq-h2" class="bg-primary text-ink border-t hairline">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-20 flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-2xl">
        <p class={eyebrow}>Project enquiry</p>
        <h2 id="enq-h2" class="mt-4 font-display font-light text-3xl lg:text-5xl leading-[1.05]">{heading}</h2>
      </div>
      <div class="flex flex-wrap items-center gap-6">
        <a href={enquiryHref} class={btnFilled}>Send a project enquiry</a>
        <a href={`mailto:${email}`} class="underline underline-offset-[6px] decoration-ink/40 hover:decoration-ink break-all">{email}</a>
      </div>
    </div>
  </section>
) : (
  <section data-section="enquiry" id="enquiry" aria-labelledby="enq-h2" class="bg-primary text-ink border-t hairline">
    <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-20 lg:py-28 grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class={eyebrow}>Project enquiry</p>
        <h2 id="enq-h2" class="mt-4 font-display font-light text-4xl lg:text-5xl leading-[1.05]">{heading}</h2>
        <p class="mt-6 text-accent">We're ready to discuss your next project. Send through the scope, the materials and the program, or email us directly.</p>
        <a href={`mailto:${email}`} class="mt-4 inline-block underline underline-offset-[6px] decoration-ink/40 hover:decoration-ink break-all">{email}</a>
        {record && (
          <table class="mt-10 w-full border-t hairline text-sm">
            <tbody>
              {register.map(([k, v]) => (
                <tr class="border-b hairline align-baseline">
                  <th scope="row" class="py-3 pr-4 text-left font-medium uppercase tracking-[0.2em] text-[11px] text-accent w-[38%]">{k}</th>
                  <td class="py-3">{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <EnquiryForm kind="quote" site="Murphy's Plumbing Services" submitLabel="Send project enquiry"
          successText="Thanks, we have your enquiry and will come back to you by email."
          class="grid gap-6 sm:grid-cols-2"
          inputClass="w-full bg-transparent border-0 border-b border-ink/30 rounded-none px-0 py-2.5 text-ink placeholder:text-accent/50 focus-visible:outline-none focus-visible:border-ink"
          buttonClass="inline-flex items-center bg-ink text-ground font-medium tracking-[0.02em] px-6 py-3.5 hover:bg-secondary transition-colors"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'company', label: 'Company' },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'phone', label: 'Phone', type: 'tel' },
            { name: 'location', label: 'Project location' },
            { name: 'program', label: 'Start date or program' },
            { name: 'scope', label: 'Scope, materials and plant needed', type: 'textarea', required: true },
          ]} />
      </div>
    </div>
  </section>
)}
<style>
  [data-enquiry-form] > div:has(textarea), [data-enquiry-form] > div:last-child { grid-column: 1 / -1; }
  [data-enquiry-form] label { color: #DCDCDC; font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 500; }
</style>
