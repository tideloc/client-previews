---
/** Chapter head: number, title, lead. Used identically for every chapter so the dossier reads as one document. */
import { eyebrow } from '../lib/links';
const { id, n, title, lead, class: cls = 'bg-ground' } = Astro.props;
---
<section id={id} data-section={id} aria-labelledby={`${id}-h2`} class={`${cls} border-t rule`}>
  <div class="px-5 lg:px-12 pt-12 lg:pt-16 pb-12 lg:pb-20">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class={eyebrow}>Chapter {n}</p>
        <h2 id={`${id}-h2`} class="mt-3 font-display text-4xl lg:text-5xl leading-tight">{title}</h2>
      </div>
      {lead && <p class="lg:col-span-4 text-ink/75">{lead}</p>}
    </div>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
