---
/** Services: photo plate first, then lead and the scope / material lists. `full` adds installations, certifications and a second photo. */
import { Picture } from 'astro:assets';
import { alts } from '../lib/photos';
import { facts } from '../lib/facts';
import { base, linkMore, eyebrow, eyebrowMuted } from '../lib/links';
import pipe from '../assets/weld-pe-pipe-trench.jpg';
import plant from '../assets/project-plant-pump-pipework.jpg';
const { full = false } = Astro.props;
---
<section id="services" data-section="services" aria-labelledby={full ? undefined : "sv-h2"} aria-label={full ? "Services" : undefined} class="bg-ground text-ink">
  <figure class="w-full">
    <Picture src={pipe} widths={[768, 1200, 1800, 2400]} formats={['avif', 'webp']} sizes="100vw" loading={full ? 'lazy' : 'eager'} alt={alts['weld-pe-pipe-trench.jpg']} pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] md:aspect-[21/9] object-cover object-[50%_45%]" />
  </figure>
  <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-14 lg:py-20">
    {!full && <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>Skills and services</p>
        <h2 id="sv-h2" class="mt-3 font-display text-3xl lg:text-5xl leading-[1.05]">Water, sewage, stormwater and gas pipework for infrastructure projects.</h2>
      </div>
      <p class="lg:col-span-5 text-muted">From deep trenching and manhole installations to treatment plant piping, in PE 100, DICL, steel, stainless and copper press fit, PVC and concrete. We provide specialised solutions for civil infrastructure, and our expertise ensures every project is handled with precision and efficiency.</p>
    </div>}
    <div class={`${full ? '' : 'mt-10'} grid gap-x-10 gap-y-8 md:grid-cols-2`}>
      <div>
        <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Scopes</p>
        <ul class="grid grid-cols-2 md:grid-cols-1 gap-x-6">{facts.scopes.map((s) => <li class="py-3 border-b rule font-display text-xl lg:text-2xl leading-tight">{s}</li>)}</ul>
      </div>
      <div>
        <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Materials</p>
        <ul class="grid grid-cols-2 md:grid-cols-1 gap-x-6">{facts.materials.map((m) => <li class="py-3 border-b rule text-muted">{m}</li>)}</ul>
      </div>
    </div>
    {full ? (
      <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-5">
          <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Installations</p>
          <ul>{facts.installs.map((m) => <li class="py-3 border-b rule">{m}</li>)}</ul>
          <p class={`mt-8 ${eyebrowMuted} border-b border-ink/30 pb-3`}>Certifications held</p>
          <ul>{facts.certs.map((c) => <li class="py-3 border-b rule flex justify-between gap-3"><span>{c}</span><span class="text-[11px] uppercase tracking-[0.2em] text-accent">certified</span></li>)}</ul>
          <p class="mt-6 text-sm text-muted">Murphy's Plumbing Services specialises in civil and industrial plumbing for complex infrastructure projects, delivering durable solutions tailored to every project, even in challenging environments requiring precise trenching and navigation around existing services.</p>
        </div>
        <Picture src={plant} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 55vw, 100vw" alt={alts['project-plant-pump-pipework.jpg']} loading="lazy" pictureAttributes={{ class: 'lg:col-span-7 block' }} class="w-full aspect-[4/3] object-cover" />
      </div>
    ) : (
      <a href={`${base}/services/`} class={`mt-8 ${linkMore}`}>All services, materials and certifications</a>
    )}
  </div>
</section>
