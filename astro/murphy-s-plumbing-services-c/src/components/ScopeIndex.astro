---
import { Picture } from 'astro:assets';
import a from '../assets/plant-kobelco-trench.jpg';
import b from '../assets/project-plant-pump-pipework.jpg';
import { alts } from '../lib/photos';
import { eyebrow } from '../lib/links';
const scopes = [
  ['Water supply', 'Water mains and treatment plant piping'],
  ['Sewage', ''],
  ['Stormwater', ''],
  ['Gas', ''],
  ['Deep trenching', 'Navigation around existing services, with our own excavators'],
  ['Manhole installations', ''],
  ['Treatment plant piping', ''],
  ['Vac operations', 'Certified'],
];
const materials = ['PE 100 polyethylene', 'Ductile Iron Cement Lined (DICL)', 'Steel', 'Stainless steel press fit', 'Copper press fit', 'PVC', 'Concrete'];
---
<section data-section="index" id="index" aria-labelledby="idx-h2" class="bg-ground text-ink border-t hairline">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-20 lg:py-28 grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class={eyebrow}>What we install</p>
      <h2 id="idx-h2" class="mt-4 font-display text-4xl lg:text-6xl leading-[1.05] max-w-2xl">Water, sewage, stormwater and gas. Deep trenching to treatment plant piping.</h2>
      <ol class="mt-12 border-t hairline">
        {scopes.map(([name, detail]) => (
          <li class="grid sm:grid-cols-[1fr_1fr] gap-x-8 gap-y-1 py-3.5 border-b hairline items-baseline">
            <h3 class="font-display text-2xl lg:text-3xl leading-none">{name}</h3>
            {detail && <p class="text-accent text-sm">{detail}</p>}
          </li>
        ))}
      </ol>
      <p class={`mt-10 ${eyebrow}`}>Materials we weld and install</p>
      <ul class="mt-3 flex flex-wrap gap-x-8 gap-y-2 font-display text-xl">
        {materials.map((m) => <li>{m}</li>)}
      </ul>
    </div>
    <div class="lg:col-span-4 lg:col-start-9">
      <div class="lg:sticky lg:top-8 grid gap-3">
        <Picture src={a} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 30vw, 100vw" alt={alts['plant-kobelco-trench.jpg']} loading="lazy"
          pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
        <Picture src={b} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 30vw, 100vw" alt={alts['project-plant-pump-pipework.jpg']} loading="lazy"
          pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] object-cover" />
        <p class="text-sm text-accent">Every project is handled with precision and efficiency, even in challenging environments requiring precise trenching and navigation around existing services.</p>
      </div>
    </div>
  </div>
</section>
