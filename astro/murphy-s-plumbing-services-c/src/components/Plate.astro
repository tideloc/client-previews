---
/** Full-bleed photo plate between chapters, with a caption line. */
import { Picture } from 'astro:assets';
import { alts } from '../lib/photos';
const { src, file, aspect = 'aspect-[21/9]', eager = false } = Astro.props;
---
<figure class="bg-secondary">
  <Picture src={src} widths={[768, 1200, 1800]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 75vw, 100vw" alt={alts[file]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} pictureAttributes={{ class: 'block' }} class={`w-full ${aspect} object-cover`} />
  <figcaption class="px-5 lg:px-12 py-2.5 text-xs text-ink/60 border-b rule">{alts[file]}</figcaption>
</figure>
