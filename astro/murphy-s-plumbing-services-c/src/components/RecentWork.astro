---
import { Picture } from 'astro:assets';
import a from '../assets/plant-kobelco-trench.jpg';
import b from '../assets/project-circular-tank-risers.jpg';
import c from '../assets/project-manhole-crane-sky.jpg';
import d from '../assets/project-plant-pump-pipework.jpg';
import e from '../assets/project-tank-wall-risers.jpg';
import f from '../assets/dicl-pipe-crane-sling.jpg';
import g from '../assets/weld-electrofusion-coupler.jpg';
import h from '../assets/project-above-ground-main-bush.jpg';
import { alts } from '../lib/photos';
import { facts } from '../lib/facts';
import { base, btnOutline, eyebrow } from '../lib/links';
const tiles = [
  { src: a, f: 'plant-kobelco-trench.jpg', cls: 'md:col-span-2 md:row-span-2', sizes: '(min-width: 768px) 50vw, 100vw' },
  { src: b, f: 'project-circular-tank-risers.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: c, f: 'project-manhole-crane-sky.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: d, f: 'project-plant-pump-pipework.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: e, f: 'project-tank-wall-risers.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: f, f: 'dicl-pipe-crane-sling.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: g, f: 'weld-electrofusion-coupler.jpg', cls: '', sizes: '(min-width: 768px) 25vw, 50vw' },
  { src: h, f: 'project-above-ground-main-bush.jpg', cls: 'md:col-span-2', sizes: '(min-width: 768px) 50vw, 100vw' },
];
---
<section data-section="work" aria-labelledby="work-h2" class="bg-secondary border-t rule">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>Recent work</p>
        <h2 id="work-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Sydney Water infrastructure works, and the civil plumbing jobs in between.</h2>
      </div>
      <p class="lg:col-span-5 text-ink/75">{facts.recent} Take a look at our work showcasing the scale and precision of our industrial and civil plumbing projects.</p>
    </div>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 auto-rows-fr">
      {tiles.map((t) => (
        <figure class={t.cls}>
          <Picture src={t.src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes={t.sizes} alt={alts[t.f]} loading="lazy" pictureAttributes={{ class: 'block h-full' }} class="w-full h-full object-cover aspect-[4/3]" />
        </figure>
      ))}
    </div>
    <a href={`${base}/projects/`} class={`mt-10 ${btnOutline}`}>See all projects</a>
  </div>
</section>
