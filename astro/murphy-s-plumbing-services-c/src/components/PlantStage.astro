---
import { Picture } from 'astro:assets';
import Exploded from './Exploded.astro';
import ex5 from '../assets/gen-col-excavator-5t.jpg';
import p1 from '../assets/plant-kobelco-elbow.jpg';
import p2 from '../assets/plant-kobelco-pit.jpg';
import { alts } from '../lib/photos';
import { base, btn, eyebrow } from '../lib/links';
const callouts = [
  { x: 62, y: 22, label: '5-tonne excavator', sub: 'Wet or dry hire', side: 'right' },
  { x: 31, y: 30, label: 'Boom and dipper', side: 'left' },
  { x: 30, y: 73, label: 'Bucket', side: 'left' },
  { x: 46, y: 81, label: 'Dozer blade', side: 'below' },
  { x: 73, y: 77, label: 'Rubber tracks', side: 'right' },
];
---
<section data-section="plant" aria-labelledby="plant-h2" class="bg-primary text-ink border-t hairline">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 lg:order-2">
        <Exploded src={ex5} alt="Exploded-view render of a teal 5-tonne mini excavator with dozer blade and rubber tracks, parts separated" callouts={callouts} sizes="(min-width: 1024px) 58vw, 100vw" />
      </div>
      <div class="lg:col-span-5 lg:order-1">
        <p class={eyebrow}>Our fleet, wet or dry hire</p>
        <h2 id="plant-h2" class="mt-4 font-display text-4xl lg:text-5xl leading-[1.05]">The machinery for all the civil plumbing works, large and small.</h2>
        <p class="mt-6 text-accent">Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire, giving us the capability to manage even the most demanding projects efficiently.</p>
        <p class="mt-3 text-accent">The crew includes licensed plumbers, pipe layers and excavator operators, so the machine and the pipework come from the one contractor.</p>
        <div class="mt-8 grid grid-cols-2 gap-3">
          <div class="border hairline p-5">
            <p class="font-display leading-none text-[4.5rem] lg:text-[6rem]">22<span class="text-[0.4em] ml-1">t</span></p>
            <p class={`mt-3 ${eyebrow}`}>Excavator, wet or dry hire</p>
          </div>
          <div class="border hairline p-5">
            <p class="font-display leading-none text-[4.5rem] lg:text-[6rem]">5<span class="text-[0.4em] ml-1">t</span></p>
            <p class={`mt-3 ${eyebrow}`}>Excavator, wet or dry hire</p>
          </div>
        </div>
        <a href={`${base}/plant-hire/`} class={`mt-8 ${btn}`}>Plant hire</a>
      </div>
    </div>
    <div class="mt-16 grid sm:grid-cols-2 gap-3">
      <Picture src={p1} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 640px) 50vw, 100vw" alt={alts['plant-kobelco-elbow.jpg']} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[5/4] object-cover" />
      <Picture src={p2} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 640px) 50vw, 100vw" alt={alts['plant-kobelco-pit.jpg']} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[5/4] object-cover" />
    </div>
  </div>
</section>
