---
/** Welding and jointing. Desktop: butt fusion render leads, heading after. Phone: heading first, then the render.
 *  Both cuts carry the jointing methods and equipment list. `full` adds the electrofusion and DICL renders and the rig photo. */
import { Picture } from 'astro:assets';
import Exploded from './Exploded.astro';
import { alts } from '../lib/photos';
import { facts } from '../lib/facts';
import { cButt, cEf, cFl } from '../lib/callouts';
import { base, linkMore, eyebrow, eyebrowMuted } from '../lib/links';
import butt from '../assets/gen-butt-fusion-navy.jpg';
import ef from '../assets/gen-col-electrofusion.jpg';
import flange from '../assets/gen-col-flanged-joint.jpg';
import rig from '../assets/weld-butt-rig-channel.jpg';
const { full = false } = Astro.props;
const methods = [
  { name: 'Butt welding', kit: 'Hydraulic butt fusion machine for PE 100 pipe', certified: true },
  { name: 'Electrofusion', kit: 'Electrofusion control unit and couplers for PE 100', certified: true },
  { name: 'Press fit', kit: 'Press tooling for stainless steel and copper', certified: false },
  { name: 'Flanged DICL and steel', kit: 'Bolted flanges, gaskets and valves', certified: false },
];
---
<section id="welding" data-section="welding" aria-labelledby={full ? undefined : "weld-h2"} aria-label={full ? "Welding and jointing" : undefined} class="bg-primary text-ink border-t rule flex flex-col">
  {!full && (
    <div class="order-1 md:order-2 mx-auto w-full max-w-[96rem] px-5 lg:px-10 pt-12 md:pt-14 lg:pt-20 pb-6 md:pb-0 grid gap-4 lg:gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class={eyebrow}>Welding and jointing</p>
        <h2 id="weld-h2" class="mt-3 font-display text-3xl lg:text-5xl leading-[1.05]">PE 100 butt welding and electrofusion, certified. Steel and DICL installations.</h2>
      </div>
      <p class="lg:col-span-4 text-muted">We adhere to the highest industry standards, with certifications in PE 100 installations, Electrofusion and Butt Welding. Our licensed team ensures that every project meets strict safety and quality requirements.</p>
    </div>
  )}
  <div class={`${full ? '' : 'order-2 md:order-1'} mx-auto w-full max-w-[96rem] px-5 lg:px-10 pt-8 md:pt-12 lg:pt-16`}>
    <p class={eyebrowMuted}>Butt fusion machine</p>
    <Exploded src={butt} alt="Exploded-view render of a hydraulic butt fusion welding machine on black PE 100 pipe: clamp carriage, heater plate, facing tool and hydraulic unit separated" callouts={cButt} class="mt-3" sizes="(min-width: 1024px) 90vw, 100vw" />
  </div>
  <div class={`order-3 mx-auto w-full max-w-[96rem] px-5 lg:px-10 ${full ? 'pt-12 lg:pt-16' : 'pt-10 md:pt-12'} pb-14 lg:pb-20`}>
    <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Jointing methods and equipment</p>
    <ul class="grid md:grid-cols-2 gap-x-10">
      {methods.map((m) => (
        <li class="py-3.5 border-b rule flex items-baseline justify-between gap-4">
          <span><span class="block font-display text-xl lg:text-2xl leading-tight">{m.name}</span><span class="block mt-0.5 text-sm text-muted">{m.kit}</span></span>
          {m.certified && <span class="shrink-0 text-[11px] uppercase tracking-[0.2em] text-accent">certified</span>}
        </li>
      ))}
    </ul>
    {!full && <a href={`${base}/welding/`} class={`mt-8 ${linkMore}`}>Welding and jointing in detail</a>}
    {full && (
      <div class="mt-14">
        <div class="grid gap-10 lg:grid-cols-2">
          <div>
            <p class={eyebrowMuted}>PE 100 electrofusion joint</p>
            <Exploded src={ef} alt="Exploded-view render of an electrofusion joint: black PE 100 pipe with blue stripes, coupler with copper heating coil, terminal pins and alignment clamp" callouts={cEf} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
          </div>
          <div>
            <p class={eyebrowMuted}>DICL flanged joint with gate valve</p>
            <Exploded src={flange} alt="Exploded-view render of a blue ductile iron flanged joint with a gate valve, gasket, bolts and nuts separated" callouts={cFl} class="mt-3" sizes="(min-width: 1024px) 45vw, 100vw" />
          </div>
        </div>
        <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class={`${eyebrowMuted} border-b border-ink/30 pb-3`}>Installations</p>
            <ul>{facts.installs.map((m) => <li class="py-3 border-b rule font-display text-xl">{m}</li>)}</ul>
            <p class={`mt-8 ${eyebrowMuted} border-b border-ink/30 pb-3`}>Certifications held</p>
            <ul>{facts.certs.map((c) => <li class="py-3 border-b rule flex justify-between gap-3"><span class="font-display text-xl">{c}</span><span class="text-[11px] uppercase tracking-[0.2em] text-accent">certified</span></li>)}</ul>
          </div>
          <Picture src={rig} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 55vw, 100vw" alt={alts['weld-butt-rig-channel.jpg']} loading="lazy" pictureAttributes={{ class: 'lg:col-span-7 block' }} class="w-full aspect-[4/3] object-cover" />
        </div>
      </div>
    )}
  </div>
</section>
