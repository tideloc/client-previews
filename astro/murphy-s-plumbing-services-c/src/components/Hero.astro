---
import { Picture } from 'astro:assets';
import hero from '../assets/project-site-wide.jpg';
import { alts } from '../lib/photos';
import { enquiryHref, pdfHref, btnPrimary, eyebrow } from '../lib/links';
---
<section data-section="hero" aria-labelledby="hero-h1" class="bg-secondary">
  <div class="grid lg:grid-cols-12">
    <div class="lg:col-span-5 px-5 lg:pl-10 lg:pr-12 pt-8 pb-10 lg:py-20 flex flex-col justify-center">
      <p class={eyebrow}>Civil and industrial plumbing contractor, Illawarra</p>
      <h1 id="hero-h1" class="mt-4 font-display text-[2.25rem] leading-[1.02] sm:text-5xl xl:text-6xl">Large-scale civil pipework for water, sewage, stormwater and gas.</h1>
      <p class="mt-5 text-base lg:text-lg text-ink/75 max-w-md">A licensed civil plumbing subcontractor with its own excavators, its own PE 100 welding and its own crew. Recent projects include Sydney Water infrastructure works.</p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a href={enquiryHref} class={btnPrimary}>Send a project enquiry</a>
        <a href={pdfHref} class="underline underline-offset-4 font-medium">Capability statement (PDF)</a>
      </div>
    </div>
    <div class="lg:col-span-7">
      <Picture src={hero} widths={[640, 1024, 1600, 2400]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 58vw, 100vw" loading="eager" fetchpriority="high"
        alt={alts['project-site-wide.jpg']} pictureAttributes={{ class: 'block h-full' }} class="w-full h-full aspect-[4/3] lg:aspect-auto lg:min-h-[640px] object-cover" />
    </div>
  </div>
</section>
