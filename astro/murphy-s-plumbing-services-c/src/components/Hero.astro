---
import SpecStrip from './SpecStrip.astro';
import { base, pdfHref, btnAccent, btnGhost, eyebrow } from '../lib/links';
---
<section data-section="hero" aria-labelledby="hero-h1" class="relative bg-ground text-ink overflow-hidden">
  <div class="absolute inset-0 glow pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto w-full max-w-[96rem] px-5 lg:px-10 pt-24 lg:pt-36 pb-10 lg:pb-14">
    <div class="text-center max-w-4xl mx-auto">
      <p class={eyebrow}>Civil and industrial plumbing contractor, Illawarra</p>
      <h1 id="hero-h1" class="mt-4 font-display text-[2.1rem] leading-[1.02] sm:text-6xl lg:text-7xl">Large-scale civil pipework for water, sewage, stormwater and gas.</h1>
      <p class="mt-5 text-base sm:text-lg text-muted max-w-2xl mx-auto">Highly experienced in all civil and industrial plumbing works. Our own excavators, our own PE 100 welding and our own licensed crew, based in the Illawarra.</p>
      <div class="mt-7 flex flex-wrap justify-center items-center gap-4 sm:gap-5">
        <a href={`${base}/contact/#enquiry`} class={btnAccent}>Send a project enquiry</a>
        <a href={pdfHref} class={btnGhost}>Capability statement (PDF)</a>
      </div>
    </div>
  </div>
  <SpecStrip />
</section>
