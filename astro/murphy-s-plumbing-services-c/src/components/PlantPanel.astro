---
/** Dark inset panel: the exploded 22 t render with callouts, the portal-editable plant list beside it. */
import Exploded from './Exploded.astro';
import PriceList from './tl/PriceList.astro';
import ex22 from '../assets/gen-col-excavator-22t.jpg';
import { base, btnOnDark, eyebrowDark } from '../lib/links';
const callouts = [
  { x: 65, y: 44, label: '22-tonne excavator', sub: 'Wet or dry hire', side: 'right' },
  { x: 56, y: 18, label: 'Cab', sub: 'Our operator on wet hire, yours on dry', side: 'right' },
  { x: 40, y: 22, label: 'Boom and dipper', side: 'above' },
  { x: 22, y: 60, label: 'Bucket', sub: 'Deep trenching', side: 'below' },
  { x: 70, y: 83, label: 'Undercarriage and tracks', side: 'below' },
];
---
<section data-section="plant" aria-labelledby="plant-h2" class="bg-ground">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
    <div class="bg-primary text-ground p-6 lg:p-12 grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <Exploded src={ex22} alt="Exploded-view render of a teal 22-tonne tracked excavator: bucket, boom and dipper, cab, engine house, slew ring and undercarriage separated" callouts={callouts} sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <p class={eyebrowDark}>Our own plant</p>
        <h2 id="plant-h2" class="mt-3 font-display text-3xl lg:text-4xl leading-tight">The machinery for all the civil plumbing works, large and small.</h2>
        <p class="mt-5 text-ground/80">Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire. The crew includes licensed plumbers, pipe layers and excavator operators, so the machine and the pipework come from the one contractor.</p>
        <div class="mt-6 border-t border-ground/40">
          <PriceList sectionClass="" titleClass="sr-only" itemClass="flex items-baseline justify-between gap-4 py-3 border-b border-ground/20" nameClass="font-display text-xl [&>span]:hidden" priceClass="font-medium text-[11px] uppercase tracking-[0.2em] text-ground/70" noteClass="" />
        </div>
        <a href={`${base}/plant-hire/`} class={`mt-6 ${btnOnDark}`}>Plant hire</a>
      </div>
    </div>
  </div>
</section>
