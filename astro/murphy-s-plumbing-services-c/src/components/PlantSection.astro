---
/** Plant and equipment: lead, hire strip, 22 t render. `full` adds the 5 t render and the plant photo grid. */
import { Picture } from 'astro:assets';
import Exploded from './Exploded.astro';
import PriceList from './tl/PriceList.astro';
import { alts } from '../lib/photos';
import { c22, c5 } from '../lib/callouts';
import { base, linkMore, eyebrow, eyebrowMuted } from '../lib/links';
import hero from '../assets/gen-hero-excavator-navy.jpg';
import ex5 from '../assets/gen-col-excavator-5t.jpg';
import g1 from '../assets/plant-excavation-three-pipes.jpg';
import g2 from '../assets/plant-kobelco-reinforced-pit.jpg';
import g3 from '../assets/plant-valve-lift.jpg';
import g4 from '../assets/plant-kobelco-fence.jpg';
import g5 from '../assets/plant-kobelco-elbow.jpg';
import g6 from '../assets/plant-kobelco-pit.jpg';
const { full = false } = Astro.props;
const photos = [[g1,'plant-excavation-three-pipes.jpg'],[g2,'plant-kobelco-reinforced-pit.jpg'],[g3,'plant-valve-lift.jpg'],[g4,'plant-kobelco-fence.jpg'],[g5,'plant-kobelco-elbow.jpg'],[g6,'plant-kobelco-pit.jpg']];
---
<section id="plant" data-section="plant" aria-labelledby={full ? undefined : "plant-h2"} aria-label={full ? "Plant and equipment" : undefined} class="bg-ground text-ink border-t rule">
  <div class="mx-auto max-w-[96rem] px-5 lg:px-10 pt-16 lg:pt-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        {!full && <p class={eyebrow}>Our own plant and equipment</p>}
        {!full && <h2 id="plant-h2" class="mt-3 font-display text-3xl lg:text-5xl leading-[1.05]">The machinery for all the civil plumbing works, large and small.</h2>}
        <p class={`${full ? 'text-lg' : 'mt-5'} text-muted`}>Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire, giving us the capability to manage even the most demanding projects efficiently.</p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="border-t border-ink/30">
          <PriceList sectionClass="" titleClass="sr-only" itemClass="flex items-baseline justify-between gap-4 py-3.5 border-b rule" nameClass="font-display text-xl [&>span]:hidden" priceClass="font-medium text-[11px] uppercase tracking-[0.2em] text-accent" noteClass="" />
        </div>
        <dl class="mt-5 grid sm:grid-cols-2 gap-6 text-sm">
          <div><dt class="font-display text-lg text-ink">Wet hire</dt><dd class="mt-1 text-muted">The machine comes with one of our operators. Our operators are part of the plumbing crew.</dd></div>
          <div><dt class="font-display text-lg text-ink">Dry hire</dt><dd class="mt-1 text-muted">The machine on its own, for your operator and your program.</dd></div>
        </dl>
      </div>
    </div>
    <div class="mt-12 mx-auto max-w-6xl">
      <p class={`${eyebrowMuted} text-center`}>22-tonne excavator, wet or dry hire</p>
      <Exploded src={hero} alt="Exploded-view render of a teal 22-tonne tracked excavator on navy: bucket, boom and dipper, cab, slew ring and undercarriage separated" callouts={c22} class="mt-4" sizes="(min-width: 1024px) 72rem, 100vw" />
    </div>
    {!full && <div class="pb-16 lg:pb-24"><a href={`${base}/plant/`} class={`mt-10 ${linkMore}`}>Plant and equipment in detail</a></div>}
  </div>
  {full && (
    <div class="mx-auto max-w-[96rem] px-5 lg:px-10 pt-16 pb-16 lg:pb-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <p class={eyebrowMuted}>5-tonne excavator, wet or dry hire</p>
          <h3 class="mt-3 font-display text-3xl lg:text-4xl leading-[1.05]">The smaller machine for tight sites and smaller jobs.</h3>
        </div>
        <div class="lg:col-span-7">
          <Exploded src={ex5} alt="Exploded-view render of a teal 5-tonne mini excavator, parts separated" callouts={c5} sizes="(min-width: 1024px) 55vw, 100vw" />
        </div>
      </div>
      <h3 class="mt-16 font-display text-3xl lg:text-4xl">The excavators at work</h3>
      <div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-3">
        {photos.map(([src, f]) => <Picture src={src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 33vw, 50vw" alt={alts[f]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />)}
      </div>
    </div>
  )}
</section>
