---
/** Fixed strip shown on concept previews only. Remove when the site goes live for the client.
 *  This is the only place the plan price line is allowed.
 *  REASONS: per-build "why you'd switch" bullets from research.md — real, specific, no invented claims. */
const bookUrl = 'https://cal.com/blake-tideloc/discovery';
const quoteUrl = 'https://tideloc.com.au/questionnaire';
interface Props { reasons?: string[] }
const { reasons = [] } = Astro.props;
---
<div data-tideloc-bar class="fixed bottom-0 inset-x-0 z-40 print:hidden">
  {reasons.length > 0 && (
    <div id="tl-why" hidden class="bg-ink/95 text-ground border-b border-ground/20">
      <div class="mx-auto max-w-4xl px-4 py-4">
        <p class="text-sm font-semibold mb-2">Why this beats the current site</p>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-1.5 text-sm text-ground/90 list-disc pl-4">
          {reasons.map((r) => <li>{r}</li>)}
        </ul>
        <p class="mt-3 text-xs text-ground/70">If the site has a shop, it runs on your own Shopify account: you manage products, prices and stock, with Tideloc support a message away.</p>
      </div>
    </div>
  )}
  <div class="bg-ink text-ground text-sm flex flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-2">
    <span>Free mock-up by Tideloc. Like the direction?</span>
    {reasons.length > 0 && (
      <button type="button" class="underline underline-offset-2 font-semibold" onclick="var w=document.getElementById('tl-why');w.hidden=!w.hidden;">Why switch?</button>
    )}
    <a href={quoteUrl} class="underline underline-offset-2">Get a real quote</a>
    <a href={bookUrl} class="font-semibold underline underline-offset-2">Book a 15-min call</a>
    <span class="hidden sm:inline opacity-70">Sites from $59 a month</span>
  </div>
</div>
