---
/** Credentials: a full-width table band with the register links. `full` adds the company prose and the capability statement panel. */
import { facts } from '../lib/facts';
import { pdfHref, abnUrl, licenceUrl, btnGhost, eyebrow, eyebrowMuted } from '../lib/links';
const { full = false } = Astro.props;
const record = [
  ['Company', facts.legal],
  ['ABN', `${facts.abn}, registered ${facts.abnRegistered}`, abnUrl, 'Check on the ABN register'],
  ['Licence numbers', facts.licences.join(' and '), licenceUrl, 'NSW Fair Trading public register'],
  ['Certifications', facts.certs.join(', ')],
  ['Crew', facts.crew],
  ['Plant', '22-tonne and 5-tonne excavators, wet or dry hire'],
  ['Based', facts.base],
];
---
<section id="credentials" data-section="credentials" aria-labelledby={full ? undefined : "cr-h2"} aria-label={full ? "On the record" : undefined} class="bg-primary text-ink border-t rule">
  <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-14 lg:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class={eyebrow}>On the record</p>
        {full ? <h2 id="cr-h2" class="mt-3 font-display text-2xl lg:text-3xl leading-[1.05]">The company, on the public registers.</h2> : <h2 id="cr-h2" class="mt-3 font-display text-3xl lg:text-5xl leading-[1.05]">Registered, licensed, certified.</h2>}
      </div>
      {!full && <a href={pdfHref} class={btnGhost}>Capability statement (PDF)</a>}
    </div>
    <table class="mt-10 w-full border-t border-ink/30 table-fixed">
      <tbody>
        {record.map(([k, v, href, label]) => (
          <tr class="border-b rule align-baseline">
            <th scope="row" class="py-4 pr-4 text-left font-medium uppercase tracking-[0.2em] text-[11px] text-muted w-[34%] lg:w-[22%]">{k}</th>
            <td class="py-4 break-words font-display text-lg">{v}{href && <a href={href} target="_blank" rel="noreferrer" class="block sm:inline sm:ml-4 font-body text-sm text-accent underline underline-offset-4">{label}</a>}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {full && (
      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7 text-muted space-y-4">
          <p>Murphy's Plumbing Services is a trusted name in industrial and civil plumbing, delivering reliable and high-quality solutions for complex infrastructure projects. With a skilled team of licensed plumbers, pipe layers, and excavator operators, we specialise in large-scale water, sewage, stormwater, and gas systems.</p>
          <p>Our commitment to excellence is backed by years of experience and the equipment to match. From deep trenching to precise pipe installations, we take pride in tackling challenging projects with professionalism and precision.</p>
          <p>The public registers are linked above so you can verify the company yourself before engaging us. The crew includes licensed plumbers, pipe layers and excavator operators, so the pipework and the plant come from a single licensed contractor.</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 border rule p-6">
          <p class={eyebrowMuted}>Capability statement</p>
          <p class="mt-2 text-muted">Two A4 pages with the same facts as this site, for your subcontractor register.</p>
          <a href={pdfHref} class={`mt-5 ${btnGhost}`}>Capability statement (PDF)</a>
        </div>
      </div>
    )}
  </div>
</section>
