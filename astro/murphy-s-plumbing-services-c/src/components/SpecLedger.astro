---
/** Designed data object: a full-width hairline ledger under the hero. Plant lines come from site.json priceList (portal-editable); certifications from the site. */
import PriceList from './tl/PriceList.astro';
const certs = ['PE 100 installations', 'Electrofusion', 'Butt Welding', 'Vac Operations'];
---
<div class="border-t border-b hairline bg-ground text-ink">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 grid lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-ink/20">
    <div class="lg:col-span-5 py-5 lg:pr-8">
      <p class="font-medium uppercase tracking-[0.28em] text-[11px] text-accent">Plant for hire</p>
      <PriceList sectionClass="mt-2" titleClass="sr-only" itemClass="flex items-baseline justify-between gap-4 py-1.5" nameClass="font-display font-light text-2xl leading-none [&>span]:hidden" priceClass="font-medium text-[11px] uppercase tracking-[0.2em] text-accent" noteClass="" />
    </div>
    <div class="lg:col-span-5 py-5 lg:px-8">
      <p class="font-medium uppercase tracking-[0.28em] text-[11px] text-accent">Certified</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1 font-display text-xl">
        {certs.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div class="lg:col-span-2 py-5 lg:pl-8">
      <p class="font-medium uppercase tracking-[0.28em] text-[11px] text-accent">Based</p>
      <p class="mt-2 font-display text-xl">Illawarra, NSW 2530</p>
      <p class="mt-1 text-sm text-accent">Sydney Water infrastructure works</p>
    </div>
  </div>
</div>
