---
import { Picture } from 'astro:assets';
import a from '../assets/project-site-wide.jpg';
import b from '../assets/project-circular-tank-risers.jpg';
import c from '../assets/project-manhole-crane-sky.jpg';
import d from '../assets/project-above-ground-main-bush.jpg';
import e from '../assets/project-tank-wall-risers.jpg';
import f from '../assets/dicl-pipe-crane-sling.jpg';
import { alts } from '../lib/photos';
import { base, btn, eyebrow } from '../lib/links';
const big = [{ src: a, file: 'project-site-wide.jpg' }, { src: b, file: 'project-circular-tank-risers.jpg' }];
const small = [{ src: c, file: 'project-manhole-crane-sky.jpg' }, { src: d, file: 'project-above-ground-main-bush.jpg' }, { src: e, file: 'project-tank-wall-risers.jpg' }, { src: f, file: 'dicl-pipe-crane-sling.jpg' }];
---
<section data-section="work" aria-labelledby="work-h2" class="bg-ground text-ink border-t hairline">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-20 lg:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class={eyebrow}>Recent work</p>
        <h2 id="work-h2" class="mt-4 font-display font-light text-4xl lg:text-6xl leading-[1.05]">Sydney Water infrastructure works, and the small to medium civil plumbing jobs in between.</h2>
      </div>
      <p class="lg:col-span-4 text-accent">Take a look at our work showcasing the scale and precision of our industrial and civil plumbing projects. These images demonstrate the expertise, materials, and techniques we apply.</p>
    </div>
    <div class="mt-12 grid gap-4 lg:grid-cols-12">
      {big.map((p, i) => (
        <figure class={`reveal ${i === 0 ? 'lg:col-span-7' : 'lg:col-span-5'}`}>
          <Picture src={p.src} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 55vw, 100vw" alt={alts[p.file]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/3] object-cover" />
          <figcaption class="mt-2 font-medium uppercase tracking-[0.2em] text-[11px] text-accent">{alts[p.file]}</figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-4">
      {small.map((p) => (
        <figure class="reveal">
          <Picture src={p.src} widths={[480, 800]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 25vw, 50vw" alt={alts[p.file]} loading="lazy" pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
          <figcaption class="mt-2 font-medium uppercase tracking-[0.2em] text-[11px] text-accent">{alts[p.file]}</figcaption>
        </figure>
      ))}
    </div>
    <a href={`${base}/projects/`} class={`mt-12 ${btn}`}>See all projects</a>
  </div>
</section>
