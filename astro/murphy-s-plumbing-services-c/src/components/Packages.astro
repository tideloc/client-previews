---
/** How a builder engages the business: three packages, each built from the inventory's scopes, certifications and plant. */
import { facts } from '../lib/facts';
import { base, eyebrow } from '../lib/links';
const links = [`${base}/capability/`, `${base}/capability/#welding`, `${base}/plant-hire/`];
---
<section data-section="packages" aria-labelledby="pk-h2" class="bg-ground">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class={eyebrow}>For builders and head contractors</p>
        <h2 id="pk-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Three ways to put us on your program.</h2>
      </div>
      <p class="lg:col-span-5 text-ink/75">Murphy's Plumbing Services specialises in civil and industrial plumbing for complex infrastructure projects, delivering durable solutions tailored to every project, even in challenging environments requiring precise trenching and navigation around existing services.</p>
    </div>
    <ol class="mt-10 border-t border-ink">
      {facts.packages.map((p, i) => (
        <li class="grid gap-4 md:grid-cols-12 py-7 border-b rule md:items-start">
          <h3 class="md:col-span-4 font-display text-3xl leading-tight"><a href={links[i]} class="hover:underline underline-offset-4">{p.name}</a></h3>
          <p class="md:col-span-5 text-ink/80">{p.what}</p>
          <p class="md:col-span-3 text-sm text-ink/60">{p.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
