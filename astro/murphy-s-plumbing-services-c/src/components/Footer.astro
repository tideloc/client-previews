---
import { base, nav, pdfHref, abnUrl, licenceUrl } from '../lib/links';
import { facts } from '../lib/facts';
const year = new Date().getFullYear();
---
<footer class="bg-ground border-t border-ink">
  <div class="px-5 lg:px-12 py-10 grid gap-8 md:grid-cols-12 text-sm">
    <div class="md:col-span-5">
      <p class="font-display uppercase tracking-[0.22em] text-[12px]">Murphys Plumbing Services</p>
      <p class="mt-3 text-ink/70 max-w-sm">Specialising in large-scale pipework for water, sewage, storm water, and gas projects. Based in the Illawarra (NSW 2530). Recent projects include Sydney Water infrastructure works.</p>
    </div>
    <div class="md:col-span-3">
      <ul class="space-y-1">
        <li><a href={`${base}/`} class="hover:underline">Dossier</a></li>
        {nav.slice(1).map((n) => <li><a href={n.href} class="hover:underline">{n.label}</a></li>)}
        <li><a href={pdfHref} class="hover:underline">Capability statement (PDF)</a></li>
        <li><a href="mailto:info@murphysplumbingservices.com.au" class="hover:underline break-all">info@murphysplumbingservices.com.au</a></li>
      </ul>
    </div>
    <div class="md:col-span-4 text-ink/70">
      <p>{facts.legal}</p>
      <p>ABN {facts.abn} <a href={abnUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4">check</a></p>
      <p>Licence {facts.licences[0]}, Licence {facts.licences[1]} <a href={licenceUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4">NSW register</a></p>
      <p class="mt-3">&copy; {year} {facts.legal}</p>
    </div>
  </div>
</footer>
