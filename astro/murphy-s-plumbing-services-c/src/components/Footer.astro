---
import { base, nav, pdfHref, abnUrl, licenceUrl, email } from '../lib/links';
import { facts } from '../lib/facts';
const year = new Date().getFullYear();
---
<footer class="bg-ground text-ink border-t rule">
  <div class="mx-auto max-w-[96rem] px-5 lg:px-10 py-12 grid gap-8 md:grid-cols-12 text-sm">
    <div class="md:col-span-5">
      <p class="font-display uppercase tracking-[0.26em] text-[12px]">Murphys Plumbing Services</p>
      <p class="mt-3 text-muted max-w-sm">Specialising in large-scale pipework for water, sewage, storm water, and gas projects. Based in the Illawarra (NSW 2530). Recent projects include Sydney Water infrastructure works.</p>
    </div>
    <div class="md:col-span-3">
      <ul class="space-y-1">
        {nav.map((n) => <li><a href={n.href} class="text-muted hover:text-accent">{n.label}</a></li>)}
        <li><a href={pdfHref} class="text-muted hover:text-accent">Capability statement (PDF)</a></li>
        <li><a href={`mailto:${email}`} class="text-muted hover:text-accent break-all">{email}</a></li>
      </ul>
    </div>
    <div class="md:col-span-4 text-muted">
      <p>{facts.legal}</p>
      <p>ABN {facts.abn} <a href={abnUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-accent">check</a></p>
      <p>Licence {facts.licences[0]}, Licence {facts.licences[1]} <a href={licenceUrl} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-accent">NSW register</a></p>
      <p class="mt-3">&copy; {year} {facts.legal}</p>
    </div>
  </div>
</footer>
