---
/** The legitimacy check, in one band: company, ABN, licences, certifications, with the public registers linked. */
import { facts } from '../lib/facts';
import { abnUrl, licenceUrl, eyebrowDark } from '../lib/links';
const cells = [
  { k: 'Company', v: facts.legal, s: `ABN registered ${facts.abnRegistered}` },
  { k: 'ABN', v: facts.abn, s: 'Check on the ABN register', href: abnUrl },
  { k: 'Licence numbers', v: facts.licences.join(' and '), s: 'NSW Fair Trading public register', href: licenceUrl },
  { k: 'Certified', v: 'PE 100, Electrofusion, Butt Welding, Vac Operations', s: 'PE 100 welding and non-destructive excavation' },
  { k: 'Based', v: facts.base, s: 'Sydney Water infrastructure works' },
];
---
<section data-section="verify" aria-label="Registration and certifications" class="bg-primary text-ground">
  <dl class="mx-auto max-w-[88rem] px-5 lg:px-10 grid sm:grid-cols-2 lg:grid-cols-5 divide-y sm:divide-y-0 divide-ground/15 lg:divide-x">
    {cells.map((c) => (
      <div class="py-6 lg:px-6 first:lg:pl-0 last:lg:pr-0">
        <dt class={eyebrowDark}>{c.k}</dt>
        <dd class="mt-2 font-display text-base lg:text-[17px] leading-snug">{c.v}</dd>
        <dd class="mt-1 text-sm text-ground/60">{c.href ? <a href={c.href} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-ground">{c.s}</a> : c.s}</dd>
      </div>
    ))}
  </dl>
</section>
