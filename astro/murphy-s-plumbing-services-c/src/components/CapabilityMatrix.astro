---
/** Scopes down, materials across. A tick means the material appears in the business's own material list; the source does not pair materials to scopes, so every row shows the full list. */
import { facts } from '../lib/facts';
import { eyebrow } from '../lib/links';
const { heading = 'Capability', h2 = 'Every scope, every material.' } = Astro.props;
---
<section data-section="capability" id="capability" aria-labelledby="cap-h2" class="bg-secondary border-t rule">
  <div class="mx-auto max-w-[88rem] px-5 lg:px-10 py-16 lg:py-24">
    <p class={eyebrow}>{heading}</p>
    <h2 id="cap-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight max-w-3xl">{h2}</h2>
    <div class="mt-10 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-medium uppercase tracking-[0.22em] text-[11px] text-ink/60 border-b border-ink pb-3">Scopes</p>
        <ul>
          {facts.scopes.map((s) => <li class="py-3.5 border-b rule font-display text-2xl">{s}</li>)}
          <li class="py-3.5 border-b rule font-display text-2xl">Vac operations <span class="font-body text-sm text-ink/60">certified</span></li>
        </ul>
      </div>
      <div class="lg:col-span-3">
        <p class="font-medium uppercase tracking-[0.22em] text-[11px] text-ink/60 border-b border-ink pb-3">Materials</p>
        <ul>
          {facts.materials.map((m) => <li class="py-3.5 border-b rule text-lg">{m}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-4">
        <p class="font-medium uppercase tracking-[0.22em] text-[11px] text-ink/60 border-b border-ink pb-3">Installations and certifications</p>
        <ul>
          {facts.installs.map((m) => <li class="py-3.5 border-b rule text-lg">{m}</li>)}
          {facts.certs.map((c) => <li class="py-3.5 border-b rule text-lg flex justify-between gap-4"><span>{c}</span><span class="text-sm text-ink/60">certified</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
