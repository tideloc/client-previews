---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import BookSection from '../../components/BookSection.astro';
import { conditionGroups } from '../../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
// Breadcrumb only. Every condition name stays in the page HTML inside the panels, which is what
// the terms are here for; a <details> panel is indexed the same as any other collapsed content.
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Conditions treated', item: `${site}${Astro.url.pathname}` },
  ],
};
---
<Base title="Conditions treated in Dover Heights | CK Physio" description="Coryn treats arthritis, joint replacements, balance, neurological, chronic pain, back, neck and sport injuries on land and in water, in Dover Heights.">
  <Header slot="header" />
  <PageIntro label="Conditions treated" title="We are spoilt for choice with treatment options" lead="We use evidence-based practice to treat and manage numerous conditions effectively, using land-based and/or water exercises and stretches. You do not need to know how to swim to have aquatic physiotherapy." />

  <section data-section="conditions" class="wrap py-8 md:py-16">
    <p class="max-w-2xl">Open a group to see the conditions in it and how Coryn treats them.</p>

    <div class="mt-6 md:mt-8 rounded-xl border border-panel bg-white overflow-hidden divide-y divide-panel">
      {conditionGroups.map((g, i) => (
        <details id={g.id} name="conditions" open={i === 0} class="group scroll-mt-24">
          <summary class="flex items-center gap-4 cursor-pointer list-none select-none px-5 py-4 md:px-6 md:py-5 min-h-[60px] hover:bg-tint/30 group-open:bg-tint/30 transition-colors [&::-webkit-details-marker]:hidden">
            <span class="shrink-0 h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
            <h2 class="text-[17px] md:text-lg leading-snug group-open:text-primary">{g.name}</h2>
            <svg class="ml-auto shrink-0 text-primary transition-transform group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="px-5 pb-6 md:px-6 md:pb-8 pt-1">
            <p class="max-w-3xl md:pl-[26px]">{g.text}</p>
            <ul class="mt-5 md:pl-[26px] flex flex-wrap gap-2">
              {g.items.map((it) => <li class="rounded-full bg-ground border border-panel px-3.5 py-1.5 text-[15px] leading-snug">{it}</li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>

    <p class="mt-8">Not sure which group you are in? <a href={`${base}/contact/`} class="font-bold text-primary underline underline-offset-4">Send Coryn a message</a> or read about <a href={`${base}/treatments/#programs`} class="font-bold text-primary underline underline-offset-4">how each session is put together</a>.</p>
  </section>

  <BookSection />
  <Footer slot="footer" />
  <script is:inline>
    // A link like /conditions/#chronic-pain must land on an open panel, not a closed one.
    (function () {
      function openFromHash() {
        var id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        var el = document.getElementById(id);
        if (el && el.tagName === 'DETAILS' && !el.open) {
          el.open = true;
          el.scrollIntoView({ block: 'start' });
        }
      }
      openFromHash();
      window.addEventListener('hashchange', openFromHash);
    })();
  </script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)}></script>
</Base>
