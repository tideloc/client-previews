---
import { poolSpec } from '../data/content';
const { class: cls = '' } = Astro.props;
---
<dl class={`grid grid-cols-2 md:grid-cols-3 gap-px bg-panel border border-panel ${cls}`}>
  {poolSpec.map((s) => (
    <div class="bg-white p-5 md:p-6">
      <dt class="font-display font-extrabold text-accent text-2xl md:text-[28px] leading-none">{s.value}</dt>
      <dd class="mt-2 text-[15px] text-body">{s.label}</dd>
    </div>
  ))}
</dl>
