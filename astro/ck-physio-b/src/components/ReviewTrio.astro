---
import { testimonials } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const picks = [testimonials[7], testimonials[5], testimonials[1]];
---
<section class="bg-white border-y border-panel">
  <div class="wrap py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl md:text-4xl">What clients say</h2>
      <p class="text-ink font-bold"><span class="text-accent" aria-hidden="true">★★★★★</span> 5.0 on Google from 17 reviews</p>
    </div>
    <div class="mt-10 grid md:grid-cols-3 gap-8">
      {picks.map((t) => (
        <blockquote class="border-l-4 border-accent pl-5">
          <p class="text-[16px] leading-relaxed">“{t.text}”</p>
          <footer class="mt-4"><cite class="not-italic font-bold text-ink">{t.name}</cite><span class="block text-sm text-body/80">{t.condition}</span></footer>
        </blockquote>
      ))}
    </div>
    <a href={`${base}/testimonials/`} class="mt-8 inline-block font-bold text-primary underline underline-offset-4">Read all eight testimonials</a>
  </div>
</section>
