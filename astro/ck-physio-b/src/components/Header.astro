---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { siteContent } from '../lib/site';
import { BOOKING_URL } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/aquatic-physiotherapy/`, label: 'Aquatic physio' },
  { href: `${base}/watsu/`, label: 'WATSU' },
  { href: `${base}/conditions/`, label: 'Conditions' },
  { href: `${base}/about/`, label: 'About Coryn' },
  { href: `${base}/testimonials/`, label: 'Testimonials' },
  { href: `${base}/contact/`, label: 'Facility and contact' },
];
const phone = siteContent.contact.phone;
const tel = 'tel:+61' + phone.replace(/\D/g, '').replace(/^0/, '');
const here = Astro.url.pathname.replace(/\/$/, '');
---
<header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-panel">
  <div class="wrap h-[72px] flex items-center gap-6">
    <a href={`${base}/`} class="shrink-0" aria-label="CK Physiotherapy & Aquatherapy home">
      <Image src={logo} alt="CK Physiotherapy" width="240" height="45" class="h-9 w-auto" loading="eager" />
    </a>
    <nav aria-label="Main" class="hidden lg:flex items-center gap-5 ml-auto text-[15px] font-medium text-ink whitespace-nowrap">
      {links.map((l) => (<a href={l.href} aria-current={here === l.href.replace(/\/$/, '') ? 'page' : undefined} class="hover:text-primary aria-[current]:text-primary aria-[current]:underline underline-offset-4">{l.label}</a>))}
      <a href={tel} class="tabular-nums font-bold">{phone}</a>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book !py-2">Book an assessment</a>
    </nav>
    <div class="lg:hidden ml-auto flex items-center gap-3">
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book !py-2 !px-3 text-sm">Book</a>
      <button type="button" class="p-2 -mr-2" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle aria-label="Menu">
        <span class="block w-6 h-0.5 bg-ink mb-1.5"></span><span class="block w-6 h-0.5 bg-ink mb-1.5"></span><span class="block w-6 h-0.5 bg-ink"></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" aria-label="Main" hidden class="lg:hidden border-t border-panel bg-white">
    <ul class="wrap py-4 grid gap-3 text-lg font-medium text-ink">
      {links.map((l) => <li><a href={l.href} class="block py-1">{l.label}</a></li>)}
      <li><a href={tel} class="block py-1 tabular-nums font-bold">{phone}</a></li>
      <li class="pt-2"><a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book">Book an assessment</a></li>
    </ul>
  </nav>
</header>
<script is:inline>
  const t = document.querySelector('[data-nav-toggle]'); const n = document.getElementById('mobile-nav');
  if (t && n) t.addEventListener('click', () => { const open = n.hidden; n.hidden = !open; t.setAttribute('aria-expanded', String(open)); });
</script>
