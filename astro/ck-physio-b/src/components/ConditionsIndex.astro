---
/** Home-page index of the condition groups. Group names only: the full list of conditions under
 *  each group, and how each is treated, lives on /conditions/ so one page owns those terms.
 *  Rows are 60px+ tap targets because most of these clients are in pain or unsteady on their feet. */
import { conditionGroups } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class="rounded-xl border border-panel bg-white overflow-hidden grid sm:grid-cols-2">
  {conditionGroups.map((g) => (
    <li class="border-t border-panel first:border-t-0 sm:[&:nth-child(2)]:border-t-0 sm:odd:border-r">
      <a href={`${base}/conditions/#${g.id}`} class="group h-full flex items-center gap-4 px-5 py-4 md:px-6 md:py-5 min-h-[60px] hover:bg-tint/30 focus-visible:bg-tint/30 transition-colors">
        <span class="shrink-0 h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span class="font-display font-extrabold text-ink leading-snug text-[17px] md:text-lg group-hover:text-primary">{g.name}</span>
        <svg class="ml-auto shrink-0 text-primary transition-transform group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </a>
    </li>
  ))}
</ul>
