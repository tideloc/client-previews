---
import { conditionGroups } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { link = true } = Astro.props;
---
<div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
  {conditionGroups.map((g) => (
    <div class="border-t-2 border-primary pt-4">
      <h3 class="text-xl leading-snug">{link ? <a href={`${base}/conditions/#${g.id}`} class="hover:text-primary">{g.name}</a> : g.name}</h3>
      <ul class="mt-2 columns-1 sm:columns-2 gap-6 text-[15px] leading-snug">
        {g.items.map((i) => <li class="break-inside-avoid py-0.5 pl-3 relative before:absolute before:left-0 before:top-[0.55em] before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent">{i}</li>)}
      </ul>
    </div>
  ))}
</div>
