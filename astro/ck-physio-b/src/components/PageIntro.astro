---
/** Inner-page opener. With `image` it is an ink hero split against a photo panel: a different
 *  composition from the home hero (text over a full-bleed photo) and, because the photo sits in
 *  a bounded column, it is served at its real size rather than upscaled. Without `image` it
 *  stays the plain white band. */
import { Picture } from 'astro:assets';
import { BOOKING_URL } from '../data/content';
import { siteContent } from '../lib/site';
const { label, title, lead, image, alt = '', imgClass = 'object-center', links = [] } = Astro.props;
const phone = siteContent.contact.phone;
const tel = 'tel:+61' + phone.replace(/\D/g, '').replace(/^0/, '');
---
{image ? (
  <section class="bg-ink text-white">
    <div class="wrap py-10 md:py-16 lg:py-20 grid gap-8 lg:gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
      <div>
        <p class="font-bold text-tint text-sm sm:text-base">{label}</p>
        <h1 class="mt-2 sm:mt-3 text-white text-[32px] leading-[1.05] sm:text-5xl lg:text-[52px] text-balance">{title}</h1>
        {lead && <p class="mt-4 md:mt-6 text-lg md:text-xl text-white/90">{lead}</p>}
        <div class="mt-6 md:mt-8 flex flex-wrap items-center gap-3">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book">Book an assessment</a>
          <a href={tel} class="inline-flex items-center justify-center min-h-[44px] rounded-md border-2 border-white/70 px-5 py-[10px] font-bold text-white tabular-nums hover:bg-white hover:text-ink transition-colors" data-tl="contact.phone" data-tl-href="tel:">{phone}</a>
        </div>
        {links.length > 0 && (
          <ul class="mt-7 md:mt-9 flex flex-wrap gap-2 md:gap-3">
            {links.map((l) => (
              <li><a href={l.href} class="inline-flex items-center min-h-[44px] rounded-full border border-white/40 bg-white/10 px-4 py-2 text-[15px] font-bold text-white hover:bg-white hover:text-ink transition-colors">{l.label}</a></li>
            ))}
          </ul>
        )}
      </div>
      <Picture src={image} alt={alt} widths={[image.width]} sizes="(min-width: 1024px) 46vw, 100vw" formats={['avif', 'webp']} loading="eager" class={`w-full h-full rounded-xl object-cover aspect-[16/10] lg:aspect-auto lg:min-h-[440px] ${imgClass}`} pictureAttributes={{ class: 'block lg:h-full' }} />
    </div>
  </section>
) : (
  <section class="bg-white border-b border-panel">
    <div class="wrap py-8 md:py-16 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-3xl">
        <p class="label">{label}</p>
        <h1 class="mt-2 text-[30px] sm:text-4xl md:text-5xl leading-[1.05]">{title}</h1>
        {lead && <p class="mt-3 md:mt-4 text-base md:text-xl text-body">{lead}</p>}
      </div>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book">Book an assessment</a>
    </div>
  </section>
)}
