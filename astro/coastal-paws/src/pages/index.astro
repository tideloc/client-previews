---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';
import bath from '../assets/bath.jpg';
import dry from '../assets/dry.jpg';
import dogs from '../assets/dogs.jpg';
import nails from '../assets/nails.jpg';
import shopfront from '../assets/shopfront.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = [
  ['Full groom', 'from $95', ['Bath, blow dry, full clip or scissor', 'Nails, ears, sanitary tidy', 'Two to three hours, no cages']],
  ['Bath and tidy', 'from $65', ['Wash, condition, dry, brush out', 'Face, feet and feathers tidy', 'Good between full grooms']],
  ['De-shed', 'from $85', ['Bath and conditioning treatment', 'Long blow out for double coats', 'Less hair on the couch']],
  ['Puppy intro', '$55', ['Under six months', 'Bath, light tidy, lots of treats', 'A gentle first visit']],
];
---
<Base title="Dog Grooming in Kiama | Coastal Paws">
  <!-- Full-bleed hero -->
  <section class="relative isolate min-h-[640px] overflow-hidden bg-deep text-cream md:min-h-[720px]">
    <Image src={hero} alt="A freshly groomed cream golden doodle sitting on the grooming table at Coastal Paws" widths={[768, 1376]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[65%_center]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-deep/90 via-deep/60 to-deep/10"></div>
    <div class="wrap flex min-h-[640px] flex-col justify-center py-20 md:min-h-[720px]">
      <p class="eyebrow">Dog grooming, Kiama</p>
      <h1 class="mt-4 max-w-2xl text-[40px] leading-[1.02] sm:text-[54px] md:text-[64px]">Clean dog. Happy dog. Booked online.</h1>
      <p class="mt-6 max-w-lg text-[16px] leading-relaxed text-cream/90">Full grooms, baths and tidies, and nail trims, done gently by one groomer who takes her time. Pick a slot online in about a minute.</p>
      <div class="mt-9 flex flex-wrap gap-3"><a href={`${base}/book/`} class="btn-coral">Book a groom</a><a href={`${base}/services/`} class="btn-outline">Services &amp; prices</a></div>
      <p class="mt-8 text-[13px] text-cream/70">Shop 2, 12 Manning Street, Kiama &middot; Tue to Sat &middot; <a class="font-semibold text-cream" href="tel:+61412345678">0412 345 678</a></p>
    </div>
  </section>

  <!-- Cream intro -->
  <section class="wrap py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-center">
      <div>
        <h2 class="text-[28px] sm:text-[34px]">Small salon, one groomer, no rush</h2>
        <p class="mt-5 text-[16px] leading-relaxed text-ink/80">Coastal Paws is a one-person salon on Manning Street. Eight years of grooming, a soft spot for the anxious ones, and a firm rule that no dog spends the day in a cage waiting.</p>
        <p class="mt-4 text-[16px] leading-relaxed text-ink/80">Drop off, do the shopping, come back to a dog that smells like a dog should. You get a text the moment they're ready.</p>
        <a href={`${base}/about/`} class="mt-6 inline-block font-display text-[15px] font-semibold uppercase tracking-wider text-coral underline underline-offset-4">About the salon</a>
      </div>
      <div class="overflow-hidden"><Image src={dogs} alt="Three freshly groomed dogs of different sizes sitting together on a bench" widths={[640, 1024]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
    </div>
  </section>

  <!-- Dark: services cards -->
  <section class="bg-ink text-cream">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow text-center">What we do</p>
      <h2 class="mt-2 text-center text-[32px] sm:text-[40px]">Four things, done properly</h2>
      <p class="mx-auto mt-3 max-w-lg text-center text-[15px] text-cream/75">Priced by dog size. Full prices on the services page.</p>
      <div class="mt-12 grid gap-5 md:grid-cols-4">
        {services.map(([name, price, feats]) => (
          <div class="flex flex-col bg-deep/70 p-6 ring-1 ring-cream/10">
            <h3 class="text-[18px] tracking-wider">{name}</h3>
            <p class="mt-4 font-display text-[40px] font-bold leading-none">{price}</p>
            <ul class="mt-5 flex-1 space-y-2 text-[14px] text-cream/85">{(feats as string[]).map((f) => <li class="flex gap-2"><span class="text-coral">&#9656;</span>{f}</li>)}</ul>
            <a href={`${base}/book/`} class="btn-coral mt-6 !py-3">Book now</a>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center"><a href={`${base}/services/`} class="font-display text-[15px] font-semibold uppercase tracking-wider text-coral underline underline-offset-4">All prices by size</a></div>
    </div>
  </section>

  <!-- Deep: how it works -->
  <section class="bg-deep text-cream">
    <div class="wrap grid gap-10 py-16 md:grid-cols-2 md:items-center md:py-24">
      <div class="overflow-hidden"><Image src={bath} alt="A small dog being washed in the grooming tub" widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="mt-2 text-[30px] sm:text-[36px]">Book. Drop off. Pick up a different dog.</h2>
        <ol class="mt-8 space-y-6">
          {[
            ['Pick a time online', 'The calendar shows real availability. Choose the service and the slot, and the confirmation lands straight away.'],
            ['Tell us about your dog', "Nervous, itchy, hates the dryer? Two minutes at the door so the groom fits the dog."],
            ['Pick up in two to three hours', "No cages for the day. A text when they're ready, and a dog that looks like itself, only cleaner."],
          ].map(([t, d], i) => (
            <li class="flex gap-5"><span class="font-display text-[34px] font-bold leading-none text-coral">0{i + 1}</span><div><h3 class="text-[18px] tracking-wider">{t}</h3><p class="mt-1.5 text-[14px] leading-relaxed text-cream/75">{d}</p></div></li>
          ))}
        </ol>
        <a href={`${base}/book/`} class="btn-coral mt-9">Book a groom</a>
      </div>
    </div>
  </section>

  <!-- Sand: good to know -->
  <section class="bg-sand">
    <div class="wrap grid gap-8 py-14 md:grid-cols-3">
      {[['Nervous dogs', 'Slower, quieter, and we stop if they need a break. Tell us at booking and we allow extra time, no charge.'], ['Matting', 'We never de-mat painfully. Heavy matting is clipped short, and you hear about it before we start.'], ['Cancellations', 'Life happens. Move or cancel from your confirmation email up to 24 hours before.']].map(([t, d]) => (
        <div><h3 class="text-[18px] tracking-wider text-ink">{t}</h3><p class="mt-2 text-[14px] leading-relaxed text-ink/75">{d}</p></div>
      ))}
    </div>
  </section>

  <!-- Gallery -->
  <section class="wrap py-16 md:py-20">
    <div class="text-center"><p class="eyebrow">Recent grooms</p><h2 class="mt-2 text-[32px] sm:text-[40px]">The proof is in the fluff</h2></div>
    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
      {[[hero, 'Freshly groomed golden doodle'], [dry, 'Blow-drying a small white dog'], [nails, 'A nail trim'], [shopfront, 'The salon on Manning Street']].map(([img, alt]) => (
        <div class="overflow-hidden"><Image src={img} alt={alt} widths={[480, 800]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-square w-full object-cover" /></div>
      ))}
    </div>
  </section>

  <!-- CTA over the shopfront -->
  <section class="relative isolate overflow-hidden bg-deep text-cream">
    <Image src={shopfront} alt="The outside of the Coastal Paws salon on a Kiama street" widths={[768, 1376]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35" />
    <div class="wrap py-20 text-center md:py-28">
      <h2 class="text-[32px] sm:text-[44px]">Book in a minute</h2>
      <p class="mx-auto mt-4 max-w-md text-[15px] text-cream/85">Pick a time online, or call and we'll sort it on the phone.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3"><a href={`${base}/book/`} class="btn-coral">Book online</a><a href="tel:+61412345678" class="btn-outline">0412 345 678</a></div>
    </div>
  </section>
</Base>
