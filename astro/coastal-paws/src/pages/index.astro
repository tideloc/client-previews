---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';
import bath from '../assets/bath.jpg';
import dry from '../assets/dry.jpg';
import dogs from '../assets/dogs.jpg';
import nails from '../assets/nails.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Dog Grooming in Kiama | Coastal Paws">
  <!-- Hero -->
  <section class="relative bg-sand">
    <div class="wrap grid items-center gap-10 py-14 md:grid-cols-[1fr_1.1fr] md:py-20">
      <div>
        <p class="eyebrow">Dog grooming, Kiama</p>
        <h1 class="mt-4 text-[44px] leading-[0.98] sm:text-[60px] md:text-[68px]">Clean dog.<br>Happy dog.<br><span class="text-teal">Booked online.</span></h1>
        <p class="mt-6 max-w-md text-[17px] leading-relaxed text-ink/75">Full grooms, baths and tidies, and nail trims, done gently by one groomer who takes her time. Pick a slot online in about a minute.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${base}/book/`} class="btn-coral">Book a groom</a>
          <a href={`${base}/services/`} class="btn-ghost">Services &amp; prices</a>
        </div>
        <p class="mt-6 text-[14px] text-ink/60">Shop 2, 12 Manning Street, Kiama &middot; <a class="font-semibold text-teal" href="tel:+61412345678">0412 345 678</a></p>
      </div>
      <div class="overflow-hidden rounded-xl2 shadow-[0_30px_60px_-20px_rgba(31,42,46,.35)]">
        <Image src={hero} alt="A freshly groomed cream golden doodle sitting on the grooming table at Coastal Paws" widths={[640, 1024, 1376]} sizes="(min-width: 768px) 55vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="wrap py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3 text-[34px] leading-tight sm:text-[42px]">Four things, done properly.</h2>
      </div>
      <a href={`${base}/services/`} class="font-semibold text-teal underline underline-offset-4">All prices by size</a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {[
        { t: 'Full groom', p: 'from $95', d: 'Bath, blow dry, full clip or scissor to your style, nails, ears and a sanitary tidy.', img: dry, alt: 'A small white dog being blow-dried and brushed on the grooming table' },
        { t: 'Bath and tidy', p: 'from $65', d: 'Wash, condition, dry and brush out, with a face, feet and feathers tidy.', img: bath, alt: 'A small dog being washed in the grooming tub' },
        { t: 'Nail trim', p: '$20', d: 'Walk in on Saturday mornings or add it to any booking. Quick and calm.', img: nails, alt: 'A dog paw held gently for a nail trim' },
        { t: 'Puppy intro', p: '$55', d: 'A short, gentle first visit for pups under six months. Bath, a little tidy, lots of treats.', img: dogs, alt: 'Three freshly groomed dogs sitting together on a bench' },
      ].map((s) => (
        <article class="grid overflow-hidden rounded-xl2 bg-white shadow-sm ring-1 ring-ink/5 sm:grid-cols-[42%_1fr]">
          <Image src={s.img} alt={s.alt} widths={[480, 800]} sizes="(min-width: 640px) 22vw, 100vw" class="h-52 w-full object-cover sm:h-full" />
          <div class="p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-[22px]">{s.t}</h3>
              <span class="font-display text-lg font-extrabold text-teal">{s.p}</span>
            </div>
            <p class="mt-2 text-[15px] leading-relaxed text-ink/70">{s.d}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-teal text-cream">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow !text-coral">How it works</p>
      <h2 class="mt-3 max-w-2xl text-[34px] leading-tight sm:text-[42px]">Book in a minute. Drop off. Pick up a different dog.</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {[
          ['Pick a time online', 'The calendar shows real availability. Choose the service and the slot that suits, and you get a confirmation straight away.'],
          ['Drop off, tell us about your dog', 'Nervous, itchy, hates the dryer? Two minutes at the door so the groom fits the dog.'],
          ['Pick up in two to three hours', 'No cages for the day. A text when they are ready, and a dog that smells like a dog should.'],
        ].map(([t, d], i) => (
          <li class="rounded-xl2 bg-white/10 p-6">
            <span class="font-display text-4xl font-extrabold text-coral">{i + 1}</span>
            <h3 class="mt-3 text-[20px]">{t}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-cream/80">{d}</p>
          </li>
        ))}
      </ol>
      <a href={`${base}/book/`} class="btn-coral mt-10">Book a groom</a>
    </div>
  </section>

  <!-- Good to know -->
  <section class="wrap py-16 md:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:items-center">
      <div class="overflow-hidden rounded-xl2">
        <Image src={dogs} alt="Three freshly groomed dogs of different sizes sitting together" widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 100vw" class="h-full w-full object-cover" />
      </div>
      <div>
        <p class="eyebrow">Good to know</p>
        <h2 class="mt-3 text-[34px] leading-tight sm:text-[42px]">Small salon, one groomer, no rush.</h2>
        <dl class="mt-8 space-y-5 text-[15px] leading-relaxed">
          <div><dt class="font-bold">Nervous dogs</dt><dd class="text-ink/70">Slower, quieter, and we stop if they need a break. Tell us at booking and we allow extra time.</dd></div>
          <div><dt class="font-bold">Matting</dt><dd class="text-ink/70">We never de-mat painfully. Heavy matting is clipped short, and we tell you before we start.</dd></div>
          <div><dt class="font-bold">Cancellations</dt><dd class="text-ink/70">Life happens. Move or cancel from your confirmation email up to 24 hours before.</dd></div>
        </dl>
        <a href={`${base}/about/`} class="mt-8 inline-block font-semibold text-teal underline underline-offset-4">More about the salon</a>
      </div>
    </div>
  </section>
</Base>
