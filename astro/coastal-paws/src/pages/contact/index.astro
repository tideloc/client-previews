---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Contact & Hours | Coastal Paws Dog Grooming, Kiama" description="Coastal Paws Dog Grooming, Shop 2, 12 Manning Street, Kiama. Open Tuesday to Saturday. Call 0412 345 678 or book online.">
  <section class="bg-ink text-cream">
    <div class="wrap py-14 md:py-20">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 text-[40px] leading-[1] sm:text-[56px]">Manning Street, Kiama.</h1>
      <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-cream/85">Two doors up from the bakery, with parking out the front and a water bowl by the door.</p>
    </div>
  </section>
  <section class="wrap grid gap-8 py-14 md:grid-cols-3 md:py-20">
    <div class="bg-white p-7 ring-1 ring-ink/10">
      <p class="eyebrow">Address</p>
      <p class="mt-3 text-[17px] leading-relaxed">Shop 2, 12 Manning Street<br>Kiama NSW 2533</p>
      <a class="btn-coral mt-5" href="https://www.google.com/maps/dir/?api=1&destination=12+Manning+Street+Kiama+NSW+2533" target="_blank" rel="noopener">Directions</a>
    </div>
    <div class="bg-white p-7 ring-1 ring-ink/10">
      <p class="eyebrow">Call or text</p>
      <p class="mt-3 text-[17px]"><a class="font-bold text-coral" href="tel:+61412345678">0412 345 678</a></p>
      <p class="mt-2 text-[15px] text-ink/70">If we're mid-groom we'll call back within the hour.</p>
      <a class="btn-coral mt-5" href={`${base}/book/`}>Book online instead</a>
    </div>
    <div class="bg-white p-7 ring-1 ring-ink/10">
      <p class="eyebrow">Hours</p>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[16px]">
        <dt class="font-semibold">Tue to Fri</dt><dd>8am to 4:30pm</dd>
        <dt class="font-semibold">Saturday</dt><dd>8am to 1pm</dd>
        <dt class="font-semibold">Sun, Mon</dt><dd class="text-ink/60">Closed</dd>
      </dl>
      <p class="mt-4 text-[14px] text-ink/60">Nail trims: walk in Saturday mornings, no booking needed.</p>
    </div>
  </section>
</Base>
