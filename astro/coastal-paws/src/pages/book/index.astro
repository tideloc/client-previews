---
import Base from '../../layouts/Base.astro';
---
<Base title="Book Online | Coastal Paws Dog Grooming, Kiama" description="Book a dog groom in Kiama online. Pick a service and a time from real availability and get a confirmation straight away.">
  <section class="bg-sand">
    <div class="wrap py-14 md:py-16">
      <p class="eyebrow">Book online</p>
      <h1 class="mt-4 max-w-2xl text-[40px] leading-[1] sm:text-[56px]">Pick a time. Done.</h1>
      <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-stone">The calendar shows real availability. Choose the service, choose the slot, and you'll get a confirmation you can move or cancel yourself up to 24 hours before.</p>
    </div>
  </section>

  <section class="wrap py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <div class="tl-booking bg-white p-2 rounded-blob ring-1 ring-navy/10" data-cal-link="tideloc/discovery" data-cal-label="Book a groom"></div>
        <p class="mt-3 text-[13px] text-ink/50">Example site: the calendar is a live booking embed on a demo account. On a real site it's the groomer's own calendar.</p>
      </div>
      <aside>
        <h2 class="text-[26px]">Rather we call you?</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-ink/70">Leave your details and a bit about your dog and we'll ring back to lock in a time.</p>
        <form class="tl-request mt-6 grid gap-4 bg-white p-6 rounded-blob ring-1 ring-navy/10" data-tl-kind="booking-request">
          <label class="grid gap-1.5 text-[14px] font-semibold">Your name<input name="name" required class="rounded-lg border border-ink/15 px-3.5 py-3 font-normal" autocomplete="name" /></label>
          <label class="grid gap-1.5 text-[14px] font-semibold">Phone<input name="phone" type="tel" required class="rounded-lg border border-ink/15 px-3.5 py-3 font-normal" autocomplete="tel" /></label>
          <label class="grid gap-1.5 text-[14px] font-semibold">Your dog<input name="dog" placeholder="Name, breed, rough size" required class="rounded-lg border border-ink/15 px-3.5 py-3 font-normal" /></label>
          <label class="grid gap-1.5 text-[14px] font-semibold">What would you like?
            <select name="service" class="rounded-lg border border-ink/15 bg-white px-3.5 py-3 font-normal">
              <option>Full groom</option><option>Bath and tidy</option><option>De-shed</option><option>Puppy intro</option><option>Nail trim</option><option>Not sure yet</option>
            </select></label>
          <label class="grid gap-1.5 text-[14px] font-semibold">Anything we should know?<textarea name="notes" rows="3" placeholder="Nervous, matted, hates the dryer, days that suit" class="rounded-lg border border-ink/15 px-3.5 py-3 font-normal"></textarea></label>
          <button type="submit" class="btn-coral">Request a call back</button>
        </form>
      </aside>
    </div>
  </section>
</Base>
