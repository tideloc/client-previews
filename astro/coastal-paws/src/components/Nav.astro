---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const links = [
  { href: `${base}/`, label: 'Home', match: '/' },
  { href: `${base}/services/`, label: 'Services', match: '/services' },
  { href: `${base}/about/`, label: 'About', match: '/about' },
  { href: `${base}/contact/`, label: 'Contact', match: '/contact' },
];
const isActive = (m: string) => (m === '/' ? path === '/' : path.startsWith(m));
---
<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-ink/10">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href={`${base}/`} class="flex items-center gap-2.5" aria-label="Coastal Paws home">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-ink text-cream font-display text-base font-bold">CP</span>
      <span class="font-display text-[20px] font-bold text-ink">Coastal Paws</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[14px] font-medium" aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={['hover:text-teal', { 'text-teal underline underline-offset-4': isActive(l.match) }]} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a>)}
      <a href={`${base}/book/`} class="btn-dark !py-2.5 !px-5 !text-[14px]">Book Now</a>
    </nav>
    <div class="flex items-center gap-2 md:hidden">
      <a href={`${base}/book/`} class="btn-dark !py-2.5 !px-4 !text-[14px]">Book</a>
      <button id="menuBtn" class="grid h-11 w-11 place-items-center rounded-md border-2 border-ink/15" aria-expanded="false" aria-controls="mobileNav" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobileNav" class="md:hidden hidden border-t border-ink/10 bg-cream" aria-label="Mobile">
    <div class="wrap flex flex-col py-2">
      {links.map((l) => <a href={l.href} class="py-3.5 text-[16px] font-medium border-b border-ink/5">{l.label}</a>)}
      <a href="tel:+61412345678" class="py-3.5 text-[16px] font-semibold text-teal">Call 0412 345 678</a>
    </div>
  </nav>
</header>
<script>
  const b = document.getElementById('menuBtn'); const n = document.getElementById('mobileNav');
  b?.addEventListener('click', () => { const open = n!.classList.toggle('hidden') === false; b.setAttribute('aria-expanded', String(open)); });
</script>
