---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const links = [
  { href: `${base}/`, label: 'Home', match: '/' },
  { href: `${base}/services/`, label: 'Services & prices', match: '/services' },
  { href: `${base}/about/`, label: 'About', match: '/about' },
  { href: `${base}/contact/`, label: 'Contact', match: '/contact' },
];
const isActive = (m: string) => (m === '/' ? path === '/' : path.startsWith(m));
---
<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-ink/10">
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href={`${base}/`} class="flex items-center gap-2.5 font-display text-[22px] font-extrabold tracking-tight">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-teal text-white text-sm">CP</span>
      <span>Coastal <span class="text-coral">Paws</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[15px] font-semibold" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['hover:text-teal', { 'text-teal': isActive(l.match) }]} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href="tel:+61412345678" class="hidden sm:inline-flex btn-ghost !py-2.5 !px-4">0412 345 678</a>
      <a href={`${base}/book/`} class="btn-coral !py-2.5 !px-4">Book online</a>
      <button id="menuBtn" class="md:hidden grid h-11 w-11 place-items-center rounded-full border-2 border-ink/15" aria-expanded="false" aria-controls="mobileNav" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobileNav" class="md:hidden hidden border-t border-ink/10 bg-cream" aria-label="Mobile">
    <div class="wrap flex flex-col py-2">
      {links.map((l) => <a href={l.href} class="py-3.5 text-[16px] font-semibold border-b border-ink/5 last:border-0">{l.label}</a>)}
      <a href="tel:+61412345678" class="py-3.5 text-[16px] font-semibold text-teal">Call 0412 345 678</a>
    </div>
  </nav>
</header>
<script>
  const b = document.getElementById('menuBtn'); const n = document.getElementById('mobileNav');
  b?.addEventListener('click', () => { const open = n!.classList.toggle('hidden') === false; b.setAttribute('aria-expanded', String(open)); });
</script>
