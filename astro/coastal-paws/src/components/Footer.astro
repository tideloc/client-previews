---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="mt-24 bg-ink text-cream">
  <div class="wrap grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-extrabold">Coastal <span class="text-coral">Paws</span></p>
      <p class="mt-3 max-w-xs text-cream/70 text-[15px] leading-relaxed">A small dog grooming salon in Kiama. Gentle handling, honest prices, and dogs that leave looking like themselves, only cleaner.</p>
    </div>
    <div>
      <p class="eyebrow !text-coral">Find us</p>
      <p class="mt-3 text-[15px] leading-relaxed">Shop 2, 12 Manning Street<br>Kiama NSW 2533</p>
      <a class="mt-3 inline-block font-semibold underline underline-offset-4 hover:text-coral" href="https://www.google.com/maps/dir/?api=1&destination=12+Manning+Street+Kiama+NSW+2533" target="_blank" rel="noopener">Get directions</a>
      <p class="mt-4 text-[15px]"><a class="font-semibold hover:text-coral" href="tel:+61412345678">0412 345 678</a></p>
    </div>
    <div>
      <p class="eyebrow !text-coral">Hours</p>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5 text-[15px]">
        <dt>Tue to Fri</dt><dd>8am to 4:30pm</dd>
        <dt>Saturday</dt><dd>8am to 1pm</dd>
        <dt>Sun, Mon</dt><dd>Closed</dd>
      </dl>
      <a href={`${base}/book/`} class="btn-coral mt-6">Book online</a>
    </div>
  </div>
  <div class="border-t border-cream/10">
    <div class="wrap flex flex-col gap-2 py-5 text-[13px] text-cream/50 sm:flex-row sm:justify-between">
      <span>&copy; 2026 Coastal Paws Dog Grooming. Kiama, NSW.</span>
      <span>Example site by <a class="underline hover:text-cream" href="https://tideloc.com.au">Tideloc</a></span>
    </div>
  </div>
</footer>
