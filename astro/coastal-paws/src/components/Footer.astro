---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-ink text-cream">
  <div class="wrap grid gap-10 py-16 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold">Coastal Paws Dog Grooming</p>
      <p class="mt-4 text-[14px] leading-relaxed text-cream/80">Shop 2, 12 Manning Street<br>Kiama NSW 2533</p>
      <p class="mt-3 text-[14px]"><a class="hover:underline" href="tel:+61412345678">0412 345 678</a></p>
      <p class="mt-1 text-[14px]"><a class="hover:underline" href="mailto:hello@coastalpaws.example">hello@coastalpaws.example</a></p>
    </div>
    <div>
      <p class="font-display text-lg font-bold">Quick links</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 text-[14px] text-cream/80">
        <li><a class="hover:underline" href={`${base}/`}>Home</a></li><li><a class="hover:underline" href={`${base}/services/`}>Services</a></li>
        <li><a class="hover:underline" href={`${base}/about/`}>About</a></li><li><a class="hover:underline" href={`${base}/contact/`}>Contact</a></li>
        <li><a class="hover:underline" href={`${base}/book/`}>Book online</a></li>
      </ul>
    </div>
    <div>
      <p class="font-display text-lg font-bold">Opening hours</p>
      <dl class="mt-4 text-[14px] text-cream/80 space-y-1">
        <div class="flex gap-4"><dt class="w-24">Tue to Fri</dt><dd>8:00am to 4:30pm</dd></div>
        <div class="flex gap-4"><dt class="w-24">Saturday</dt><dd>8:00am to 1:00pm</dd></div>
        <div class="flex gap-4"><dt class="w-24">Sun, Mon</dt><dd>Closed</dd></div>
      </dl>
      <a class="mt-5 inline-block text-[14px] underline underline-offset-4 hover:text-coral" href="https://www.google.com/maps/dir/?api=1&destination=12+Manning+Street+Kiama+NSW+2533" target="_blank" rel="noopener">Get directions</a>
    </div>
  </div>
  <div class="border-t border-cream/10">
    <div class="wrap flex flex-col gap-2 py-5 text-[12.5px] text-cream/50 sm:flex-row sm:justify-between">
      <span>&copy; 2026 Coastal Paws Dog Grooming. All rights reserved.</span>
      <span>Example site by <a class="underline hover:text-cream" href="https://tideloc.com.au">Tideloc</a></span>
    </div>
  </div>
</footer>
