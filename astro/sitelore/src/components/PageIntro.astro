---
import TagChip from './TagChip.astro';
interface Props { tag: string; title: string; lead?: string }
const { tag, title, lead } = Astro.props;
---
<section data-section="intro" class="border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 pt-12 pb-10 lg:pt-16 lg:pb-14 grid gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
    <div>
      <TagChip label={tag} />
      <h1 class="mt-4 text-[40px] sm:text-5xl lg:text-6xl leading-[0.98] tracking-[-0.02em]">{title}</h1>
    </div>
    {lead && <p class="text-[17px] leading-[1.5] max-w-[34rem]">{lead}</p>}
  </div>
</section>
