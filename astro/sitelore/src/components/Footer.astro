---
import { CAL_URL, BOOK_LABEL } from '../lib/links';
import { siteContent } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const c = siteContent.contact;
---
<footer class="bg-ink text-ground border-t border-rule-dark" data-section="footer">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <a href={`${base}/`} class="inline-flex items-center gap-3" aria-label="Sitelore home">
        <img src={`${base}/mark.svg`} alt="" width="36" height="36" class="h-9 w-9 rounded-sm" />
        <span class="display text-2xl">Sitelore</span>
      </a>
      <p class="mt-5 max-w-sm text-ground/80">A site knowledge base for shopping centres and office buildings, held by the asset manager. Built by Tideloc, a small web studio in Wollongong, NSW.</p>
      <a href={CAL_URL} class="btn-outline btn-outline-sheet mt-6" target="_blank" rel="noreferrer">{BOOK_LABEL}</a>
    </div>
    <div>
      <p class="mono-tag text-xs text-ground/60 mb-3">Pages</p>
      <ul class="grid gap-2">
        <li><a class="hover:underline" href={`${base}/product/`}>Product</a></li>
        <li><a class="hover:underline" href={`${base}/who-we-are/`}>Who we are</a></li>
        <li><a class="hover:underline" href={`${base}/contact/`}>Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="mono-tag text-xs text-ground/60 mb-3">Images</p>
      <p class="text-ground/80 max-w-[22rem]">Screens show an invented portfolio. Two layouts are derived from OpenStreetMap data, © OpenStreetMap contributors, ODbL.</p>
      <p class="mono-tag text-xs text-ground/60 mt-8 mb-2">Tideloc</p>
      <p class="text-ground/80">{c.suburb} {c.state}</p>
      <p><a class="hover:underline" href={`mailto:${c.email}`}>{c.email}</a></p>
    </div>
  </div>
  <div class="border-t border-rule-dark">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 py-4 flex flex-wrap justify-between gap-3 mono-tag text-xs text-ground/60">
      <span>&copy; {year} Tideloc. Sitelore.</span>
    </div>
  </div>
</footer>
