---
/** Explore the app page body: the one iframe with the Desktop / Phone control, instructions, persona sign-in chips, mobile note. */
import { APP_SIGN_IN, APP_DEMO } from '../lib/links';
import TagChip from './TagChip.astro';
import DemoFrame from './DemoFrame.astro';
const people = ['Priya', 'Sam', 'Harriet', 'Nadia'];
/** Each task opens the demo signed in as Harriet on one screen. Paths are app routes; /demo only accepts paths inside the app. */
const db01 = encodeURIComponent('wattleford:asset:db-01');
const tasks = [
  { t: 'Show only the switchboards', d: 'The ground floor with boards and main switchboards switched on.', to: '/sites/wattleford/map?level=G&show=DB,MSSB,MSB&zoom=1' },
  { t: 'Open a distribution board', d: 'Photo, location, contractor, and what it feeds.', to: `/sites/wattleford/map?level=G&show=DB&asset=${db01}&zoom=1` },
  { t: 'Find what feeds an emergency light', d: 'Search "what feeds EM-01", answered from the board schedules.', to: '/search?q=' + encodeURIComponent('what feeds EM-01') },
  { t: 'See the emergency codes', d: 'Steps and who to call for each code, plus isolation points.', to: '/sites/wattleford/emergency' },
  { t: 'Who covers what', d: 'Contractors, their scope, contract dates and after-hours numbers.', to: '/sites/wattleford/contractors' },
  { t: 'Print a handover pack', d: 'Everything a new manager needs on day one.', to: '/sites/wattleford/handover' },
];
const firstSrc = `${APP_DEMO}?as=harriet&to=${encodeURIComponent(tasks[0].to)}`;
---
<section data-section="explorer" aria-labelledby="ex-h" class="border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 pt-10 pb-8 grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end">
    <div>
      <TagChip label="Explore the app" />
      <h1 id="ex-h" class="mt-4 text-4xl sm:text-5xl lg:text-6xl leading-[0.98] tracking-[-0.02em]">Explore the app</h1>
    </div>
    <div class="text-[17px] leading-[1.5]">
      <p>Pick a task and the demo below opens straight onto it. Then click around: it is the real app.</p>
      <p class="mt-3 text-ink-2 text-[15px]">A fictional portfolio, Harbourline Property, with five invented sites. Wattleford Central and Brindle Park are drawn on layouts derived from real centres in OpenStreetMap, with invented names and data.</p>
    </div>
  </div>
  <div class="mx-auto max-w-wrap px-5 sm:px-8 pb-6">
    <h2 class="mono-tag text-xs text-ink-2">Try it yourself</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3" data-tasks>
      {tasks.map((t, i) => (
        <li>
          <button type="button" data-to={t.to} aria-pressed={i === 0 ? 'true' : 'false'} class="task w-full text-left rounded-md border border-rule bg-card px-4 py-3 hover:border-ink">
            <span class="block display text-lg leading-tight">{t.t}</span>
            <span class="block mt-1 text-[14px] leading-[1.4] text-ink-2">{t.d}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
  <div class="mx-auto max-w-wrap px-5 sm:px-8 pb-12">
    <DemoFrame variant="explore" src={firstSrc} />
    <p class="mt-3 text-[13px] leading-[18px] text-ink-2 md:hidden">On a phone, <a href={APP_SIGN_IN} target="_blank" rel="noreferrer" class="underline underline-offset-4 text-ink">open the demo in its own tab</a>; it installs to your home screen.</p>
  </div>
</section>
<script is:inline define:vars={{ demo: APP_DEMO }}>
  (function () {
    var list = document.querySelector('[data-tasks]');
    var ifr = document.querySelector('[data-demo-frame] iframe');
    if (!list || !ifr) return;
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-to]');
      if (!btn) return;
      ifr.src = demo + '?as=harriet&to=' + encodeURIComponent(btn.getAttribute('data-to'));
      list.querySelectorAll('button[data-to]').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
      var r = ifr.getBoundingClientRect();
      if (r.top < 0 || r.top > window.innerHeight * 0.6) ifr.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
<section data-section="quick-links" aria-labelledby="ql-h" class="bg-card border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-10 flex flex-wrap items-center gap-x-8 gap-y-4">
    <p id="ql-h" class="text-[17px] leading-[1.5] text-ink-2 max-w-[34rem]">The sign-in page above lists the people in the demo. Open it in its own tab as any of them; on a phone, it installs to your home screen.</p>
    <ul class="flex flex-wrap gap-2" aria-label="Sign in to the demo as">
      {people.map((p) => (
        <li><a href={APP_SIGN_IN} target="_blank" rel="noreferrer" class="tag tag-lg hover:bg-ink-raised"><span class="sr-only">Sign in as </span>{p}</a></li>
      ))}
    </ul>
  </div>
</section>
