---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hours from '../../components/tl/Hours.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteContent, fullAddress } from '../../lib/site';
const c = siteContent.contact;
const tel = 'tel:+61' + c.phone.replace(/\D/g, '').replace(/^0/, '');
const mapQ = encodeURIComponent('Corner North Street and East Street, Moss Vale NSW 2579');
---
<Base
  title="Contact and hours | Tiny Flower House, Moss Vale"
  description="Find Tiny Flower House at the corner of North and East Street, Moss Vale, entry via North Street. Workshop hours, phone, email and directions."
>
  <Header slot="header" />
  <section data-section="hero" class="bg-primary text-ground">
    <div class="mx-auto max-w-6xl px-5 pt-16 pb-14 md:pt-24 md:pb-20 grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="font-display text-sm tracking-[0.35em] text-secondary">Moss Vale, NSW</p>
        <h1 class="font-display mt-4 text-[10vw] md:text-[4.4vw] leading-[1.05]">Find the corner.</h1>
        <address class="not-italic mt-6 text-xl md:text-2xl leading-snug">
          <span data-tl="contact.address">{fullAddress()}</span><br />Entry via North Street
        </address>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={c.mapUrl} class="bg-ground text-ink px-7 py-3.5 font-semibold">Directions</a>
          <a href={tel} class="border border-ground/70 px-7 py-3.5 font-semibold tabular-nums" data-tl="contact.phone">{c.phone}</a>
        </div>
        <p class="mt-5"><a href={`mailto:${c.email}`} class="underline underline-offset-4 break-all" data-tl="contact.email">{c.email}</a></p>
      </div>
      <aside class="md:col-span-5 bg-ground text-ink p-6 md:p-7">
        <p class="font-display text-xs tracking-[0.25em] text-primary">Workshop hours</p>
        <Hours listClass="mt-3 divide-y divide-ink/10" rowClass="flex justify-between py-2" dayClass="" timeClass="tabular-nums" closedClass="text-ink/50" />
        <p class="mt-4 text-sm text-ink/70">Open for phone and online requests. Deliveries Monday to Saturday.</p>
      </aside>
    </div>
  </section>

  <iframe title="Map of the corner of North and East Street, Moss Vale" src={`https://www.google.com/maps?q=${mapQ}&output=embed`} class="block w-full h-[52vh] md:h-[60vh]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>

  <section data-section="request" id="request" aria-labelledby="msg-h" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <h2 id="msg-h" class="font-display text-2xl md:text-3xl">Special requests</h2>
      <p class="mt-4 text-ink/80 text-lg">Something particular in mind, or a question about what is in bloom this week. Ask here or ring.</p>
    </div>
    <div class="md:col-span-7">
      <EnquiryForm kind="enquiry" site="Tiny Flower House" submitLabel="Send" successText="Thanks. Your message has been sent to Tiny Flower House."
        fields={[
          { name: 'name', label: 'Your name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel' },
          { name: 'email', label: 'Email', type: 'email', required: true },
          { name: 'message', label: 'Message', type: 'textarea', required: true },
        ]} />
    </div>
  </section>
  <Footer slot="footer" hideHours />
</Base>
