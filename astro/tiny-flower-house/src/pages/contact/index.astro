---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hours from '../../components/tl/Hours.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { siteContent, fullAddress } from '../../lib/site';
const c = siteContent.contact;
const tel = 'tel:+61' + c.phone.replace(/\D/g, '').replace(/^0/, '');
const mapQ = encodeURIComponent('Corner North Street and East Street, Moss Vale NSW 2579');
---
<Base
  title="Contact and hours | Tiny Flower House, Moss Vale"
  description="Find Tiny Flower House at the corner of North and East Street, Moss Vale, entry via North Street. Workshop hours, phone, email and directions."
>
  <Header slot="header" />
  <section data-section="page-hero" class="mx-auto max-w-6xl px-5 pt-12 md:pt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <h1 class="font-display font-light text-5xl md:text-6xl leading-[1.05]">Find the corner</h1>
      <address class="not-italic mt-6 text-lg leading-relaxed">
        <span data-tl="contact.address">{fullAddress()}</span><br />Entry via North Street
      </address>
      <p class="mt-4"><a href={c.mapUrl} class="underline underline-offset-4">Directions</a></p>
      <p class="mt-6"><a href={tel} class="underline underline-offset-4 tabular-nums text-lg" data-tl="contact.phone">{c.phone}</a><br />
        <a href={`mailto:${c.email}`} class="underline underline-offset-4 break-all" data-tl="contact.email">{c.email}</a></p>
      <h2 class="font-display text-2xl mt-10 mb-3">Workshop hours</h2>
      <Hours listClass="divide-y divide-ink/10 max-w-xs" rowClass="flex justify-between py-1.5" dayClass="" timeClass="tabular-nums" closedClass="text-ink/50" />
      <p class="mt-3 text-sm text-ink/70">Open for phone and online requests. Deliveries Monday to Saturday.</p>
    </div>
    <div class="md:col-span-7">
      <iframe title="Map of the corner of North and East Street, Moss Vale" src={`https://www.google.com/maps?q=${mapQ}&output=embed`} class="w-full aspect-[4/3] border border-ink/15" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </section>

  <section data-section="request" id="request" aria-labelledby="msg-h" class="mx-auto max-w-6xl px-5 mt-20 grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <h2 id="msg-h" class="font-display text-4xl font-light">Special requests</h2>
      <p class="mt-4 text-ink/80">Something particular in mind, a standing order for the office, or a question about what is in bloom this week. Ask here or ring.</p>
    </div>
    <div class="md:col-span-3 md:pl-10 md:border-l md:border-ink/10">
      <EnquiryForm kind="enquiry" site="Tiny Flower House" submitLabel="Send" successText="Thanks. Lisa will get back to you."
        fields={[
          { name: 'name', label: 'Your name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel' },
          { name: 'email', label: 'Email', type: 'email', required: true },
          { name: 'message', label: 'Message', type: 'textarea', required: true },
        ]} />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
