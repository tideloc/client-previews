---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SeasonCalendar from '../../components/SeasonCalendar.astro';
import CallBand from '../../components/CallBand.astro';
import strawflowers from '../../assets/verge-strawflowers.jpg';
import jug from '../../assets/bunch-jug.jpg';
import posy from '../../assets/bunch-posy.jpg';
import spring from '../../assets/bunch-spring.jpg';
import box from '../../assets/bunch-mauve.jpg';
import zinnias from '../../assets/close-zinnias.jpg';
import snaps from '../../assets/close-snapdragons.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="What is in the beds this week | Tiny Flower House, Moss Vale"
  description="The growing calendar for Tiny Flower House in Moss Vale: spring, summer and autumn stems grown on the verge, what is cutting now, and how to request a bunch."
>
  <Header slot="header" />
  <PageHero image={strawflowers} alt="Pale pink strawflowers and asters in the verge bed in sunlight" eyebrow="Seasonal flowers" title="What is in the beds." line="Every stem she publishes, by season. Out of season stems stay listed." cta={{ href: `${base}/#request`, label: 'Request a bunch' }} position="50% 40%" />

  <div id="beds" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20">
    <h2 class="font-display text-2xl md:text-3xl">By season</h2>
    <p class="mt-3 max-w-xl text-ink/80">Grown on the nature strip at the corner of North and East Street and sourced within 50 km of Moss Vale. What is in bloom changes week to week.</p>
  </div>
  <SeasonCalendar bare />

  <CallBand />

  <section data-section="bunches" aria-label="Bunches" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20">
    <h2 class="font-display text-2xl md:text-3xl">Seasonal bouquets</h2>
    <p class="mt-3 max-w-xl text-ink/80">We use what is currently in season, so our bouquets are made up of the best seasonal flowers the Southern Highlands has to offer.</p>
    <div class="mt-8 grid gap-3 grid-cols-2 md:grid-cols-4 md:grid-rows-2">
      <Picture src={spring} widths={[600, 1000, 1400]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="Mixed spring bunch of daffodils, stock and lilac in a tin on a timber table" pictureAttributes={{ class: 'col-span-2 row-span-2 block' }} class="w-full h-full object-cover" loading="lazy" />
      <Picture src={posy} widths={[400, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Posy of poppies and ranunculus in a white box tied with sage ribbon" class="w-full aspect-square object-cover" loading="lazy" />
      <Picture src={jug} widths={[400, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Garden bunch of roses and foliage arranged in a stoneware jug" class="w-full aspect-square object-cover" loading="lazy" />
      <Picture src={zinnias} widths={[400, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Bright zinnias in red, pink and gold" class="w-full aspect-square object-cover" loading="lazy" />
      <Picture src={snaps} widths={[400, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Peach and yellow snapdragons close up" class="w-full aspect-square object-cover" loading="lazy" />
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4"><a href={`${base}/#request`} class="bg-primary text-ground px-7 py-3.5 font-semibold">Request a bunch</a><a href="tel:+61417000547" class="font-semibold underline underline-offset-4 tabular-nums">0417 000 547</a></div>
  </section>
  <Footer slot="footer" />
</Base>
