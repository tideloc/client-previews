---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeasonCalendar from '../components/SeasonCalendar.astro';
import BunchRequest from '../components/BunchRequest.astro';
import VergeBand from '../components/VergeBand.astro';
import HeroVerge from '../components/HeroVerge.astro';
import BrandBand from '../components/BrandBand.astro';
import WeddingsGifts from '../components/WeddingsGifts.astro';
import hero from '../assets/verge-dahlias-house.jpg';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const og = await getImage({ src: hero, width: 1200, height: 630, format: 'jpg' });
const ogUrl = `${site}${og.src}`;
---
<Base
  title="Seasonal flowers grown in Moss Vale | Tiny Flower House"
  description="Tiny Flower House grows seasonal flowers on a Moss Vale nature strip and cuts bunches to order. See what is in the beds this week and request a bunch."
  ogImage={ogUrl}
>
  <Header slot="header" />

  <HeroVerge />
  <BrandBand />
  <div id="beds" class="mx-auto max-w-6xl px-5 mt-20 md:mt-24"><h2 class="font-display text-2xl md:text-3xl">In the beds, by season</h2><p class="mt-3 max-w-xl text-ink/80">Grown on the nature strip at the corner of North and East Street and sourced within 50 km of Moss Vale. What is in bloom changes week to week.</p></div>
  <SeasonCalendar compact bare />
  <VergeBand />
  <BunchRequest />
  <WeddingsGifts />

  <Footer slot="footer" />
</Base>
