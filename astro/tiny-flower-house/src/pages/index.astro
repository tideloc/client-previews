---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeasonCalendar from '../components/SeasonCalendar.astro';
import BunchRequest from '../components/BunchRequest.astro';
import VergeBand from '../components/VergeBand.astro';
import { seasons, seasonFor, nextSeason } from '../data/seasons';
import WeddingsGifts from '../components/WeddingsGifts.astro';
import hero from '../assets/verge-dahlias-house.jpg';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const og = await getImage({ src: hero, width: 1200, height: 630, format: 'jpg' });
const ogUrl = `${site}${og.src}`;
const today = new Date();
const dateLine = today.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', timeZone: 'Australia/Sydney' });
const now = seasonFor(today);
const cur = seasons.find((s) => s.key === now)!;
const nxt = seasons.find((s) => s.key === nextSeason(now))!;
const weekLine = cur.stems.length
  ? `Week of ${dateLine}. Cutting now: ${cur.stems.slice(0, 4).join(', ').toLowerCase()} and more. Priced when we cut them.`
  : `Week of ${dateLine}. The beds are resting until ${nxt.from.replace('from ', '')}.`;
---
<Base
  title="Seasonal flowers grown in Moss Vale | Tiny Flower House"
  description="Tiny Flower House grows seasonal flowers on a Moss Vale nature strip and cuts bunches to order. See what is in the beds this week and request a bunch."
  ogImage={ogUrl}
>
  <Header slot="header" />

  <section data-section="hero" class="mx-auto max-w-6xl px-5 pt-10 md:pt-14">
    <p class="text-ink/70">{weekLine}</p>
    <h1 class="font-display text-2xl md:text-[2.6vw] leading-[1.25] mt-3">What is in the beds at the corner of North and East Street, Moss Vale.</h1>
  </section>
  <VergeBand />
  <SeasonCalendar compact bare />
  <BunchRequest />
  <WeddingsGifts />

  <Footer slot="footer" />
</Base>
