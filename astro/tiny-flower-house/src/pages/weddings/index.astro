---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import urnPale from '../../assets/wedding-urn-pale.jpg';
import urnBurgundy from '../../assets/wedding-urn-burgundy.jpg';
import table from '../../assets/wedding-table.jpg';
---
<Base
  title="Wedding and event flowers | Tiny Flower House, Moss Vale"
  description="Seasonal wedding and event flowers grown on the verge in Moss Vale and around the Southern Highlands. Tell Lisa the date and she plants for it."
>
  <Header slot="header" />
  <section data-section="page-hero" class="mx-auto max-w-6xl px-5 pt-12 md:pt-20">
    <h1 class="font-display text-3xl md:text-[2.6vw] leading-[1.25] max-w-3xl">Wedding and event flowers.</h1>
    <p class="mt-5 max-w-xl text-lg text-ink/80">Made from what is in season in the Southern Highlands. By enquiry.</p>
  </section>

  <section data-section="gallery" aria-label="Wedding flowers" class="mx-auto max-w-6xl px-5 mt-12 grid gap-4 md:grid-cols-12">
    <Picture src={table} widths={[640, 1024, 1400]} sizes="(min-width: 768px) 58vw, 100vw" formats={['avif', 'webp']} alt="Loose garden arrangement of dahlias, roses and foliage on a white table" pictureAttributes={{ class: "md:col-span-7 block" }} class="w-full h-full aspect-[4/3] object-cover" loading="eager" fetchpriority="high" />
    <Picture src={urnPale} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} alt="Pale pink and cream garden flowers in a footed urn" pictureAttributes={{ class: "md:col-span-5 block" }} class="w-full h-full aspect-[4/3] md:aspect-auto object-cover" loading="lazy" />
    <Picture src={urnBurgundy} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} alt="Burgundy and blush garden flowers arranged in a stone urn" pictureAttributes={{ class: "md:col-span-5 md:col-start-8 block" }} class="w-full aspect-[4/3] object-cover" loading="lazy" />
  </section>

  <section data-section="request" id="request" aria-labelledby="ask-h" class="mx-auto max-w-6xl px-5 mt-20 grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <h2 id="ask-h" class="font-display text-xl md:text-2xl">Ask about a date</h2>
      <p class="mt-4 text-ink/80">Tell us the date and the venue.</p>
    </div>
    <div class="md:col-span-3 md:pl-10 md:border-l md:border-ink/10">
      <EnquiryForm kind="wedding" site="Tiny Flower House" submitLabel="Ask about a date"
        successText="Thanks. Lisa will be in touch to talk about the day."
        fields={[
          { name: 'name', label: 'Your name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel', required: true },
          { name: 'email', label: 'Email', type: 'email' },
          { name: 'date', label: 'The date', required: true },
          { name: 'venue', label: 'Venue or town' },
          { name: 'notes', label: 'What you have in mind', type: 'textarea', placeholder: 'Bouquets, table flowers, an arch, colours you love' },
        ]} />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
