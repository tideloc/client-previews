---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import table from '../../assets/wedding-table.jpg';
import urnPale from '../../assets/wedding-urn-pale.jpg';
import handBunch from '../../assets/bunch-mauve.jpg';
import cream from '../../assets/close-cream.jpg';
import lace from '../../assets/lace-dried.jpg';
---
<Base
  title="Wedding and event flowers | Tiny Flower House, Moss Vale"
  description="Seasonal wedding and event flowers grown on the verge in Moss Vale and sourced around the Southern Highlands. By enquiry."
>
  <Header slot="header" />
  <PageHero image={table} alt="Loose garden arrangement of dahlias, roses and foliage on a white table" eyebrow="Weddings and events" title="Wedding and event flowers." line="Made from what is in season in the Southern Highlands. By enquiry." cta={{ href: '#request', label: 'Enquire now' }} position="50% 45%" />

  <section data-section="gallery" aria-label="Wedding flowers" class="mx-auto max-w-6xl px-5 mt-4 md:mt-6 grid gap-3 grid-cols-2 md:grid-cols-12">
    <Picture src={urnPale} widths={[640, 1024]} sizes="(min-width: 768px) 50vw, 50vw" formats={['avif', 'webp']} alt="Pale pink and cream garden flowers in a footed urn" pictureAttributes={{ class: 'md:col-span-6 block' }} class="w-full aspect-square object-cover" loading="lazy" />
    <Picture src={handBunch} widths={[480, 800]} sizes="(min-width: 768px) 25vw, 50vw" formats={['avif', 'webp']} alt="Hand-tied bunch of mauve stock, roses and lace held up in the workshop" pictureAttributes={{ class: 'md:col-span-3 block' }} class="w-full h-full aspect-[3/4] md:aspect-auto object-cover" loading="lazy" />
    <div class="md:col-span-3 grid gap-3">
      <Picture src={cream} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Cream and white garden flowers gathered close" class="w-full aspect-square object-cover" loading="lazy" />
      <Picture src={lace} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Queen Ann's lace and dried flower heads in soft light" class="w-full aspect-square object-cover" loading="lazy" />
    </div>
  </section>

  <section data-section="sourcing" class="bg-primary text-ground mt-16 md:mt-20">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-20 grid gap-8 md:grid-cols-12 md:items-center">
      <p class="md:col-span-8 font-display text-[6.5vw] md:text-[2.6vw] leading-[1.15]">All of our flowers are grown here on our premises in Moss Vale, sourced from within the Southern Highlands or within 50 kilometres of Moss Vale.</p>
      <p class="md:col-span-4 text-ground/90 text-lg">We use what is currently in season, so our bouquets are made up of the best seasonal flowers the Southern Highlands has to offer.</p>
    </div>
  </section>

  <section data-section="request" id="request" aria-labelledby="ask-h" class="mx-auto max-w-6xl px-5 mt-16 md:mt-20 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <h2 id="ask-h" class="font-display text-2xl md:text-3xl">Enquire now</h2>
      <p class="mt-4 text-ink/80 text-lg">Tell us the date and the venue.</p>
      <p class="mt-6 text-ink/80">Or ring Lisa on <a href="tel:+61417000547" class="underline underline-offset-4 font-semibold tabular-nums">0417 000 547</a>.</p>
    </div>
    <div class="md:col-span-7">
      <EnquiryForm kind="wedding" site="Tiny Flower House" submitLabel="Enquire now"
        successText="Thanks. Your enquiry has been sent to Tiny Flower House."
        fields={[
          { name: 'name', label: 'Your name', required: true },
          { name: 'phone', label: 'Phone', type: 'tel', required: true },
          { name: 'email', label: 'Email', type: 'email' },
          { name: 'date', label: 'The date', required: true },
          { name: 'venue', label: 'Venue or town' },
          { name: 'notes', label: 'What you have in mind', type: 'textarea', placeholder: 'Bouquets, table flowers, an arch, colours you love' },
        ]} />
    </div>
  </section>
  <Footer slot="footer" />
</Base>
