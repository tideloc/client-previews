---
/** Her own instruction, at scale, in the ink. The saturated move for inner pages. */
import { siteContent } from '../lib/site';
const phone = siteContent.contact.phone;
const tel = 'tel:+61' + phone.replace(/\D/g, '').replace(/^0/, '');
interface Props { tone?: 'ink' | 'sage' }
const { tone = 'ink' } = Astro.props;
---
<section data-section="call" class={tone === 'ink' ? 'bg-ink text-ground' : 'bg-primary text-ground'}>
  <div class="mx-auto max-w-6xl px-5 py-14 md:py-20 grid gap-8 md:grid-cols-12 md:items-center">
    <p class="md:col-span-7 font-display text-[7vw] md:text-[3vw] leading-[1.1]">Call us to find out what's in bloom this week!</p>
    <div class="md:col-span-5 md:text-right">
      <a href={tel} class="font-display text-[9vw] md:text-[3.4vw] tabular-nums leading-none text-secondary hover:underline underline-offset-8">{phone}</a>
      <p class="mt-3 text-ground/80">Workshop Wednesday to Friday 9 to 5, Saturday 9 to 12. Open for phone and online requests.</p>
    </div>
  </div>
</section>
