---
/** Full-bleed photo hero for inner pages: overlay, eyebrow fact, h1 claim, one line, CTA. */
import { Picture } from 'astro:assets';
interface Props { image: ImageMetadata; alt: string; eyebrow?: string; title: string; line?: string; cta?: { href: string; label: string }; position?: string; short?: boolean }
const { image, alt, eyebrow, title, line, cta, position = '50% 50%', short = false } = Astro.props;
---
<section data-section="hero" class={`relative ${short ? 'min-h-[56vh]' : 'min-h-[72vh]'} flex items-end overflow-hidden bg-ink`}>
  <Picture src={image} widths={[768, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} alt={alt}
    class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${position}`} pictureAttributes={{ class: 'absolute inset-0' }} loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/55 to-ink/15"></div>
  <div class="relative mx-auto max-w-6xl w-full px-5 pb-12 pt-28 md:pb-16 text-ground">
    {eyebrow && <p class="font-display text-sm tracking-[0.3em] text-ground flex items-center gap-3"><span class="inline-block w-8 h-[3px] bg-secondary"></span>{eyebrow}</p>}
    <h1 class="font-display mt-4 text-[9vw] md:text-[4vw] leading-[1.05] max-w-4xl">{title}</h1>
    {line && <p class="mt-5 max-w-xl text-lg md:text-xl text-ground/90">{line}</p>}
    {cta && <a href={cta.href} class="inline-block mt-7 bg-primary text-ground px-7 py-3.5 font-semibold">{cta.label}</a>}
  </div>
</section>
