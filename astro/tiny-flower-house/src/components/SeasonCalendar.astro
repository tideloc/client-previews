---
/** Her stem lists as a calendar. The current season is open; the next one shows as budding.
 *  Nothing is deleted when a season ends, the state changes. */
import { seasons, seasonFor, nextSeason, stateFor, stateLabel } from '../data/seasons';
interface Props { compact?: boolean; bare?: boolean }
const { compact = false, bare = false } = Astro.props;
const now = seasonFor(new Date());
const open = seasons.find((s) => s.key === now)!.stems.length ? now : nextSeason(now);
const dot: Record<string, string> = { cutting: 'bg-primary', budding: 'bg-secondary', resting: 'bg-ink/25' };
---
<section data-section="calendar" aria-label="In the beds" class={`mx-auto max-w-6xl px-5 ${bare ? "mt-10" : "mt-20 md:mt-28"}`}>
  {!bare && <div class="md:flex md:items-end md:justify-between gap-8">
    <h2 id="beds-h" class="font-display text-xl md:text-2xl">In the beds</h2>
    <p class="mt-3 md:mt-0 max-w-md text-ink/80">Grown on the nature strip at the corner of North and East Street and sourced within 50 km of Moss Vale. What is cut depends on the week.</p>
  </div>}

  <div role="tablist" aria-label="Season" class={`${bare ? "" : "mt-8"} flex gap-6 overflow-x-auto border-b border-ink/15 text-lg`}>
    {seasons.map((s) => (
      <button role="tab" type="button" id={`tab-${s.key}`} aria-selected={s.key === open} aria-controls={`panel-${s.key}`}
        class="pb-3 -mb-px border-b-2 border-transparent aria-selected:border-primary whitespace-nowrap font-display text-sm">
        {s.label}
      </button>
    ))}
  </div>

  {seasons.map((s) => {
    const state = stateFor(s.key, now);
    return (
      <div role="tabpanel" id={`panel-${s.key}`} aria-labelledby={`tab-${s.key}`} hidden={s.key !== open} class="pt-6">
        <p class="text-ink/70">{s.months}. {s.note}{s.stems.length ? ` Everything listed is ${stateLabel[state]}.` : ''}</p>
        {s.stems.length > 0 && (
          <ul class={`mt-5 grid gap-x-8 gap-y-2 ${compact ? 'sm:grid-cols-2 md:grid-cols-4' : 'sm:grid-cols-2 md:grid-cols-3'}`}>
            {s.stems.map((stem) => (
              <li class="border-b border-ink/10 py-1.5">{stem}</li>
            ))}
          </ul>
        )}
      </div>
    );
  })}
</section>
<script is:inline>
  document.querySelectorAll('[role="tablist"][aria-label="Season"]').forEach((list) => {
    list.querySelectorAll('[role="tab"]').forEach((tab) => tab.addEventListener('click', () => {
      list.querySelectorAll('[role="tab"]').forEach((t) => { t.setAttribute('aria-selected', 'false'); document.getElementById(t.getAttribute('aria-controls')).hidden = true; });
      tab.setAttribute('aria-selected', 'true'); document.getElementById(tab.getAttribute('aria-controls')).hidden = false;
    }));
  });
</script>
