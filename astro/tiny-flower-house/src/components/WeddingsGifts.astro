---
import { Picture } from 'astro:assets';
import urn from '../assets/wedding-urn-burgundy.jpg';
import gifts from '../assets/gifts-pureco.jpg';
import dried from '../assets/dried-hanging.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-section="weddings" aria-labelledby="wed-h" class="mx-auto max-w-6xl px-5 mt-20 md:mt-28 grid gap-10 md:grid-cols-12 md:items-end">
  <div class="md:col-span-7">
    <Picture src={urn} widths={[640, 1024, 1400]} sizes="(min-width: 768px) 56vw, 100vw" formats={['avif', 'webp']} alt="Burgundy and blush garden flowers arranged in a stone urn for a wedding table" class="w-full aspect-[4/3] object-cover" loading="lazy" />
    <h2 id="wed-h" class="font-display text-lg md:text-xl mt-6">Weddings and events</h2>
    <p class="mt-2 max-w-lg text-ink/80">Quoted after a conversation about the day, not from a list. <a href={`${base}/weddings/`} class="underline underline-offset-4">Ask about a date</a></p>
  </div>
  <div class="md:col-span-5 grid gap-6">
    <Picture src={gifts} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} alt="PURE and CO candles and tins on a timber shelf in the workshop" class="w-full aspect-[3/2] object-cover" loading="lazy" />
    <Picture src={dried} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} alt="Dried flower bunches hanging upside down in the workshop" class="w-full aspect-[3/2] object-cover" loading="lazy" />
    <div>
      <h2 class="font-display text-lg md:text-xl">Gifts and dried</h2>
      <p class="mt-2 text-ink/80">Australian made and owned gifts and hampers, the perfect accompaniment to one of our seasonal bouquets, and dried bunches that keep for months.</p>
    </div>
  </div>
</section>
