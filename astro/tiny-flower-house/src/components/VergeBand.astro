---
/** Photo mosaic of the verge and the workshop. Static grid, no horizontal scrolling. */
import { Picture } from 'astro:assets';
import dahlias from '../assets/verge-dahlias-house.jpg';
import cosmos from '../assets/verge-cosmos.jpg';
import foxgloves from '../assets/verge-foxgloves.jpg';
import strawflowers from '../assets/verge-strawflowers.jpg';
import shopfront from '../assets/shopfront.jpg';
import lace from '../assets/lace-dried.jpg';
---
<section data-section="band" aria-label="The verge" class="mx-auto max-w-6xl px-5 mt-14 grid gap-3 grid-cols-2 md:grid-cols-6">
  <Picture src={dahlias} widths={[640, 1024, 1400]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} alt="Peach dahlias flowering on the nature strip outside the house" pictureAttributes={{ class: 'col-span-2 md:col-span-3 md:row-span-2 block' }} class="w-full h-full aspect-[4/3] md:aspect-auto object-cover" loading="lazy" />
  <Picture src={cosmos} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="Cosmos flowering on the nature strip with the road behind" pictureAttributes={{ class: 'md:col-span-2 block' }} class="w-full aspect-[4/3] object-cover" loading="lazy" />
  <Picture src={foxgloves} widths={[480, 800]} sizes="17vw" formats={['avif', 'webp']} alt="Pink foxglove spikes growing in the verge bed" class="w-full h-full aspect-[4/3] md:aspect-auto object-cover" loading="lazy" />
  <Picture src={shopfront} widths={[480, 800]} sizes="25vw" formats={['avif', 'webp']} alt="The black cottage workshop with white French doors on North Street" pictureAttributes={{ class: 'md:col-span-2 block' }} class="w-full aspect-[4/3] object-cover" loading="lazy" />
  <Picture src={strawflowers} widths={[480, 800]} sizes="17vw" formats={['avif', 'webp']} alt="Pale pink strawflowers and asters in the verge bed in sunlight" class="w-full h-full aspect-[4/3] md:aspect-auto object-cover" loading="lazy" />
</section>
