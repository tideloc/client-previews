---
/**
 * Base layout: head meta, JSON-LD, live content kit, Tideloc bar.
 * Every page passes title + description; home passes ogImage + h1 lives in the page.
 * Values marked __TOKEN__ are replaced by the build from brand.json.
 */
import '../styles/global.css';
import LiveContent from '../components/tl/LiveContent.astro';
import LocalBusinessJsonLd from '../components/tl/LocalBusinessJsonLd.astro';
import Announcement from '../components/tl/Announcement.astro';
import TidelocBar from '../components/TidelocBar.astro';
import { siteContent } from '../lib/site';
import { getImage } from 'astro:assets';
import defaultOg from '../assets/verge-dahlias-house.jpg';

interface Props {
  title: string;
  description: string;
  ogImage?: string;      // absolute URL, 1200x630
  schemaType?: string;   // Florist, Electrician, Cafe ...
}
const { title, description, schemaType = 'Florist' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${site}${Astro.url.pathname}`;
const fallbackOg = await getImage({ src: defaultOg, width: 1200, height: 630, format: 'jpg' });
const ogImage = Astro.props.ogImage ?? `${site}${fallbackOg.src}`;
const palette = '#697E5D,#8CA87C,#FFF5EC,#33312F,#806C57'; // "#hex,#hex,..." from brand.json
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFF5EC" />
    <meta name="tl-palette" content={palette} />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteContent.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Lato:wght@300;400;700&display=swap" />
    <LiveContent />
    <LocalBusinessJsonLd type={schemaType} url={`${site}${base}/`} image={ogImage} />
  </head>
  <body class="min-h-screen bg-ground text-ink font-body antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ground focus:px-3 focus:py-2">Skip to content</a>
    <Announcement class="bg-primary text-ground text-sm text-center px-4 py-2" />
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <TidelocBar reasons={[
      'Your seasonal range stays on the site all year: stems change state instead of being deleted for winter',
      'Update the stems list, hours and the announcement yourself from a simple portal, live in minutes',
      'Bunch requests and wedding enquiries come straight to you, phone tappable on every page',
      'Search-ready: real page titles, sitemap and local business details built in',
    ]} />
    <script is:inline defer src={`${base}/tl-live.js`}></script>
  </body>
</html>
