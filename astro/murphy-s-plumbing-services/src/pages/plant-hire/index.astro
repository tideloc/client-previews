---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import PriceList from '../../components/tl/PriceList.astro';
import { alts } from '../../lib/photos';
import lead from '../../assets/plant-excavation-three-pipes.jpg';
import g1 from '../../assets/plant-kobelco-trench.jpg';
import g2 from '../../assets/plant-kobelco-reinforced-pit.jpg';
import g3 from '../../assets/plant-valve-lift.jpg';
import g4 from '../../assets/project-benched-excavation.jpg';
import g5 from '../../assets/project-trench-shoring.jpg';
import g6 from '../../assets/project-crane-riser.jpg';
import { enquiryHref } from '../../lib/links';
const photos = [
  { src: g1, file: 'plant-kobelco-trench.jpg' }, { src: g2, file: 'plant-kobelco-reinforced-pit.jpg' }, { src: g3, file: 'plant-valve-lift.jpg' },
  { src: g4, file: 'project-benched-excavation.jpg' }, { src: g5, file: 'project-trench-shoring.jpg' }, { src: g6, file: 'project-crane-riser.jpg' },
];
---
<Base title="Excavator wet and dry hire | Murphy's Plumbing Services" description="22-tonne and 5-tonne excavators for wet or dry hire on civil plumbing works, from an Illawarra-based crew of licensed plumbers and excavator operators.">
  <Header slot="header" />
  <section data-section="plant-lead" aria-labelledby="ph-h1" class="bg-primary text-ground">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-14 lg:py-20 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <p class="font-medium uppercase tracking-[0.22em] text-xs text-ground/70">Plant hire</p>
        <h1 id="ph-h1" class="mt-4 font-display text-5xl lg:text-7xl leading-[1.02]">22-tonne and 5-tonne excavators, wet or dry hire.</h1>
        <p class="mt-6 text-lg text-ground/85 max-w-xl">Large and small machines for all the civil plumbing works, run by excavator operators who are part of a licensed plumbing crew.</p>
        <a href={enquiryHref} class="mt-8 inline-block bg-ground text-ink font-medium tracking-[0.02em] px-6 py-3.5">Send a project enquiry</a>
      </div>
      <div class="lg:col-span-6">
        <Picture src={lead} widths={[640, 1024, 1600]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high"
          alt={alts['plant-excavation-three-pipes.jpg']} pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] lg:aspect-[5/4] object-cover" />
      </div>
    </div>
  </section>

  <section data-section="fleet" aria-labelledby="fleet-h2" class="bg-ground">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-16 lg:py-24 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-medium uppercase tracking-[0.22em] text-xs">The fleet</p>
        <h2 id="fleet-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Two machines, one crew.</h2>
        <p class="mt-5 text-ink/80">Our fleet includes a 22-tonne and a 5-tonne excavator, available for wet or dry hire, giving us the capability to manage even the most demanding projects efficiently.</p>
        <div class="mt-8 border-t-8 border-ink bg-secondary p-6">
          <PriceList sectionClass="" titleClass="font-medium uppercase tracking-[0.22em] text-xs mb-2" itemClass="grid grid-cols-[1fr_auto] gap-x-4 py-3 border-b border-accent" nameClass="font-display text-2xl leading-tight [&>span]:block [&>span]:font-body [&>span]:text-sm [&>span]:opacity-70" priceClass="font-medium text-sm pt-1.5 whitespace-nowrap" noteClass="" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <dl class="border-t border-ink">
          <div class="py-6 border-b border-accent grid sm:grid-cols-[9rem_1fr] gap-2">
            <dt class="font-display text-2xl">Wet hire</dt>
            <dd class="text-ink/80">The machine comes with one of our operators. Our operators are part of the plumbing crew.</dd>
          </div>
          <div class="py-6 border-b border-accent grid sm:grid-cols-[9rem_1fr] gap-2">
            <dt class="font-display text-2xl">Dry hire</dt>
            <dd class="text-ink/80">The machine on its own, for your operator and your program.</dd>
          </div>
          <div class="py-6 border-b border-accent grid sm:grid-cols-[9rem_1fr] gap-2">
            <dt class="font-display text-2xl">Vac operations</dt>
            <dd class="text-ink/80">We hold Vac Operations certification, alongside PE 100 installations, Electrofusion and Butt Welding.</dd>
          </div>
          <div class="py-6 border-b border-accent grid sm:grid-cols-[9rem_1fr] gap-2">
            <dt class="font-display text-2xl">With the pipework</dt>
            <dd class="text-ink/80">From deep trenching and manhole installations to treatment plant piping, the same crew can dig and lay.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section data-section="plant-photos" aria-labelledby="pp-h2" class="bg-secondary">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-16 lg:py-24">
      <h2 id="pp-h2" class="font-display text-3xl lg:text-4xl">The excavators at work</h2>
      <div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-3">
        {photos.map((p) => (
          <Picture src={p.src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 33vw, 50vw" alt={alts[p.file]} loading="lazy"
            pictureAttributes={{ class: 'block' }} class="w-full aspect-[4/5] object-cover" />
        ))}
      </div>
    </div>
  </section>
  <EnquiryBand compact heading="Need a machine on site, with or without our operator?" />
  <Footer slot="footer" />
</Base>
