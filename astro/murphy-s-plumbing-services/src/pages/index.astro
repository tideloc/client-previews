---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CapabilityLedger from '../components/CapabilityLedger.astro';
import PlantBand from '../components/PlantBand.astro';
import WeldingCerts from '../components/WeldingCerts.astro';
import ProjectsMosaic from '../components/ProjectsMosaic.astro';
import ForBuilders from '../components/ForBuilders.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
---
<Base title="Civil plumbing contractor, Illawarra | Murphy's Plumbing Services" description="Illawarra civil plumbing contractor. Large-scale water, sewer, stormwater and gas pipework, PE 100 welding and excavators for wet or dry hire.">
  <Header slot="header" />
  <Hero />
  <CapabilityLedger />
  <PlantBand />
  <WeldingCerts />
  <ProjectsMosaic />
  <ForBuilders />
  <EnquiryBand />
  <Footer slot="footer" />
</Base>
