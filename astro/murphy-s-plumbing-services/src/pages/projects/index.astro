---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnquiryBand from '../../components/EnquiryBand.astro';
import { alts, fileName } from '../../lib/photos';
const all = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.jpg', { eager: true });
const photos = Object.entries(all)
  .filter(([p]) => !/hero-|logo|mark/.test(p))
  .map(([p, m]) => ({ src: m.default, alt: alts[fileName(p)] ?? '', landscape: m.default.width > m.default.height }));
---
<Base title="Projects | Murphy's Plumbing Services" description="Photos from Murphy's Plumbing Services civil plumbing projects: Sydney Water infrastructure works, treatment plant piping, manholes and trenching.">
  <Header slot="header" />
  <section data-section="projects-lead" aria-labelledby="pr-h1" class="bg-ground">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 pt-14 lg:pt-20 pb-10 grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-8">
        <p class="font-medium uppercase tracking-[0.22em] text-xs">Projects</p>
        <h1 id="pr-h1" class="mt-4 font-display text-5xl lg:text-7xl leading-[1.02]">Our work across infrastructure projects.</h1>
      </div>
      <div class="lg:col-span-4 lg:pt-12 text-ink/80">
        <p>Recent projects include Sydney Water infrastructure works alongside small and medium civil plumbing jobs for builders and contractors.</p>
        <p class="mt-3">Take a look at our work showcasing the scale and precision of our industrial and civil plumbing projects. These images demonstrate the expertise, materials, and techniques we apply to deliver high-quality solutions for complex infrastructure needs.</p>
      </div>
    </div>
  </section>
  <section data-section="gallery" aria-label="Project photographs" class="bg-secondary">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-12 lg:py-16 grid grid-cols-2 md:grid-cols-4 gap-3">
      {photos.map((p) => (
        <figure class={p.landscape ? 'col-span-2' : 'col-span-1'}>
          <Picture src={p.src} widths={[480, 800, 1200]} formats={['avif', 'webp']} sizes={p.landscape ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'} alt={p.alt} loading="lazy"
            pictureAttributes={{ class: 'block' }} class={`w-full object-cover ${p.landscape ? 'aspect-[3/2]' : 'aspect-[3/4]'}`} />
          <figcaption class="mt-1.5 mb-3 text-xs text-ink/60">{p.alt}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <EnquiryBand compact heading="Have a project like these to price?" />
  <Footer slot="footer" />
</Base>
