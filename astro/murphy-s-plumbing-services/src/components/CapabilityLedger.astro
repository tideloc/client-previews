---
const scopes = [
  ['Water supply', 'Water supply pipework and treatment plant piping'],
  ['Sewage', 'Large-scale sewage pipework'],
  ['Stormwater', 'Stormwater systems'],
  ['Gas', 'Gas systems for civil infrastructure'],
  ['Deep trenching', 'Precise trenching and navigation around existing services'],
  ['Manhole installations', 'Manhole installations on civil infrastructure projects'],
  ['Treatment plant piping', 'Specialised piping inside treatment plants'],
];
const materials = ['PE 100 polyethylene', 'Ductile Iron Cement Lined (DICL)', 'Steel', 'Stainless steel press fit', 'Copper press fit', 'PVC', 'Concrete'];
---
<section data-section="capabilities" id="capabilities" aria-labelledby="cap-h2" class="bg-ground">
  <div class="mx-auto max-w-7xl px-5 lg:px-8 py-16 lg:py-24 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="font-medium uppercase tracking-[0.22em] text-xs">What we install</p>
      <h2 id="cap-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">Water, sewage, stormwater and gas. Deep trenching to treatment plant piping.</h2>
      <table class="mt-8 w-full border-t border-ink">
        <tbody>
          {scopes.map(([name, detail]) => (
            <tr class="border-b border-accent align-baseline">
              <th scope="row" class="py-3.5 pr-4 text-left font-display text-xl sm:text-2xl font-normal w-[45%]">{name}</th>
              <td class="py-3.5 text-ink/80">{detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="lg:col-span-4 lg:col-start-9">
      <p class="font-medium uppercase tracking-[0.22em] text-xs">Materials we weld and install</p>
      <ul class="mt-3 border-t border-ink">
        {materials.map((m) => <li class="py-3 border-b border-accent font-display text-xl">{m}</li>)}
      </ul>
      <p class="mt-6 text-ink/80">Every project is handled with precision and efficiency, even in challenging environments requiring precise trenching and navigation around existing services.</p>
    </div>
  </div>
</section>
