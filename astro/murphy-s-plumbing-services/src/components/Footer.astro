---
import ContactDetails from './tl/ContactDetails.astro';
import { base, nav, enquiryHref } from '../lib/links';
const year = new Date().getFullYear();
---
<footer class="bg-primary text-ground">
  <div class="mx-auto max-w-7xl px-5 lg:px-8 py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-display uppercase tracking-[0.22em] text-sm">Murphys Plumbing Services</p>
      <p class="mt-4 max-w-sm text-ground/80">Specialising in large-scale pipework for water, sewage, storm water, and gas projects.</p>
      <p class="mt-4 text-ground/80">Based in the Illawarra (NSW 2530). Working on Sydney Water infrastructure and civil projects.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-medium uppercase tracking-[0.22em] text-xs text-ground/60">Contact</p>
      <ContactDetails class="not-italic mt-3 space-y-1" linkClass="underline underline-offset-4 break-all" />
      <a href={enquiryHref} class="mt-5 inline-block bg-ground text-ink font-medium tracking-[0.02em] px-5 py-3">Send a project enquiry</a>
    </div>
    <div class="md:col-span-2">
      <p class="font-medium uppercase tracking-[0.22em] text-xs text-ground/60">Pages</p>
      <ul class="mt-3 space-y-1">
        <li><a href={`${base}/`} class="hover:underline">Home</a></li>
        {nav.map((n) => <li><a href={n.href} class="hover:underline">{n.label}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-medium uppercase tracking-[0.22em] text-xs text-ground/60">Registration</p>
      <ul class="mt-3 space-y-1 text-ground/90">
        <li>ABN 24 101 951 759</li>
        <li>Licence 521S</li>
        <li>Licence 142861C</li>
        <li>Murphy's Plumbing Services Pty Ltd</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ground/15">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-5 text-sm text-ground/60 flex flex-wrap justify-between gap-2">
      <span>&copy; {year} Murphy's Plumbing Services Pty Ltd</span>
      <span>Civil and industrial plumbing for infrastructure projects</span>
    </div>
  </div>
</footer>
