---
/** Designed data object: the plant list, from site.json priceList (portal-editable). */
import PriceList from './tl/PriceList.astro';
import { base } from '../lib/links';
---
<div class="bg-secondary text-ink p-6 sm:p-7 border-t-8 border-ink">
  <p class="font-medium uppercase tracking-[0.22em] text-xs">Plant for hire, wet or dry</p>
  <PriceList sectionClass="mt-4" titleClass="sr-only" itemClass="grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5 py-3 border-b border-accent" nameClass="font-display text-2xl leading-tight [&>span]:block [&>span]:font-body [&>span]:text-sm [&>span]:opacity-70 [&>span]:mt-0.5" priceClass="font-medium text-sm whitespace-nowrap pt-1.5" noteClass="" />
  <p class="mt-4 text-sm">Licensed plumbers and excavator operators on the crew. Machines go out with an operator or on their own.</p>
  <a href={`${base}/plant-hire/`} class="mt-3 inline-block font-medium underline underline-offset-4">Plant hire details</a>
</div>
