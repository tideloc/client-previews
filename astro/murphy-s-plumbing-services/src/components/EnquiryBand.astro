---
import EnquiryForm from './EnquiryForm.astro';
import { email, enquiryHref, btnOnDark } from '../lib/links';
const { heading = 'Ready to start your next infrastructure project?', compact = false } = Astro.props;
---
{compact ? (
  <section data-section="enquiry-cta" aria-labelledby="enq-h2" class="bg-primary text-ground">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-14 lg:py-16 flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-2xl">
        <p class="font-medium uppercase tracking-[0.22em] text-xs text-ground/70">Project enquiry</p>
        <h2 id="enq-h2" class="mt-3 font-display text-3xl lg:text-4xl leading-tight">{heading}</h2>
      </div>
      <div class="flex flex-wrap items-center gap-5">
        <a href={enquiryHref} class={btnOnDark}>Send a project enquiry</a>
        <a href={`mailto:${email}`} class="underline underline-offset-4 break-all">{email}</a>
      </div>
    </div>
  </section>
) : (
  <section data-section="enquiry" id="enquiry" aria-labelledby="enq-h2" class="bg-secondary border-t-8 border-primary">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-16 lg:py-24 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-medium uppercase tracking-[0.22em] text-xs">Project enquiry</p>
        <h2 id="enq-h2" class="mt-3 font-display text-4xl lg:text-5xl leading-tight">{heading}</h2>
        <p class="mt-5 text-ink/80">We're ready to discuss your next project. Send through the scope, the materials and the program, or email us directly.</p>
        <a href={`mailto:${email}`} class="mt-4 inline-block font-medium underline underline-offset-4 break-all">{email}</a>
        <ul class="mt-8 border-t border-ink text-sm">
          <li class="py-3 border-b border-accent">Wet or dry hire of the 22-tonne and 5-tonne excavators</li>
          <li class="py-3 border-b border-accent">PE 100 electrofusion and butt welding, steel and DICL, press fit</li>
          <li class="py-3 border-b border-accent">Water, sewage, stormwater and gas pipework, trenching, manholes, treatment plant piping</li>
        </ul>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <EnquiryForm kind="quote" site="Murphy's Plumbing Services" submitLabel="Send project enquiry"
          successText="Thanks, we have your enquiry and will come back to you by email."
          class="grid gap-4 sm:grid-cols-2"
          inputClass="w-full border border-ink/30 bg-ground px-3 py-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          buttonClass="bg-primary text-ground font-medium tracking-[0.02em] px-6 py-3.5 hover:bg-ink"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'company', label: 'Company' },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'phone', label: 'Phone', type: 'tel' },
            { name: 'location', label: 'Project location' },
            { name: 'program', label: 'Start date or program' },
            { name: 'scope', label: 'Scope, materials and plant needed', type: 'textarea', required: true },
          ]} />
      </div>
    </div>
  </section>
)}
<style>
  [data-enquiry-form] > div:has(textarea), [data-enquiry-form] > div:last-child { grid-column: 1 / -1; }
</style>
