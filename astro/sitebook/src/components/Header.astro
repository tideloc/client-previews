---
import { CAL_URL, BOOK_LABEL } from '../lib/links';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: `${base}/product/`, label: 'Product', key: '/product/' },
  { href: `${base}/explore/`, label: 'Explore the app', key: '/explore/' },
  { href: `${base}/pricing/`, label: 'Pricing', key: '/pricing/' },
  { href: `${base}/who-we-are/`, label: 'Who we are', key: '/who-we-are/' },
  { href: `${base}/contact/`, label: 'Contact', key: '/contact/' },
];
---
<header class="sticky top-0 z-30 bg-ground border-b border-rule" data-section="header">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
    <a href={`${base}/`} class="flex items-center gap-3 shrink-0" aria-label="Centrebook home">
      <img src={`${base}/mark.svg`} alt="" width="32" height="32" class="h-8 w-8 rounded-sm" />
      <span class="display text-[22px] leading-none tracking-[-0.01em]">Centrebook</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {nav.map((n) => (
          <li><a href={n.href} class={`text-[15px] py-2 border-b-2 ${path.startsWith(n.key) ? 'border-ink text-ink font-medium' : 'border-transparent text-ink-2 hover:text-ink'}`} aria-current={path.startsWith(n.key) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={CAL_URL} class="btn-outline hidden sm:inline-flex" target="_blank" rel="noreferrer">{BOOK_LABEL}</a>
      <button type="button" class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-sm border border-rule" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" data-menu-btn>
        <span class="block w-5 border-t-2 border-ink relative before:absolute before:-top-2 before:left-0 before:w-5 before:border-t-2 before:border-ink after:absolute after:top-1 after:left-0 after:w-5 after:border-t-2 after:border-ink"></span>
      </button>
    </div>
  </div>
  <div id="mobile-nav" hidden class="lg:hidden border-t border-rule bg-ground">
    <ul class="px-5 py-3 grid">
      {nav.map((n) => (<li><a href={n.href} class="block py-3 text-[15px] border-b border-rule">{n.label}</a></li>))}
      <li class="pt-4 pb-2 sm:hidden"><a href={CAL_URL} class="btn-outline w-full" target="_blank" rel="noreferrer">{BOOK_LABEL}</a></li>
    </ul>
  </div>
</header>
<script is:inline>
  (function(){var b=document.querySelector('[data-menu-btn]'),m=document.getElementById('mobile-nav');if(!b||!m)return;b.addEventListener('click',function(){var o=m.hidden;m.hidden=!o;b.setAttribute('aria-expanded',String(o));b.setAttribute('aria-label',o?'Close menu':'Open menu');});})();
</script>
