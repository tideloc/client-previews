---
/** Book a call band: plain Ink, the claim and the one filled button left, one object right. The object varies per page:
 *  plan = a crop of the demo's Ridgeway Fair ground plan with one seed pin, DB-12 (home); chips = a crop of the same plan
 *  with three seed pins tagged DB-02, HYD-02 and FIP-01 (product). Both sit on a white sheet card so the plan reads on Ink;
 *  price = the big mono $18 figure (pricing); quote = the origin line with the founder credit (who we are);
 *  segmented = the Desktop / Phone control glyph (explore); none = words and button only. No background grid. */
import { CAL_URL, BOOK_LABEL } from '../lib/links';
import { siteContent } from '../lib/site';
import PlanGrid from './PlanGrid.astro';
type Variant = 'plan' | 'chips' | 'price' | 'quote' | 'segmented' | 'none';
interface Props { heading?: string; body?: string; email?: boolean; object?: Variant }
const {
  heading = 'Talk it through on a call',
  body = 'A short call to see whether Sitelore fits your sites, and what capture would look like for one of them.',
  email = false,
  object = 'plan',
} = Astro.props;
---
<section data-section="cta" data-object={object} aria-labelledby="cta-h" class="bg-ink text-ground">
  <div class={`mx-auto max-w-wrap px-5 sm:px-8 py-16 lg:py-20 grid gap-10 ${object === 'none' ? '' : 'lg:grid-cols-12 lg:items-center'}`}>
    <div class={object === 'none' ? '' : 'lg:col-span-8'}>
      <h2 id="cta-h" class="text-4xl sm:text-5xl lg:text-6xl leading-[0.98] tracking-[-0.02em] max-w-[16ch]">{heading}</h2>
      <p class="mt-5 text-ground/80 text-[17px] max-w-[36rem]">{body}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={CAL_URL} class="btn-primary text-base" target="_blank" rel="noreferrer">{BOOK_LABEL}</a>
        {email && <a href={`mailto:${siteContent.contact.email}`} class="mono-tag text-xs text-ground/80 underline underline-offset-4">{siteContent.contact.email}</a>}
      </div>
    </div>

    {object === 'plan' && (
      <div class="lg:col-span-4 lg:justify-self-end w-full max-w-[22rem]" aria-hidden="true">
        <PlanGrid sheet crop={[600, 500, 630, 420]} cols="bottom" rows={false} pins={[{ tag: 'DB-12', chip: true }]} />
      </div>
    )}

    {object === 'chips' && (
      <div class="lg:col-span-4 lg:justify-self-end w-full max-w-[22rem]">
        <PlanGrid sheet crop={[880, 70, 705, 470]} pins={[
          { tag: 'DB-02', chip: true }, { tag: 'HYD-02', chip: true }, { tag: 'FIP-01', chip: true, side: 'left' },
        ]} />
      </div>
    )}

    {object === 'price' && (
      <p class="lg:col-span-4 lg:justify-self-end flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span class="font-mono tabular leading-[0.85] tracking-[-0.04em] text-[96px] sm:text-[128px]">$18</span>
        <span class="mono-tag text-xs text-ground/70 max-w-[9rem] leading-[1.4]">per asset captured on site</span>
      </p>
    )}

    {object === 'quote' && (
      <figure class="lg:col-span-4 lg:justify-self-end w-full max-w-[24rem] border-l border-rule-dark pl-6">
        <blockquote class="display text-2xl sm:text-3xl leading-[1.05] tracking-[-0.015em]">The record-keeping existed because a standard required it. The rest of the asset base had no such record.</blockquote>
        <figcaption class="mt-4 mono-tag text-xs text-ground/70">Blake Hutchison, founder</figcaption>
      </figure>
    )}

    {object === 'segmented' && (
      <div class="lg:col-span-4 lg:justify-self-end" aria-hidden="true">
        <div class="inline-flex rounded-sm border border-rule-dark p-1">
          <span class="mono-tag text-xs px-4 py-2 rounded-tag bg-ground text-ink">Desktop</span>
          <span class="mono-tag text-xs px-4 py-2 rounded-tag text-ground/70">Phone</span>
        </div>
      </div>
    )}
  </div>
</section>
