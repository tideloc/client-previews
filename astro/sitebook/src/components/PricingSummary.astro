---
/** The rate card, from the portal price list (site.json), rendered through the kit so it stays editable. Pricing page only;
 *  the home page carries the designed price object instead (PricingObject.astro). */
import PriceList from './tl/PriceList.astro';
import TagChip from './TagChip.astro';
---
<section data-section="pricing" aria-labelledby="pr-h" class="border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20 grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <TagChip label="Pricing" />
      <h2 id="pr-h" class="mt-4 text-4xl sm:text-5xl leading-[0.98] tracking-[-0.02em]">Rate card</h2>
      <p class="mt-5 text-[17px] leading-[1.5] max-w-[28rem]">Indicative, ex GST. Capture is one-off and per asset; the subscription is per site per month, by tier.</p>
    </div>
    <div>
      <PriceList
        sectionClass="mb-8 last:mb-0"
        titleClass="mono-tag text-xs text-ink-2 pb-2 border-b border-ink"
        itemClass="flex items-baseline justify-between gap-6 py-3 border-b border-rule"
        nameClass="text-[15px]"
        priceClass="font-mono tabular whitespace-nowrap text-[15px]"
        noteClass="text-ink-2 text-[13px]"
      />
    </div>
  </div>
</section>
