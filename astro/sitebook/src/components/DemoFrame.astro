---
/**
 * The live demo in ONE iframe with a Desktop / Phone segmented control above it.
 * Switching changes the wrapper's classes and the iframe's width and height only; the src is never touched.
 * Desktop: full-width frame (hero: fixed height; explore: min-height 80vh). Phone: a 390 x 780 device frame
 * (1px Rule border, 24px radius, 24px Ink top bar with a light notch) holding the iframe at 390 x 756.
 * Default is Desktop at 1024px and above, Phone below. Plain JS, no framework.
 */
import { APP_SIGN_IN } from '../lib/links';
interface Props { variant?: 'hero' | 'explore'; class?: string; src?: string }
const { variant = 'hero', class: cls = '', src = APP_SIGN_IN } = Astro.props;
const desktopClass = variant === 'hero'
  ? 'relative w-full h-[560px] md:h-[640px] lg:h-[720px] bg-card'
  : 'relative w-full min-h-[max(80vh,800px)] rounded-lg border border-rule bg-card overflow-hidden';
const phoneClass = 'relative mx-auto w-full max-w-[390px] rounded-[24px] border border-rule bg-card overflow-hidden';
const desktopStyle = variant === 'hero' ? 'height:100%' : 'height:max(80vh,800px)';
---
<div class={cls} data-demo-frame>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3">
    <div role="group" aria-label="Demo view" class="inline-flex rounded-sm border border-rule bg-card p-0.5">
      <button type="button" class="seg" data-view="desktop" aria-pressed="true">Desktop</button>
      <button type="button" class="seg" data-view="phone" aria-pressed="false">Phone</button>
    </div>
    <p class="text-[13px] leading-[18px] text-ink-2">The demo is the real app. Phone view shows the bottom tabs and capture flow.</p>
  </div>
  <div data-frame class={desktopClass} data-desktop-class={desktopClass} data-phone-class={phoneClass} data-desktop-style={desktopStyle}>
    <div data-bar class="h-6 bg-ink items-center justify-center" style="display:none" aria-hidden="true">
      <span class="block w-14 h-1.5 rounded-full bg-ground/70"></span>
    </div>
    <iframe src={src} title="Sitebook demo" loading="lazy" allow="clipboard-write" width="100%" class="block w-full" style={`border:0;${desktopStyle}`}></iframe>
  </div>
</div>
<script is:inline>
  (function () {
    var roots = document.querySelectorAll('[data-demo-frame]');
    for (var i = 0; i < roots.length; i++) (function (root) {
      var frame = root.querySelector('[data-frame]');
      var bar = root.querySelector('[data-bar]');
      var ifr = root.querySelector('iframe');
      var btns = root.querySelectorAll('[data-view]');
      if (!frame || !bar || !ifr) return;
      function set(view) {
        var phone = view === 'phone';
        frame.className = phone ? frame.getAttribute('data-phone-class') : frame.getAttribute('data-desktop-class');
        bar.style.display = phone ? 'flex' : 'none';
        if (phone) {
          ifr.setAttribute('width', '390');
          ifr.setAttribute('height', '756');
          ifr.style.cssText = 'border:0;width:100%;height:756px';
        } else {
          ifr.setAttribute('width', '100%');
          ifr.removeAttribute('height');
          ifr.style.cssText = 'border:0;width:100%;' + frame.getAttribute('data-desktop-style');
        }
        for (var j = 0; j < btns.length; j++) btns[j].setAttribute('aria-pressed', String(btns[j].getAttribute('data-view') === view));
      }
      for (var k = 0; k < btns.length; k++) btns[k].addEventListener('click', function () { set(this.getAttribute('data-view')); });
      set(window.innerWidth >= 1024 ? 'desktop' : 'phone');
    })(roots[i]);
  })();
</script>
