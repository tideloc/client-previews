---
/** The six handover steps, verbatim from the concept note, as one ruled ordered list in a single Ink strip.
 *  Each row: number in mono, step name in display type, one short line drawn from the inventory's holdings. No boxes, no giant numerals. */
const steps = [
  { t: 'Freeze a revision', d: 'The site record as it stands, held as one version for the handover.' },
  { t: 'Close the gaps', d: 'Assets missing a photo, a tag or a grid reference get them.' },
  { t: "Write down what isn't an asset", d: 'Who to call, after-hours, radio call signs, emergency codes and isolation points.' },
  { t: 'Walk the site together', d: 'Outgoing and incoming, with the floor plate.' },
  { t: 'Hand over the packs', d: 'The printable handover pack for the manager, the transition pack for the contractor.' },
  { t: 'Confirm and sign off', d: 'The incoming person confirms what they were handed.' },
];
---
<section data-section="how-handover-works" aria-labelledby="hh-h" class="bg-ink text-ground">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20">
    <div class="grid gap-4 lg:grid-cols-12 lg:items-end">
      <h2 id="hh-h" class="lg:col-span-7 text-4xl sm:text-5xl lg:text-6xl leading-[0.96] tracking-[-0.02em]">How handover works</h2>
      <p class="lg:col-span-5 text-[17px] leading-[1.5] text-ground/80">When a manager leaves or a contract changes hands, the site should not leave with them. Six steps, in this order.</p>
    </div>
    <ol class="mt-10 border-t border-ground/60">
      {steps.map((s, i) => (
        <li class="grid grid-cols-[3rem_minmax(0,1fr)] sm:grid-cols-[5rem_minmax(0,7fr)_minmax(0,5fr)] gap-x-4 gap-y-1 sm:gap-x-8 items-baseline py-5 sm:py-6 border-b border-rule-dark">
          <span class="mono-tag text-xs text-ground/60 tabular">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl leading-[1.02] tracking-[-0.015em]"><span class="sr-only">Step {i + 1}: </span>{s.t}</h3>
          <p class="col-start-2 sm:col-start-3 text-ground/80 text-[15px] leading-[1.45]">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
