---
/** A drawn floor plate with grid references and Marker pins: the product's own device, not a photograph.
 *  Pins are decorative shapes; the real map lives in the app. */
interface Props { class?: string; dark?: boolean; pins?: number }
const { class: cls = '', dark = false, pins = 6 } = Astro.props;
const ink = dark ? '#F6F7F9' : '#16213A';
const rule = dark ? 'rgba(246,247,249,0.25)' : '#D9DEE7';
const cols = ['A','B','C','D','E','F','G','H'];
const rows = [1,2,3,4,5,6];
const spots = [[2.4,1.6],[4.7,2.3],[6.3,1.4],[1.6,4.2],[5.2,4.7],[7.3,3.6],[3.4,3.1],[6.8,5.4]].slice(0, pins);
---
<svg viewBox="0 0 880 620" class={cls} role="img" aria-label={`Drawn floor plate with grid references A to H and 1 to 6 and ${pins === 1 ? "one orange asset pin" : "orange asset pins"}`} xmlns="http://www.w3.org/2000/svg">
  <rect x="0.5" y="0.5" width="879" height="619" fill="none" stroke={rule} />
  {cols.map((c, i) => (<text x={60 + i * 100 + 50} y="28" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" fill={ink} opacity="0.7">{c}</text>))}
  {rows.map((r, i) => (<text x="30" y={40 + i * 95 + 52} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" fill={ink} opacity="0.7">{r}</text>))}
  {cols.map((_, i) => (<line x1={60 + i * 100} y1="40" x2={60 + i * 100} y2="610" stroke={rule} stroke-dasharray="3 5" />))}
  {rows.map((_, i) => (<line x1="60" y1={40 + i * 95} x2="860" y2={40 + i * 95} stroke={rule} stroke-dasharray="3 5" />))}
  <g fill="none" stroke={ink} stroke-width="2">
    <rect x="120" y="80" width="330" height="220" />
    <rect x="470" y="80" width="360" height="140" />
    <rect x="470" y="240" width="170" height="130" />
    <rect x="660" y="240" width="170" height="130" />
    <rect x="120" y="330" width="220" height="230" />
    <rect x="360" y="400" width="470" height="160" />
    <path d="M340 400 H360 M450 300 V330 H360" />
  </g>
  <g fill="none" stroke={ink} stroke-width="1" opacity="0.6">
    <path d="M140 300 h40 M180 300 a40 40 0 0 0 -40 -40" />
    <path d="M820 220 h-30 M790 220 a30 30 0 0 1 30 -30" />
    <path d="M360 560 h40 M400 560 a40 40 0 0 0 -40 -40" />
  </g>
  {spots.map(([cx, cy]) => (
    <g>
      <circle cx={60 + cx * 100} cy={40 + cy * 95} r="9" fill="#F26B1D" stroke={dark ? '#16213A' : '#F6F7F9'} stroke-width="2" />
    </g>
  ))}
  <g font-family="IBM Plex Mono, monospace" font-size="11" fill={dark ? '#16213A' : '#F6F7F9'}>
    {pins >= 1 && (<rect x={60 + 2.4 * 100 + 14} y={40 + 1.6 * 95 - 10} width="58" height="20" rx="3" fill={ink} />)}
    {pins >= 1 && (<text x={60 + 2.4 * 100 + 43} y={40 + 1.6 * 95 + 4} text-anchor="middle">DB-03</text>)}
    {pins >= 5 && (<rect x={60 + 5.2 * 100 + 14} y={40 + 4.7 * 95 - 10} width="62" height="20" rx="3" fill={ink} />)}
    {pins >= 5 && (<text x={60 + 5.2 * 100 + 45} y={40 + 4.7 * 95 + 4} text-anchor="middle">AHU-12</text>)}
  </g>
</svg>
