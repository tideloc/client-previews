---
/** A real floor plan from the Sitebook demo with Marker pins at the seed's own asset coordinates.
 *  The drawing is the app's plan image; pins and tag chips are HTML on top so they stay legible at any width.
 *  Optional A to H / 1 to 6 grid reference strips line up with the plan's own grid (8 x 6).
 *  crop = [x, y, width, height] in plan pixels for a fragment. sheet = white card, for placing on Ink. */
import { RIDGEWAY_G, ridgewayPin, type PlanDef } from '../lib/plans';
type Side = 'right' | 'left' | 'below';
interface PinSpec { tag: string; chip?: boolean; side?: Side }
interface Props {
  class?: string;
  plan?: PlanDef;
  pins: PinSpec[];
  crop?: [number, number, number, number];
  cols?: 'top' | 'bottom' | 'none';
  rows?: boolean;
  footer?: [string, string];
  sheet?: boolean;
  label?: string;
}
const {
  class: cls = '', plan = RIDGEWAY_G, pins, crop, cols = 'top', rows = true, footer, sheet = false, label,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [x0, y0, cw, ch] = crop ?? [0, 0, plan.width, plan.height];
const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;

const letters = 'ABCDEFGHIJKL'.slice(0, plan.cols).split('');
const colW = plan.width / plan.cols;
const rowH = plan.height / plan.rows;
// Label each grid band at the centre of its visible part; skip bands mostly outside a crop.
const band = (i: number, size: number, start: number, span: number) => {
  const a = Math.max(i * size, start);
  const b = Math.min((i + 1) * size, start + span);
  return b - a > size * 0.4 ? ((a + b) / 2 - start) / span : null;
};
const colLabels = letters.map((l, i) => ({ l, at: band(i, colW, x0, cw) })).filter((c) => c.at !== null);
const rowLabels = Array.from({ length: plan.rows }, (_, i) => ({ l: String(i + 1), at: band(i, rowH, y0, ch) })).filter((r) => r.at !== null);

const placed = pins.map((p) => {
  const s = ridgewayPin(p.tag);
  return { ...p, ...s, left: (s.x * plan.width - x0) / cw, top: (s.y * plan.height - y0) / ch };
});
// Chip beside the pin (default right) so it lands in open floor rather than on a room name; 'below' matches the app's label.
const chipPos: Record<Side, (l: string, t: string) => string> = {
  right: (l, t) => `left:calc(${l} + 13px);top:${t};transform:translateY(-50%)`,
  left: (l, t) => `left:calc(${l} - 13px);top:${t};transform:translate(-100%,-50%)`,
  below: (l, t) => `left:${l};top:calc(${t} + 11px);transform:translateX(-50%)`,
};
const chipped = placed.filter((p) => p.chip).map((p) => p.tag);
const aria = label ?? `${plan.site}, ${plan.level.toLowerCase()} floor plan from the Sitebook demo, ${placed.length === 1 ? 'one asset pinned' : `${placed.length} assets pinned`}${chipped.length ? `, tagged ${chipped.join(', ')}` : ''}`;
const strip = 'mono-tag text-[11px] leading-none text-ink-2';
---
<figure class={`${sheet ? 'rounded-md bg-card p-2 sm:p-3' : ''} ${cls}`} role="img" aria-label={aria} data-plan={plan.file}>
  <div class={`grid ${rows ? 'grid-cols-[1.125rem_minmax(0,1fr)] sm:grid-cols-[1.5rem_minmax(0,1fr)]' : 'grid-cols-1'}`}>
    {cols === 'top' && rows && <span aria-hidden="true"></span>}
    {cols === 'top' && (
      <div class="relative h-5" aria-hidden="true">
        {colLabels.map((c) => (<span class={`absolute top-0.5 -translate-x-1/2 ${strip}`} style={`left:${pct(c.at!)}`}>{c.l}</span>))}
      </div>
    )}
    {rows && (
      <div class="relative" aria-hidden="true">
        {rowLabels.map((r) => (<span class={`absolute left-0 -translate-y-1/2 ${strip}`} style={`top:${pct(r.at!)}`}>{r.l}</span>))}
      </div>
    )}
    <div class="relative overflow-hidden rounded-sm border border-rule bg-[#F7F8FA]" style={`aspect-ratio:${cw} / ${ch}`}>
      <img
        src={`${base}/${plan.file}`}
        alt=""
        width={plan.width}
        height={plan.height}
        loading="eager"
        decoding="async"
        draggable="false"
        class="absolute max-w-none select-none"
        style={`width:${pct(plan.width / cw)};height:auto;left:${pct(-x0 / cw)};top:${pct(-y0 / ch)}`}
      />
      {placed.map((p) => (
        <span
          class="absolute block size-3 sm:size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary"
          style={`left:${pct(p.left)};top:${pct(p.top)};box-shadow:0 0 0 2px #F6F7F9, 0 1px 3px 1px rgb(22 33 58 / 0.4)`}
          aria-hidden="true"
        ></span>
      ))}
      {placed.filter((p) => p.chip).map((p) => (
        <span
          class="tag absolute text-[10px] leading-[14px] px-[7px] py-[3px] sm:text-[11px]"
          style={chipPos[p.side ?? 'right'](pct(p.left), pct(p.top))}
          aria-hidden="true"
        >{p.tag}</span>
      ))}
    </div>
    {cols === 'bottom' && rows && <span aria-hidden="true"></span>}
    {cols === 'bottom' && (
      <div class="relative h-5" aria-hidden="true">
        {colLabels.map((c) => (<span class={`absolute bottom-0.5 -translate-x-1/2 ${strip}`} style={`left:${pct(c.at!)}`}>{c.l}</span>))}
      </div>
    )}
  </div>
  {footer && (
    <div class={`mt-2 flex justify-between gap-4 ${strip} ${rows ? 'pl-[1.125rem] sm:pl-6' : ''}`} aria-hidden="true">
      <span>{footer[0]}</span><span>{footer[1]}</span>
    </div>
  )}
</figure>
