---
/** Home page pricing as one designed price object: the big mono $18 figure, the three subscription tiers as a compact
 *  horizontal strip beneath, one sentence and a link to the pricing page. Figures from the inventory rate card (2026-09-06). */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tiers = [
  { name: 'Small retail, office tower or logistics region', price: '$150' },
  { name: 'Regional centre', price: '$300' },
  { name: 'Super-regional or CBD', price: '$500' },
];
---
<section data-section="pricing" aria-labelledby="pr-h" class="border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20">
    <h2 id="pr-h" class="text-4xl sm:text-5xl lg:text-6xl leading-[0.96] tracking-[-0.02em] max-w-[18ch]">Capture once, then a subscription per site</h2>
    <div class="mt-10 border-t-2 border-ink pt-8 grid gap-8 lg:grid-cols-12 lg:items-end">
      <p class="lg:col-span-7 flex flex-wrap items-baseline gap-x-5 gap-y-1">
        <span class="font-mono tabular leading-[0.85] tracking-[-0.04em] text-[112px] sm:text-[160px] lg:text-[200px]">$18</span>
        <span class="mono-tag text-xs text-ink-2 max-w-[11rem] leading-[1.4]">per asset captured on site</span>
      </p>
      <p class="lg:col-span-5 text-[17px] leading-[1.5] max-w-[26rem]">Indicative, ex GST, with a minimum of 150 assets on site, or $12 per asset where a register already exists. <a href={`${base}/pricing/`} class="underline underline-offset-4 whitespace-nowrap">Full pricing</a></p>
    </div>
    <dl class="mt-10 grid sm:grid-cols-[auto_1fr_1fr_1fr] border-t border-rule">
      <div class="py-4 sm:pr-8 mono-tag text-xs text-ink-2 self-center">Then, per site per month</div>
      {tiers.map((t, i) => (
        <div class={`py-4 flex items-baseline justify-between gap-4 border-t border-rule sm:border-t-0 ${i > 0 ? 'sm:border-l sm:pl-6' : 'sm:border-l sm:pl-6'} sm:pr-6`}>
          <dt class="text-[15px] leading-[1.35]">{t.name}</dt>
          <dd class="font-mono tabular text-2xl sm:text-3xl leading-none whitespace-nowrap">{t.price}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
