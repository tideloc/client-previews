---
/** The designed data object: a drawing title block of the demo portfolio's pinned asset counts. Five sites plus the portfolio total,
 *  3 x 2 from md, 2 x 3 on phones. Cells are separated by 1px gaps on the Rule Dark ground so the grid stays ruled at every count;
 *  #1C2742 is the old Ink Raised at 40% over Ink, made solid so the gaps read as rules. */
import { DEMO_SITES, DEMO_TOTAL, DEMO_LEVELS, DEMO_SITE_COUNT, fmt } from '../lib/links';
---
<section data-section="portfolio-count" aria-labelledby="pc-h" class="bg-ink text-ground">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-8 lg:py-10 grid gap-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-end">
    <div>
      <p class="mono-tag text-xs text-ground/60">Demo portfolio, Harbourline Property</p>
      <h2 id="pc-h" class="mt-2 text-3xl sm:text-4xl leading-none tracking-[-0.015em]">Assets pinned in the demo</h2>
      <p class="mt-3 text-ground/80 max-w-sm">Five invented sites, seeded from the product. Two of them, Wattleford Central and Brindle Park, are drawn on layouts derived from real centres in OpenStreetMap, with invented names and data. Each asset has a photo, a tag and a grid reference on its floor plate.</p>
    </div>
    <dl class="grid grid-cols-2 md:grid-cols-3 gap-px bg-rule-dark border border-rule-dark rounded-sm overflow-hidden">
      {DEMO_SITES.map((s) => (
        <div class="p-4 lg:p-5 bg-[#1C2742]">
          <dt class="display text-2xl leading-tight">{s.name}</dt>
          <dd class="mono-tag text-xs text-ground/60 mt-1">{s.kind}</dd>
          <dd class="mono-tag text-xs text-ground/60">{s.levels} levels</dd>
          <dd class="mt-3 font-mono tabular text-4xl lg:text-5xl leading-none">{fmt(s.assets)}</dd>
          <dd class="mono-tag text-xs text-ground/60 mt-1">assets pinned</dd>
        </div>
      ))}
      <div class="p-4 lg:p-5 bg-ink-raised">
        <dt class="display text-2xl leading-tight flex items-center gap-2"><span class="inline-block w-3 h-3 rounded-full bg-primary ring-2 ring-ink" aria-hidden="true"></span>Portfolio</dt>
        <dd class="mono-tag text-xs text-ground/60 mt-1">{DEMO_SITE_COUNT}</dd>
        <dd class="mono-tag text-xs text-ground/60">{DEMO_LEVELS} levels</dd>
        <dd class="mt-3 font-mono tabular text-4xl lg:text-5xl leading-none">{fmt(DEMO_TOTAL)}</dd>
        <dd class="mono-tag text-xs text-ground/60 mt-1">assets pinned</dd>
      </div>
    </dl>
  </div>
</section>
