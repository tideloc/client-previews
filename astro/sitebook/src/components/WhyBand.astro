---
/** The why, as a single prose column at reading size. */
import TagChip from './TagChip.astro';
---
<section data-section="why" aria-labelledby="why-h" class="border-b border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20">
    <div class="max-w-[52rem]">
      <TagChip label="Why" />
      <h2 id="why-h" class="mt-4 text-3xl sm:text-[40px] lg:text-5xl leading-[1.02] tracking-[-0.02em]">Site knowledge lives in people's heads and in a dozen systems. When a manager leaves or a contract changes hands, the incoming person re-learns the site from scratch.</h2>
      <p class="mt-6 text-[19px] leading-[1.5] max-w-[40rem]">Sitebook is the layer that sits above the systems of record and stays with the landlord.</p>
    </div>
  </div>
</section>
