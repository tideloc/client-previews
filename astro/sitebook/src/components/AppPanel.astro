---
/** Product screen: the live demo in a hairline frame. md and up: the one iframe with the Desktop / Phone control. Below md: the demo's Brindle Park Shopping Centre ground plan (invented centre, OpenStreetMap-derived layout, ODbL credit under it) with seed pins and an outline launch button, no iframe. */
import { APP_URL, APP_SIGN_IN } from '../lib/links';
import PlanGrid from './PlanGrid.astro';
import { BRINDLE_PARK_G } from '../lib/plans';
import DemoFrame from './DemoFrame.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`rounded-lg border border-rule bg-card overflow-hidden ${cls}`} data-app-panel>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 border-b border-rule bg-ground">
    <span class="mono-tag text-xs text-ink-2">{APP_URL.replace(/^https?:\/\//, '')}</span>
    <span class="text-[13px] leading-[18px] text-ink hidden md:block md:grow md:basis-0 min-w-[18rem]">Pick a person to see the demo as they would. Priya runs operations across two centres. Sam is a contractor and sees only his assets. Harriet sees all five sites, including Wattleford Central and Brindle Park.</span>
    <a href={APP_SIGN_IN} target="_blank" rel="noreferrer" class="ml-auto text-[13px] font-medium underline underline-offset-4 whitespace-nowrap">Open the demo</a>
  </div>
  <div class="hidden md:block bg-ground">
    <DemoFrame variant="hero" class="pt-3 px-3 pb-0 [&_[data-frame]]:rounded-t-md [&_[data-frame]]:border [&_[data-frame]]:border-b-0 [&_[data-frame]]:border-rule" />
  </div>
  <div class="md:hidden relative grid-paper p-4">
    <PlanGrid sheet class="w-full" plan={BRINDLE_PARK_G} crop={[180, 80, 1240, 880]}
      caption="Brindle Park Shopping Centre, ground, from the demo. The centre, its shops and its assets are invented."
      pins={[
        { tag: 'MSB-01', chip: true, side: 'left' }, { tag: 'CH-01', chip: true }, { tag: 'HYD-01' },
        { tag: 'HYD-05' }, { tag: 'FCU-04' }, { tag: 'HWU-05' },
      ]} />
    <a href={APP_SIGN_IN} target="_blank" rel="noreferrer" class="btn-outline w-full mt-4">Open the demo</a>
    <p class="mt-3 text-[13px] leading-[18px] text-ink-2">Pick a person to see the demo as they would. Priya runs operations across two centres. Sam is a contractor and sees only his assets. Harriet sees all five sites, including Wattleford Central and Brindle Park. On a phone, open the demo in its own tab; it installs to your home screen.</p>
  </div>
</div>
