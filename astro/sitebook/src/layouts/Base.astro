---
/**
 * Base layout: head meta, JSON-LD (SoftwareApplication), live content kit.
 * Every page passes title + description; exactly one h1 lives in the page.
 * No TidelocBar on this site: Centrebook is Tideloc's own product.
 */
import '../styles/global.css';
import LiveContent from '../components/tl/LiveContent.astro';
import LocalBusinessJsonLd from '../components/tl/LocalBusinessJsonLd.astro';
import Announcement from '../components/tl/Announcement.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../lib/site';
import { getImage } from 'astro:assets';
import defaultOg from '../assets/og-centrebook.png'; // rendered from the brand set, no photograph exists

interface Props {
  title: string;
  description: string;
  ogImage?: string;      // absolute URL, 1200x630
  schemaType?: string;
}
const { title, description, schemaType = 'SoftwareApplication' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${site}${Astro.url.pathname}`;
const fallbackOg = await getImage({ src: defaultOg, width: 1200, height: 630, format: 'jpg' });
const ogImage = Astro.props.ogImage ?? `${site}${fallbackOg.src}`;
const palette = '#16213A,#F6F7F9,#D9DEE7,#F26B1D'; // from brand.json
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F6F7F9" />
    <meta name="tl-palette" content={palette} />
    <link rel="icon" href={`${base}/mark.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteContent.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@87.5,400..700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <LiveContent />
    <LocalBusinessJsonLd type={schemaType} url={`${site}${base}/`} image={ogImage} />
  </head>
  <body class="min-h-screen bg-ground text-ink font-body antialiased text-[15px] leading-[1.45]">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ground focus:px-3 focus:py-2">Skip to content</a>
    <Announcement class="bg-ink text-ground text-sm text-center px-4 py-2" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
