---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PortfolioBand from '../components/PortfolioBand.astro';
import WhyBand from '../components/WhyBand.astro';
import WhatItHolds from '../components/WhatItHolds.astro';
import HandoverSteps from '../components/HandoverSteps.astro';
import WhoItIsFor from '../components/WhoItIsFor.astro';
import PricingObject from '../components/PricingObject.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Centrebook | Site knowledge base for shopping centres and office buildings" description="A site knowledge base for shopping centres and office buildings, held by the centre manager. Assets pinned on the plan, contractors, contacts, runbooks and handover packs.">
  <Hero />
  <PortfolioBand />
  <WhyBand />
  <WhatItHolds />
  <HandoverSteps />
  <WhoItIsFor />
  <PricingObject />
  <CtaBand heading="Every centre's record, ready to hand over" object="plan" />
</Base>
