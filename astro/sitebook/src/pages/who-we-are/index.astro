---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import TagChip from '../../components/TagChip.astro';
import CtaBand from '../../components/CtaBand.astro';
import { APP_SIGN_IN, DEMO_SITES } from '../../lib/links';
---
<Base title="Who we are | Sitebook" description="Sitebook is built by Tideloc, a small web studio in Wollongong NSW, from first-hand experience running shopping centre operations.">
  <PageIntro tag="Who we are" title="Built by Tideloc, Wollongong" lead="A small web studio in Wollongong, NSW." />
  <section data-section="origin" aria-labelledby="or-h" class="border-b border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20">
      <TagChip label="Origin" />
      <h2 id="or-h" class="mt-5 text-[38px] sm:text-[56px] lg:text-[76px] xl:text-[88px] leading-[0.98] tracking-[-0.02em] max-w-[26ch]">The record-keeping existed because a standard required it. The rest of the asset base had no such record.</h2>
      <div class="mt-10 lg:mt-14 grid gap-6 lg:grid-cols-12 lg:gap-10 border-t-2 border-ink pt-8 text-[19px] leading-[1.5]">
        <p class="lg:col-span-5">Sitebook came out of first-hand experience running shopping centre operations and, before that, fire system maintenance reporting, where the record-keeping existed because a standard required it.</p>
        <p class="lg:col-span-4">The rest of the asset base had no such record. Sitebook is that record.</p>
        <p class="lg:col-span-3 lg:justify-self-end lg:text-right text-ink-2 text-[15px] border-t border-rule pt-4 lg:border-t-0 lg:pt-1">Blake Hutchison, founder.<br />Tideloc, Wollongong NSW.</p>
      </div>
    </div>
  </section>
  <section data-section="demo-disclosure" aria-labelledby="dd-h" class="bg-card border-b border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-16">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end">
        <h2 id="dd-h" class="lg:col-span-6 text-3xl sm:text-4xl lg:text-5xl leading-[0.98] tracking-[-0.015em]">Harbourline Property is invented</h2>
        <p class="lg:col-span-6 text-[17px] leading-[1.5]">The app on this site is a working demo with a fictional portfolio, Harbourline Property, and three invented sites: Ridgeway Fair, Marlow Central and Quay Tower. Nothing in it belongs to a real property group.</p>
      </div>
      <dl class="mt-8 grid sm:grid-cols-3 border-l border-t border-rule">
        {DEMO_SITES.map((s) => (
          <div class="border-r border-b border-rule p-5">
            <dt class="display text-2xl">{s.name}</dt>
            <dd class="mono-tag text-xs text-ink-2 mt-1">{s.kind}</dd>
            <dd class="font-mono tabular text-3xl mt-3 leading-none">{s.assets}</dd>
            <dd class="mono-tag text-xs text-ink-2 mt-1">assets pinned</dd>
          </div>
        ))}
      </dl>
      <a href={APP_SIGN_IN} target="_blank" rel="noreferrer" class="btn-outline mt-6">Open the demo</a>
    </div>
  </section>
  <CtaBand heading="Sitebook is that record" body="A short call to see whether Sitebook fits your sites, and what capture would look like for one of them." object="quote" />
</Base>
