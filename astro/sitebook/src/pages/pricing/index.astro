---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import PricingSummary from '../../components/PricingSummary.astro';
import TagChip from '../../components/TagChip.astro';
import CtaBand from '../../components/CtaBand.astro';
const includes = ['Hosting', 'Support', 'Updates', 'Exports', 'Integrations, under fair use'];
const ways = [
  { tag: 'Done for you', title: 'We capture it on site', price: '$18 / asset', note: 'Minimum 150 assets. $12 per asset where a register already exists.', body: 'Every asset pinned on the floor plan with a photo, tag and grid reference. Role interviews, plan digitisation and the review and sign-off workshop are on the rate card.' },
  { tag: 'Self-capture', title: 'You capture it yourselves', price: 'about $2,000 / site', note: 'A self-capture licence with one training day.', body: 'Your own people capture on site with the app after one training day.' },
];
---
<Base title="Pricing | Sitelore" description="Indicative Sitelore pricing, ex GST: capture from $18 per asset, subscription from $150 per site per month, and a three-site pilot at $15,000 fixed.">
  <PageIntro tag="Pricing" title="Indicative pricing, ex GST" lead="Capture once, per asset, then a subscription per site per month by tier. A pilot covers three sites over three months." />
  <PricingSummary />
  <section data-section="subscription-includes" aria-labelledby="si-h" class="bg-card border-b border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="si-h" class="text-3xl sm:text-4xl lg:text-5xl leading-[0.98] tracking-[-0.015em]">What the subscription includes</h2>
        <p class="mt-5 text-ink-2 max-w-[26rem]">Per site per month, by tier. Third-party API fees are paid to that vendor.</p>
      </div>
      <ul class="lg:col-span-7 border-t border-ink">
        {includes.map((it, i) => (
          <li class="flex items-baseline gap-6 py-4 border-b border-rule">
            <span class="mono-tag text-xs text-ink-2 tabular w-8">{String(i + 1).padStart(2, '0')}</span>
            <span class="display text-2xl leading-tight">{it}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section data-section="two-ways-to-capture" aria-labelledby="tw-h" class="border-b border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 py-14 lg:py-20">
      <h2 id="tw-h" class="text-3xl sm:text-4xl lg:text-5xl leading-[0.98] tracking-[-0.015em]">Two ways to capture</h2>
      <div class="mt-8 grid md:grid-cols-2 border-t-2 border-ink">
        {ways.map((w, i) => (
          <div class={`pt-8 pb-8 md:pb-2 ${i > 0 ? 'md:pl-10 md:border-l border-rule border-t md:border-t-0' : 'md:pr-10'}`}>
            <TagChip label={w.tag} />
            <h3 class="mt-5 text-3xl lg:text-4xl leading-[1] tracking-[-0.015em]">{w.title}</h3>
            <p class="mt-5 font-mono tabular text-3xl lg:text-4xl leading-none">{w.price}</p>
            <p class="mt-2 mono-tag text-xs text-ink-2">{w.note}</p>
            <p class="mt-5 text-ink-2 max-w-[30rem]">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand heading="Get a number for one of your sites" body="Capture is priced per asset and the subscription per site, so a figure for one site is quick to put together on a call." object="price" />
</Base>
