---
/** Catering and functions beside the dining room and verandah, with the enquiry form.
 *  Content: Facebook bio, event posts, two photographs. */
import { Picture } from 'astro:assets';
import room from '../assets/dining-room.jpg';
import verandah from '../assets/verandah.jpg';
import EnquiryForm from './EnquiryForm.astro';
import { siteContent } from '../lib/site';
import { telHref } from '../lib/links';
---
<section id="functions" data-section="functions" aria-labelledby="functions-h" class="mx-auto max-w-7xl px-6 py-20 lg:py-28 scroll-mt-4 grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20 lg:items-start">
  <div class="grid gap-4 sm:gap-6">
    <div class="border border-ink/20 p-2"><Picture src={room} widths={[640, 1116]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 50vw, 95vw" loading="lazy" alt="The dining room with timber tables, tiled floor and doors open to the verandah" class="w-full aspect-[4/3] object-cover" /></div>
    <div class="border border-ink/20 p-2 w-2/3 ml-auto"><Picture src={verandah} widths={[640, 1024]} formats={['avif', 'webp']} sizes="(min-width: 1024px) 33vw, 63vw" loading="lazy" alt="Orange chairs and a round table under the cafe verandah, looking out to the trees" class="w-full aspect-[4/3] object-cover" /></div>
  </div>
  <div>
    <h2 id="functions-h" class="font-display font-light text-4xl sm:text-5xl leading-tight">Functions and catering</h2>
    <p class="mt-6 text-lg leading-relaxed text-ink/80">The café is licensed and takes catering and function bookings as well as dine in and takeaway. It has hosted Melbourne Cup luncheons and fundraiser dinners. Call <a href={telHref} class="font-semibold underline underline-offset-4">{siteContent.contact.phone}</a> or use the form.</p>
    <EnquiryForm
      kind="booking"
      site={siteContent.businessName}
      class="grid gap-5 mt-10 sm:grid-cols-2 [&>div:nth-last-child(-n+3)]:sm:col-span-2"
      inputClass="w-full border-0 border-b border-ink/40 bg-transparent px-0 py-2 text-lg focus-visible:outline-none focus-visible:border-primary"
      buttonClass="border border-ink text-ink font-semibold px-7 py-4"
      submitLabel="Ask about a function"
      successText="Thanks, your enquiry has been sent."
      fields={[
        { name: 'name', label: 'Your name', required: true },
        { name: 'phone', label: 'Phone', type: 'tel', required: true },
        { name: 'date', label: 'Date you have in mind' },
        { name: 'guests', label: 'Number of guests' },
        { name: 'email', label: 'Email', type: 'email' },
        { name: 'message', label: 'What are you planning?', type: 'textarea' },
      ]}
    />
  </div>
</section>
