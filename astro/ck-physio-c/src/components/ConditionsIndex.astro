---
/** The conditions index: numbered groups across four columns, every named sub-condition. */
import { conditions, conditionsIntro, noSwim } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { linkToPage?: boolean; heading?: string }
const { linkToPage = true, heading = 'Conditions we treat, by name' } = Astro.props;
---
<section data-section="conditions" class="bg-white">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="lg:col-span-7 font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">{heading}</h2>
      <p class="lg:col-span-5 text-text max-w-md">{conditionsIntro}</p>
    </div>
    <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 border-t-2 border-ink pt-8">
      {conditions.map((g, i) => (
        <li>
          <a href={linkToPage ? `${base}/conditions/#${g.id}` : `#${g.id}`} class="group block">
            <span class="font-display font-extrabold text-accent text-3xl leading-none tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-display font-extrabold text-[1.55rem] leading-[1.05] text-ink group-hover:underline decoration-accent decoration-2">{g.name}</h3>
          </a>
          <ul class="mt-3 space-y-1 text-[15px] leading-snug text-text">
            {g.items.map((it) => <li class="pl-3 border-l-2 border-tint">{it}</li>)}
          </ul>
        </li>
      ))}
    </ol>
    <p class="mt-10 inline-block bg-mint text-ink font-display font-bold text-xl md:text-2xl px-5 py-3 border-l-4 border-accent">{noSwim}.</p>
  </div>
</section>
