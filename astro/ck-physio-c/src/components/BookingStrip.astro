---
/** The Halaxy booking object. Mirrors the three steps of Coryn's Halaxy page (Time, Personal,
 *  Confirm) and links out to it, because Halaxy blocks framing of the public booking page.
 *  Hours come from the kit so the portal can change them. */
import { siteContent, fullAddress } from '../lib/site';
import Hours from './tl/Hours.astro';
import { BOOKING_URL } from '../data/content';
interface Props { tone?: 'navy' | 'white'; class?: string; compact?: boolean }
const { tone = 'navy', class: cls = '', compact = false } = Astro.props;
const onNavy = tone === 'navy';
---
<div data-booking-strip class={`${onNavy ? 'bg-white text-ink' : 'bg-white text-ink border-2 border-ink'} ${cls}`}>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 sm:px-5 py-2.5 sm:py-3 bg-accent text-ink">
    <p class="font-display font-extrabold text-lg">Book online</p>
    <ol class="hidden sm:flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-display font-bold uppercase tracking-[0.08em] sm:tracking-[0.12em]">
      <li class="flex items-center gap-1.5"><span class="w-5 h-5 grid place-items-center bg-ink text-white rounded-full text-[11px]">1</span>Time</li>
      <li aria-hidden="true" class="hidden sm:block w-6 h-px bg-ink/40"></li>
      <li class="flex items-center gap-1.5"><span class="w-5 h-5 grid place-items-center border-2 border-ink rounded-full text-[11px]">2</span>Personal</li>
      <li aria-hidden="true" class="hidden sm:block w-6 h-px bg-ink/40"></li>
      <li class="flex items-center gap-1.5"><span class="w-5 h-5 grid place-items-center border-2 border-ink rounded-full text-[11px]">3</span>Confirm</li>
    </ol>
  </div>
  <div class={`px-4 sm:px-5 py-3 sm:py-4 grid gap-3 sm:gap-4 ${compact ? '' : 'md:grid-cols-12'}`}>
    <dl class={`grid grid-cols-2 gap-x-4 gap-y-2 sm:gap-y-3 text-sm leading-tight ${compact ? '' : 'md:col-span-7'}`}>
      <div class="hidden sm:block"><dt class="text-text/70">Next step</dt><dd class="font-display font-bold text-ink text-base">Pick a time</dd></div>
      <div><dt class="text-text/70">Practitioner</dt><dd class="font-display font-bold text-ink text-base">Mrs Coryn Katz</dd></div>
      <div class="hidden sm:block"><dt class="text-text/70">Location</dt><dd class="font-display font-bold text-ink text-base">CK Physiotherapy</dd></div>
      <div><dt class="text-text/70">Address</dt><dd class="font-medium text-ink" data-tl="contact.address">{fullAddress()}</dd></div>
    </dl>
    <div class={compact ? '' : 'md:col-span-5'}>
      <p class="text-xs uppercase tracking-[0.12em] font-display font-bold text-text/70 mb-1">Clinic hours <span data-today-label class="normal-case tracking-normal font-body font-medium text-accent"></span></p>
      <p data-today-line class="sm:hidden text-sm font-medium text-ink" aria-live="polite"></p>
      <div class="hidden sm:block" data-hours-full>
        <Hours listClass="text-sm" rowClass="flex justify-between gap-4 py-0.5 border-b border-ground last:border-0" dayClass="font-medium" timeClass="tabular-nums" closedClass="text-text/50" holidayClass="text-xs mt-2 text-text/70" />
      </div>
    </div>
    <div class={`${compact ? '' : 'md:col-span-12'} flex flex-wrap items-center gap-3 sm:gap-4`}>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book-navy w-full sm:w-auto min-h-[48px]">Book online</a>
      <p class="text-sm text-text/80">Bookings run on Halaxy, opens in a new tab.</p>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var names = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var today = names[new Date().getDay()];
    document.querySelectorAll('[data-booking-strip]').forEach(function (s) {
      var lab = s.querySelector('[data-today-label]'); if (lab) lab.textContent = '(today is ' + today + ')';
      var line = s.querySelector('[data-today-line]');
      s.querySelectorAll('[data-tl-list="hours"] li').forEach(function (li) {
        var sp = li.querySelectorAll('span'); var d = sp[0];
        if (d && d.textContent.trim() === today) {
          li.classList.add('text-accent'); li.classList.add('font-bold');
          if (line) { var t = sp[1] ? sp[1].textContent.trim() : ''; line.textContent = /closed/i.test(t) || li.dataset.closed ? 'Closed today' : 'Open today, ' + t; }
        }
      });
      if (line && !line.textContent) { var rows = []; s.querySelectorAll('[data-tl-list="hours"] li').forEach(function (li) { var sp = li.querySelectorAll('span'); if (sp[1]) rows.push(sp[0].textContent.trim().slice(0, 3) + ' ' + sp[1].textContent.trim()); }); line.textContent = rows.join(', '); }
    });
  })();
</script>
