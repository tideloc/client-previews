---
/** Two rows: aquatic (photo left, prose right) then land (prose left, photo right). */
import { Picture } from 'astro:assets';
import poolDay from '../assets/pool-day.jpg';
import room from '../assets/treatment-room.jpg';
import { services } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-section="treatments" class="bg-ground">
  <div class="wrap py-10 md:py-20 space-y-10 md:space-y-20">
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5">
        <Picture src={poolDay} formats={['avif', 'webp']} widths={[592]} sizes="(min-width: 768px) 40vw, 100vw" alt="The pool by day, with noodles, floats and resistance equipment along the far edge and dual rails at the steps" class="w-full h-full object-cover aspect-[4/5]" />
      </div>
      <div class="md:col-span-7">
        <p class="font-display font-bold text-accent uppercase tracking-[0.12em] text-sm">In the water</p>
        <h2 class="mt-2 font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">{services.aquatic.title}</h2>
        <p class="mt-5 text-lg leading-relaxed">{services.aquatic.text}</p>
        <p class="mt-3">{services.aquatic.extra} <a href={`${base}/watsu/`} class="underline decoration-accent decoration-2 font-medium text-ink">What is WATSU</a></p>
        <a href={`${base}/treatments/`} class="mt-6 inline-block btn-ghost text-ink">All treatments and the pool</a>
      </div>
    </div>
    <div class="grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-7 md:order-1">
        <p class="font-display font-bold text-accent uppercase tracking-[0.12em] text-sm">In the clinic</p>
        <h2 class="mt-2 font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">{services.land.title}</h2>
        <p class="mt-5 text-lg leading-relaxed">{services.land.text}</p>
        <p class="mt-3">{services.land.extra}</p>
        <div class="mt-6 border-t-2 border-ink pt-4">
          <h3 class="font-display font-bold text-xl text-ink">{services.programs.title}</h3>
          <p class="mt-2">{services.programs.text}</p>
        </div>
      </div>
      <div class="md:col-span-5 md:order-2">
        <Picture src={room} formats={['avif', 'webp']} widths={[640]} sizes="(min-width: 768px) 40vw, 100vw" alt="The treatment room at CK Physiotherapy: a navy treatment bed, desk and shelves, with a window onto the pool" class="w-full h-full object-cover aspect-[4/5]" />
      </div>
    </div>
  </div>
</section>
