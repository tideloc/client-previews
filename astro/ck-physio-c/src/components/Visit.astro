---
/** Visit: hours table, address, parking and payments lines, map, and the message form. */
import { siteContent, fullAddress } from '../lib/site';
import Hours from './tl/Hours.astro';
import ContactDetails from './tl/ContactDetails.astro';
import EnquiryForm from './EnquiryForm.astro';
import { pool } from '../data/content';
const c = siteContent.contact;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress())}&output=embed`;
---
<section data-section="visit" id="visit" class="bg-white">
  <div class="wrap py-10 md:py-20 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">Visit the clinic</h2>
      <ContactDetails class="not-italic mt-6 space-y-1 text-lg text-ink" linkClass="underline decoration-accent decoration-2" />
      <p class="mt-4 text-text">{pool.paragraphs[2]}</p>
      <ul class="mt-4 space-y-1 text-text">
        {pool.payments.map((p) => <li class="pl-3 border-l-2 border-accent">{p}</li>)}
      </ul>
      <h3 class="mt-8 font-display font-bold text-xl text-ink">Clinic hours</h3>
      <Hours listClass="mt-2 border-t-2 border-ink max-w-sm" rowClass="flex justify-between gap-4 py-2 border-b border-ink/15" dayClass="font-medium text-ink" timeClass="tabular-nums" closedClass="text-text/50" holidayClass="text-sm mt-3" />
    </div>
    <div class="lg:col-span-7 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="font-display font-bold text-xl text-ink">Send a message</h3>
        <p class="mt-1 text-sm text-text">For appointment times, book online. For anything else, write to Coryn here.</p>
        <EnquiryForm kind="enquiry" site="CK Physiotherapy & Aquatherapy" submitLabel="Send message" successText="Thanks, your message is on its way to Coryn." class="mt-4 grid gap-3" inputClass="w-full text-base border-2 border-ink/20 bg-white px-3 py-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" buttonClass="btn-book-navy" fields={[
          { name: 'name', label: 'Name', required: true },
          { name: 'email', label: 'Email', type: 'email', required: true },
          { name: 'phone', label: 'Phone', type: 'tel' },
          { name: 'message', label: 'How can we help?', type: 'textarea', required: true },
        ]} />
      </div>
      <div class="min-h-[320px]">
        <iframe title="Map to CK Physiotherapy, 2 Weonga Road, Dover Heights" src={mapSrc} class="w-full h-full min-h-[320px] border-2 border-ink/20" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a href={c.mapUrl} target="_blank" rel="noreferrer" class="mt-3 inline-block underline decoration-accent decoration-2 text-ink font-medium">Directions in Google Maps</a>
      </div>
    </div>
  </div>
</section>
