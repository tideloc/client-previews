---
/** Coryn: headshot beside a dated qualifications timeline. Years and text from the about page. */
import { Picture } from 'astro:assets';
import coryn from '../assets/coryn.jpg';
import { about, approach } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { full?: boolean }
const { full = false } = Astro.props;
const oneOnOne = approach[0];
---
<section data-section="about" class="bg-white">
  <div class="wrap py-14 md:py-20 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Picture src={coryn} formats={['avif', 'webp']} widths={[458]} sizes="(min-width: 1024px) 30vw, 60vw" alt="Coryn Katz, physiotherapist and owner of CK Physiotherapy & Aquatherapy" class="w-full max-w-sm object-cover aspect-[3/4]" />
      <p class="mt-5 font-display font-bold text-2xl leading-tight text-ink">Coryn Katz</p>
      <p class="text-text">Physiotherapist. {about.watsuClaim}.</p>
    </div>
    <div class="lg:col-span-8">
      <h2 class="font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">"{oneOnOne.text.split('.')[0]}."</h2>
      <p class="mt-5 text-lg leading-relaxed max-w-2xl">{oneOnOne.text.split('. ').slice(1).join('. ')}</p>
      <ol class="mt-10 border-l-4 border-accent">
        {about.timeline.map((t) => (
          <li class="relative pl-8 py-3">
            <span class="absolute -left-[10px] top-[1.45rem] w-4 h-4 bg-accent border-4 border-white"></span>
            <span class="font-display font-extrabold text-accent text-2xl leading-none tabular-nums">{t.year}</span>
            <p class="mt-1 text-ink leading-snug">{t.text}</p>
          </li>
        ))}
      </ol>
      {!full && <a href={`${base}/about/`} class="mt-8 inline-block btn-ghost text-ink">Coryn's full story</a>}
    </div>
  </div>
</section>
