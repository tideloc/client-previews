---
/** Navy band: the pool in numbers (facility page facts only) with the facility paragraph. */
import { Picture } from 'astro:assets';
import water from '../assets/pool-water.jpg';
import { pool } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { full?: boolean }
const { full = false } = Astro.props;
---
<section data-section="pool" class="bg-ink text-white">
  <div class="wrap py-14 md:py-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <h2 class="lg:col-span-7 font-display font-extrabold text-4xl md:text-5xl leading-none text-white">The pool, in numbers</h2>
      <p class="lg:col-span-5 text-white/80">Our own indoor therapy pool at 2 Weonga Road, with the physiotherapist in the water with you.</p>
    </div>
    <dl class="mt-10 grid grid-cols-2 lg:grid-cols-4 border-t border-white/20">
      {pool.specs.map((s) => (
        <div class="py-6 pr-6 border-b border-white/20 lg:border-b-0 lg:border-r lg:last:border-r-0 lg:px-6 lg:first:pl-0">
          <dt class="font-display font-extrabold text-accent text-[1.9rem] sm:text-4xl md:text-[2.75rem] leading-none tabular-nums whitespace-nowrap">{s.value}</dt>
          <dd class="mt-2 text-white/80 text-sm">{s.label}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <Picture src={water} formats={['avif', 'webp']} widths={[700, 1200]} sizes="(min-width: 1024px) 58vw, 100vw" alt="The water of the therapy pool at night, lit from below, with the entry rails at the left" class="w-full object-cover aspect-[16/10]" />
      </div>
      <div class="lg:col-span-5 space-y-4 text-white/85 leading-relaxed">
        {(full ? pool.paragraphs : pool.paragraphs.slice(0, 2)).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
