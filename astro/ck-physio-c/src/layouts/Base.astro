---
/**
 * Base layout for CK Physiotherapy & Aquatherapy, Option C "Clinic index".
 * Head meta, JSON-LD, live content kit, Tideloc bar. Values come from brand-c.json.
 */
import '../styles/global.css';
import LiveContent from '../components/tl/LiveContent.astro';
import LocalBusinessJsonLd from '../components/tl/LocalBusinessJsonLd.astro';
import Announcement from '../components/tl/Announcement.astro';
import TidelocBar from '../components/TidelocBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteContent } from '../lib/site';
import { getImage } from 'astro:assets';
import defaultOg from '../assets/pool-night.jpg';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `${site}${Astro.url.pathname}`;
const fallbackOg = await getImage({ src: defaultOg, width: 1200, height: 630, format: 'jpg' });
const ogImage = Astro.props.ogImage ?? `${site}${fallbackOg.src}`;
const palette = '#102048,#08A8D8,#EDF2F7,#4A5568,#BEE3F8';
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#102048" />
    <meta name="tl-palette" content={palette} />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteContent.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <LiveContent />
    <LocalBusinessJsonLd type="Physiotherapy" url={`${site}${base}/`} image={ogImage} />
  </head>
  <body class="min-h-screen bg-ground text-text font-body antialiased pb-12">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <Announcement class="bg-accent text-ink text-sm text-center px-4 py-2 font-medium" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <TidelocBar reasons={[
      'Every Book button opens your Halaxy booking page, and a booking panel sits on the home and contact pages: the current site only has a text link at the bottom',
      'Every condition you treat is listed by name on the home page and on its own page, so people searching "aquatic physio disc bulge Eastern Suburbs" find you',
      'Pool facts (34°C, 1.1 to 1.3 m, salt water, dual rails, parking) are set as a spec sheet instead of buried in a paragraph',
      'Hours, phone, address and the booking link are yours to update from a simple portal, live in minutes',
      'Unique title and description on every page plus a proper H1, which the current Wix site is missing',
    ]} />
    <script is:inline defer src={`${base}/tl-live.js`}></script>
  </body>
</html>
