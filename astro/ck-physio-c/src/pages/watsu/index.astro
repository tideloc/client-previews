---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import BookingStrip from '../../components/BookingStrip.astro';
import water from '../../assets/pool-water-tall.jpg';
import { watsu, about } from '../../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="WATSU aquatic bodywork, Dover Heights | CK Physio" description="WATSU (WATer ShiatsU) in 34°C water with Coryn Katz, the only WATSU certified physiotherapist in Sydney. Benefits, who it suits, book online.">
  <section class="bg-ink text-white">
    <div class="wrap py-9 md:py-16 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="font-display font-bold text-accent uppercase tracking-[0.12em] text-sm">WATer ShiatsU</p>
        <h1 class="mt-2 font-display font-extrabold text-[2.6rem] md:text-6xl leading-[1.0] text-white">WATSU</h1>
        <p class="mt-4 font-display font-bold text-xl text-accent">{about.watsuClaim}.</p>
        <p class="mt-3 text-white/80"><a href={`${base}/treatments/`} class="underline decoration-accent decoration-2">All treatments</a></p>
      </div>
      <p class="lg:col-span-5 text-lg leading-relaxed text-white/85">{watsu.intro[0]}</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap py-9 md:py-16 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7 space-y-4 text-lg leading-relaxed">
        <h2 class="font-display font-extrabold text-4xl leading-none text-ink">What happens in a session</h2>
        {watsu.intro.slice(1).map((p) => <p>{p}</p>)}
        <p class="text-base">{watsu.science}</p>
      </div>
      <div class="lg:col-span-5">
        <Picture src={water} formats={['avif', 'webp']} widths={[640]} sizes="(min-width: 1024px) 40vw, 100vw" alt="The warm water of the therapy pool at night, lit from below" class="w-full object-cover aspect-[4/5]" />
      </div>
    </div>
  </section>

  <section class="bg-ground">
    <div class="wrap py-9 md:py-16">
      <h2 class="font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">Benefits of WATSU</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2 border-t-2 border-ink pt-8">
        <div>
          <h3 class="font-display font-extrabold text-accent text-2xl">Immediate</h3>
          <ul class="mt-3 space-y-1 text-lg">{watsu.immediate.map((b) => <li class="pl-3 border-l-2 border-tint">{b}</li>)}</ul>
        </div>
        <div>
          <h3 class="font-display font-extrabold text-accent text-2xl">Long-term</h3>
          <ul class="mt-3 space-y-1 text-lg">{watsu.longTerm.map((b) => <li class="pl-3 border-l-2 border-tint">{b}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap py-9 md:py-16 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="font-display font-extrabold text-4xl leading-none text-ink">Who can benefit from WATSU?</h2>
        <ol class="mt-6 border-t-2 border-ink">
          {watsu.who.map((w, i) => (
            <li class="flex gap-4 py-3 border-b border-ink/15"><span class="font-display font-extrabold text-accent tabular-nums w-8 shrink-0">{String(i + 1).padStart(2, '0')}</span><span>{w}</span></li>
          ))}
        </ol>
        <p class="mt-4 text-sm text-text/80">{watsu.credit}</p>
      </div>
      <div class="lg:col-span-5">
        <BookingStrip tone="white" compact />
        
      </div>
    </div>
  </section>
</Base>
