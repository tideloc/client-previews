---
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';
import { google, BOOKING_URL } from '../../data/content';
---
<Base title="Client testimonials, Dover Heights physio | CK Physio" description="Client testimonials for CK Physiotherapy & Aquatherapy, Dover Heights: spinal fusion, rotator cuff, disc bulge, tendinopathy and more. Rated 5.0 on Google.">
  <section class="bg-white">
    <div class="wrap pt-12 md:pt-16 pb-8 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <h1 class="font-display font-extrabold text-[2.6rem] md:text-6xl leading-[1.0] text-ink">Client testimonials</h1>
        <p class="mt-4 text-lg">Real experiences from our patients in and out of the water. We are honoured to be part of your healing journey.</p>
      </div>
      <p class="lg:col-span-4 font-display font-bold text-ink text-xl"><span class="text-accent text-4xl">{google.rating}</span> on Google from {google.count} reviews</p>
    </div>
  </section>
  <Ledger heading="" showRating={false} />
  <section class="bg-white">
    <div class="wrap py-12 md:py-16 grid gap-10 lg:grid-cols-12 lg:items-center">
      <h2 class="lg:col-span-6 font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">Ready to start your recovery?</h2>
      <div class="lg:col-span-6"><a href={BOOKING_URL} target="_blank" rel="noopener" class="btn-book-navy">Book online</a><p class="mt-3 text-sm text-text">Bookings run on Halaxy, opens in a new tab.</p></div>
    </div>
  </section>
</Base>
