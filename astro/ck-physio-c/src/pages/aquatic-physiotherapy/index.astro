---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import BookingStrip from '../../components/BookingStrip.astro';
import poolDay from '../../assets/pool-day.jpg';
import poolNight from '../../assets/pool-night.jpg';
import { services, pool, noSwim, about } from '../../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const facts = [
  ['Water', '33 to 34°C year round, with a heater at the pool in winter'],
  ['Depth', '1.1 to 1.3 m, therapeutic depth'],
  ['Pool', 'Indoor salt water therapy pool'],
  ['Safety', 'Dual railing to enter, railing around the perimeter and through the practice'],
  ['Change room', 'Inside the pool area, toilet in the clinic within metres'],
  ['Parking', 'Directly outside the clinic, always available'],
  ['Equipment', 'From America, South Africa, UK, Israel and Australia'],
];
---
<Base title="Aquatic physiotherapy in Dover Heights | CK Physio" description="Aquatic physiotherapy in a private indoor salt water pool at 33-34°C, 1.1 to 1.3 m deep, with the physiotherapist in the water with you. Dover Heights.">
  <section class="bg-white">
    <div class="wrap py-12 md:py-16 grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="font-display font-bold text-accent uppercase tracking-[0.12em] text-sm">In the water</p>
        <h1 class="mt-2 font-display font-extrabold text-[2.6rem] md:text-6xl leading-[1.0] text-ink">Aquatic physiotherapy, one on one, in our own pool</h1>
      </div>
      <p class="lg:col-span-5 text-lg leading-relaxed">{services.aquatic.text}</p>
    </div>
  </section>

  <section class="bg-ground">
    <div class="wrap py-12 md:py-16 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5">
        <Picture src={poolDay} formats={['avif', 'webp']} widths={[592]} sizes="(min-width: 768px) 40vw, 100vw" alt="The pool by day with noodles, floats and resistance equipment along the far edge" class="w-full object-cover aspect-square" />
      </div>
      <div class="md:col-span-7">
        <h2 class="font-display font-extrabold text-4xl leading-none text-ink">Equipment from five countries</h2>
        <p class="mt-4 text-lg leading-relaxed">{pool.paragraphs[3]}</p>
        <p class="mt-3">{about.specialties[0].text}</p>
        <p class="mt-6 inline-block bg-mint text-ink font-display font-bold text-xl px-5 py-3 border-l-4 border-accent">{noSwim}.</p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="wrap py-12 md:py-16">
      <h2 class="font-display font-extrabold text-4xl md:text-5xl leading-none text-ink">About the pool</h2>
      <div class="mt-8 grid gap-10 lg:grid-cols-12">
        <dl class="lg:col-span-5 border-t-2 border-ink">
          {facts.map(([k, v]) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3 border-b border-ink/15">
              <dt class="font-display font-extrabold text-accent">{k}</dt>
              <dd class="text-ink">{v}</dd>
            </div>
          ))}
        </dl>
        <div class="lg:col-span-7">
          <Picture src={poolNight} formats={['avif', 'webp']} widths={[800, 1600]} sizes="(min-width: 1024px) 58vw, 100vw" alt="The pool at night, lit from below, with white fencing and glass doors on every side and a louvred ceiling" class="w-full object-cover aspect-[16/10]" />
          <div class="mt-5 space-y-3 leading-relaxed">
            <p>{pool.paragraphs[0]}</p>
            <p>{pool.paragraphs[1]}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="wrap py-12 md:py-16 grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-6">
        <h2 class="font-display font-extrabold text-4xl leading-none text-white">{pool.buoyancy.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/85">{pool.buoyancy.text}</p>
        <p class="mt-3 text-white/85">{services.aquatic.extra} <a href={`${base}/watsu/`} class="underline decoration-accent decoration-2 font-medium text-white">Read about WATSU</a></p>
        <h2 class="mt-10 font-display font-extrabold text-3xl leading-none text-white">Ready to start moving?</h2>
        <p class="mt-3 text-white/85">Join us for one-on-one care tailored to your specific recovery goals. Experience the unique healing benefits of aquatic therapy in our state-of-the-art Sydney facility conveniently located in the Eastern Suburbs.</p>
      </div>
      <div class="lg:col-span-6"><BookingStrip tone="navy" /></div>
    </div>
  </section>
</Base>
